ases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 644294, "username": "xxxaadsdss", "url": "https://www.v2ex.com/u/xxxaadsdss", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/aeb9/c367/644294_mini.png?m=1780636393", "avatar_normal": "https://cdn.v2ex.com/avatar/aeb9/c367/644294_normal.png?m=1780636393", "avatar_large": "https://cdn.v2ex.com/avatar/aeb9/c367/644294_large.png?m=1780636393", "avatar_xlarge": "https://cdn.v2ex.com/avatar/aeb9/c367/644294_xlarge.png?m=1780636393", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/aeb9/c367/644294_xxlarge.png?m=1780636393", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/aeb9/c367/644294_xxxlarge.png?m=1780636393", "created": 1692348712, "last_modified": 1780636393, "pro": 0}, "last_reply_by": "xxxaadsdss", "last_touched": 1788191220, "title": "2 万多下载，大多数人却只用了一次", "url": "https://www.v2ex.com/t/1238358", "created": 1788149789, "deleted": 0, "content": "2 万多下载，\r\n大多数人却只用了一次\r\n被裁后做 App 的第一个增长教训\r\n上午还在写代码，下午岗位没了\r\nLeader 发来一段 5 分钟语音。\r\n随后和 HR 聊了 20 分钟。\r\n签字、交工牌，工作结束了。\r\n那天之后，我开始认真做自己的产品。\r\n我把时间押在了一个翻译 App 上，秒译\r\n我想做一个能持续显示字幕、\r\n提前下载语言包后断网也能使用的工具。\r\n我当时以为：功能做好，用户自然会留下。\r\n一条视频，约 47.2 万播放\r\n发布前一天：27 次首次下载\r\n发布当天：615 次首次下载\r\n那天我以为，增长终于来了。\r\n第二天，只剩 149 次\r\n热度过去以后，\r\n每天下载又逐渐回到了二十几次。\r\n爆款带来了下载，却没有带来稳定增长。\r\n更难的问题：用户没有留下来\r\n安装后第 1 天回来的人：约 14.7%\r\n安装后第 7 天回来的人：约 1.91%\r\n也就是说，很多人只是觉得新奇，打开一次就走了。", "content_rendered": "2 万多下载，<br />大多数人却只用了一次<br />被裁后做 App 的第一个增长教训<br />上午还在写代码，下午岗位没了<br />Leader 发来一段 5 分钟语音。<br />随后和 HR 聊了 20 分钟。<br />签字、交工牌，工作结束了。<br />那天之后，我开始认真做自己的产品。<br />我把时间押在了一个翻译 App 上，秒译<br />我想做一个能持续显示字幕、<br />提前下载语言包后断网也能使用的工具。<br />我当时以为：功能做好，用户自然会留下。<br />一条视频，约 47.2 万播放<br />发布前一天：27 次首次下载<br />发布当天：615 次首次下载<br />那天我以为，增长终于来了。<br />第二天，只剩 149 次<br />热度过去以后，<br />每天下载又逐渐回到了二十几次。<br />爆款带来了下载，却没有带来稳定增长。<br />更难的问题：用户没有留下来<br />安装后第 1 天回来的人：约 14.7%<br />安装后第 7 天回来的人：约 1.91%<br />也就是说，很多人只是觉得新奇，打开一次就走了。", "last_modified": 1788149789, "replies": 65, "id": 1238358}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24212, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3733, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 533933, "username": "litianyunq", "url": "https://www.v2ex.com/u/litianyunq", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/9e51/5f8c/533933_mini.png?m=1788140919", "avatar_normal": "https://cdn.v2ex.com/avatar/9e51/5f8c/533933_normal.png?m=1788140919", "avatar_large": "https://cdn.v2ex.com/avatar/9e51/5f8c/533933_large.png?m=1788140919", "created": 1613807895, "last_modified": 1788140919, "pro": 0}, "last_reply_by": "Bapper", "last_touched": 1788174333, "title": "面试录个音不犯规吧？大家帮忙投个票", "url": "https://www.v2ex.com/t/1238291", "created": 1788141418, "deleted": 0, "content": "最近大礼包的同学比较多，诗和远方在房贷面前都变成了求职面试，想做个 AI 面试工具，先调研下。\r\n\r\n想法：面试录音/或单独上传面试信息->ai 面试记录整理分析报告->提取每次的要点成卡片方便快速复习。\r\n\r\n目标：贩卖 ai 的整理归纳能力，做面试相关的业务。\r\n\r\n想听真话：\r\n1. 想问问大家会使用么？\r\n2. 要是使用的话大家还想要哪些功能？\r\n\r\n喷就喷，别客气。", "content_rendered": "最近大礼包的同学比较多，诗和远方在房贷面前都变成了求职面试，想做个 AI 面试工具，先调研下。<br /><br />想法：面试录音/或单独上传面试信息-&gt;ai 面试记录整理分析报告-&gt;提取每次的要点成卡片方便快速复习。<br /><br />目标：贩卖 ai 的整理归纳能力，做面试相关的业务。<br /><br />想听真话：<br />1. 想问问大家会使用么？<br />2. 要是使用的话大家还想要哪些功能？<br /><br />喷就喷，别客气。", "last_modified": 1788150003, "replies": 48, "id": 1238291}]