[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "avatar_normal": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_normal.png?m=1751736790", "title": "Claude", "url": "https://www.v2ex.com/go/claude", "topics": 999, "footer": "", "header": "", "title_alternative": "Claude", "avatar_mini": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_mini.png?m=1751736790", "stars": 748, "founder_id": 0, "aliases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 620210, "username": "xxzhaoming", "url": "https://www.v2ex.com/u/xxzhaoming", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/02bc/55c3/620210_mini.png?m=1791604843", "avatar_normal": "https://cdn.v2ex.com/avatar/02bc/55c3/620210_normal.png?m=1791604843", "avatar_large": "https://cdn.v2ex.com/avatar/02bc/55c3/620210_large.png?m=1791604843", "avatar_xlarge": "https://cdn.v2ex.com/avatar/02bc/55c3/620210_xlarge.png?m=1791604843", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/02bc/55c3/620210_xxlarge.png?m=1791604843", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/02bc/55c3/620210_xxxlarge.png?m=1791604843", "created": 1679456459, "last_modified": 1791604843, "pro": 0}, "last_reply_by": "xxzhaoming", "last_touched": 1791660836, "title": "发工资了今晚干一票大的，我准备直接用招行卡开 5 倍 max", "url": "https://www.v2ex.com/t/1247676", "created": 1791623203, "deleted": 0, "content": "我看 claude 官网能选 china 地址了，我准备直接选我的居住地天津的地址，然后我看来一下 max 的费用是 3,047.62 台币 折合人人民币也就是不到 650 而且换算成美元也是 95 美金，如果能开出来那岂不是血赚了。\r\n\r\n刚才在工位试了一下，触发活体验证了，我扫描了我的身份证，好像不行，说要 passport ，我一下下班就回去那护照去，tmd 等我好消息", "content_rendered": "<p>我看 claude 官网能选 china 地址了，我准备直接选我的居住地天津的地址，然后我看来一下 max 的费用是 3,047.62 台币 折合人人民币也就是不到 650 而且换算成美元也是 95 美金，如果能开出来那岂不是血赚了。</p>\n<p>刚才在工位试了一下，触发活体验证了，我扫描了我的身份证，好像不行，说要 passport ，我一下下班就回去那护照去，tmd 等我好消息</p>\n", "last_modified": 1791623203, "replies": 132, "id": 124