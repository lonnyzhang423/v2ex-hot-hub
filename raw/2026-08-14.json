[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11480, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2432, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 59091, "username": "v2er4241", "url": "https://www.v2ex.com/u/v2er4241", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/13d9/41b7/59091_mini.png?m=1759105570", "avatar_normal": "https://cdn.v2ex.com/avatar/13d9/41b7/59091_normal.png?m=1759105570", "avatar_large": "https://cdn.v2ex.com/avatar/13d9/41b7/59091_large.png?m=1759105570", "created": 1395889389, "last_modified": 1759105570, "pro": 0}, "last_reply_by": "Orange2269", "last_touched": 1786711245, "title": "想起一件招笑的小事", "url": "https://www.v2ex.com/t/1234269", "created": 1786672479, "deleted": 0, "content": "刚毕业那会儿，街上还流行着发传单。\r\n\r\n我、我女朋友（现在已经是老婆了）、我女朋友闺蜜，三个人，忘了是什么缘由就开始讨论接传单的事。\r\n\r\n我说，路上发传单的我从来都不接。\r\n\r\n女朋友闺蜜说，你咋这么没有同情心呢？人家发传单也很辛苦，顺手一带的事。\r\n\r\n我说，她发传单是她的事情，那是她的工作，跟我也没有关系。我拿了传单还要找地方去扔掉，也浪费纸的好吧？\r\n\r\n她说，你不拿传单，她也是要发完，别人拿了大多数也会扔掉，你拿了就可以让她早点下班，真是何不食肉糜。\r\n\r\n我女朋友没有发表意见。\r\n\r\n我觉得我也没必要再继续争论了，三观不合。从此，我就觉得这个人很圣母，远离了。\r\n\r\n对于这件事的看法，我也想听听大家的观点。", "content_rendered": "刚毕业那会儿，街上还流行着发传单。<br /><br />我、我女朋友（现在已经是老婆了）、我女朋友闺蜜，三个人，忘了是什么缘由就开始讨论接传单的事。<br /><br />我说，路上发传单的我从来都不接。<br /><br />女朋友闺蜜说，你咋这么没有同情心呢？人家发传单也很辛苦，顺手一带的事。<br /><br />我说，她发传单是她的事情，那是她的工作，跟我也没有关系。我拿了传单还要找地方去扔掉，也浪费纸的好吧？<br /><br />她说，你不拿传单，她也是要发完，别人拿了大多数也会扔掉，你拿了就可以让她早点下班，真是何不食肉糜。<br /><br />我女朋友没有发表意见。<br /><br />我觉得我也没必要再继续争论了，三观不合。从此，我就觉得这个人很圣母，远离了。<br /><br />对于这件事的看法，我也想听听大家的观点。", "last_modified": 1786672479, "replies": 143, "id": 1234269}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c8ed/21db/722_large.png?m=1751736797", "name": "localllm", "avatar_normal": "https://cdn.v2ex.com/navatar/c8ed/21db/722_normal.png?m=1751736797", "title": "Local LLM", "url": "https://www.v2ex.com/go/localllm", "topics": 347, "footer": "", "header": "这个节点讨论在本地电脑或者局域网里运行 LLM（大语言模型）的技术细节", "title_alternative": "Local LLM", "avatar_mini": "https://cdn.v2ex.com/navatar/c8ed/21db/722_mini.png?m=1751736797", "stars": 390, "founder_id": 0, "aliases": [], "root": false, "id": 722, "parent_node_name": "geek"}, "member": {"id": 755848, "username": "dirkchou", "url": "https://www.v2ex.com/u/dirkchou", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "深圳", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5783/2c0b/755848_mini.png?m=1786710219", "avatar_normal": "https://cdn.v2ex.com/avatar/5783/2c0b/755848_normal.png?m=1786710219", "avatar_large": "https://cdn.v2ex.com/avatar/5783/2c0b/755848_large.png?m=1786710219", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5783/2c0b/755848_xlarge.png?m=1786710219", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5783/2c0b/755848_xxlarge.png?m=1786710219", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/5783/2c0b/755848_xxxlarge.png?m=1786710219", "created": 1751635114, "last_modified": 1786710219, "pro": 0}, "last_reply_by": "74", "last_touched": 1786440556, "title": "local.ai，我来开个帖子接力吧", "url": "https://www.v2ex.com/t/1234283", "created": 1786674860, "deleted": 0, "content": "只需要五个人接力即可\r\n\r\nhttps://local.ai/dirkchou/invite\r\n\r\n求求大家了，站长的邀请链接已经很多人点了", "content_rendered": "<p>只需要五个人接力即可</p>\n<p><a href=\"https://local.ai/dirkchou/invite\" rel=\"nofollow\">https://local.ai/dirkchou/invite</a></p>\n<p>求求大家了，站长的邀请链接已经很多人点了</p>\n", "last_modified": 1786674860, "replies": 132, "id": 1234283}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11480, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2432, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 415795, "username": "Leeeeex", "url": "https://www.v2ex.com/u/Leeeeex", "website": "leeex.sol.build", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "邮箱：v2ex@moe.mg", "avatar_mini": "https://cdn.v2ex.com/avatar/b0c6/6f54/415795_mini.png?m=1782213343", "avatar_normal": "https://cdn.v2ex.com/avatar/b0c6/6f54/415795_normal.png?m=1782213343", "avatar_large": "https://cdn.v2ex.com/avatar/b0c6/6f54/415795_large.png?m=1782213343", "avatar_xlarge": "https://cdn.v2ex.com/avatar/b0c6/6f54/415795_xlarge.png?m=1782213343", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/b0c6/6f54/415795_xxlarge.png?m=1782213343", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/b0c6/6f54/415795_xxxlarge.png?m=1782213343", "created": 1558872774, "last_modified": 1782213343, "pro": 0}, "last_reply_by": "Aaron01", "last_touched": 1786715094, "title": "脑供血不足晕倒", "url": "https://www.v2ex.com/t/1234248", "created": 1786666745, "deleted": 0, "content": "昨晚上本来在躺着，然后想上厕所，就起身去厕所，站着上厕所的时候感觉眼前一黑，再睁眼的时候就是躺在浴室地上，脑子完全空白，我是谁 我在哪 我在干什么\n\n然后整个人都是傻的，只听到手机响也找不到手机，刚才在干什么也完全不记得了。然后手机就出现在了我最不想见到的地方——马桶里。\n\n人是傻的也没想那么多，直接把手机捞出来放在水龙头下面猛猛冲。然后身上全湿了，和个傻子一样就回去又坐着了。感觉下巴有点疼，应该是倒下的时候磕到了水龙头，后脑勺有点疼，可能是磕到墙壁了。坐着观察了一下发现头也没有继续痛，慢慢缓解了，就休息了。\n\n我朋友不放心，让我预约个脑部 CT 看看，一会请假去医院。\n\n果然人老了干什么都很心酸。", "content_rendered": "<p>昨晚上本来在躺着，然后想上厕所，就起身去厕所，站着上厕所的时候感觉眼前一黑，再睁眼的时候就是躺在浴室地上，脑子完全空白，我是谁 我在哪 我在干什么</p>\n<p>然后整个人都是傻的，只听到手机响也找不到手机，刚才在干什么也完全不记得了。然后手机就出现在了我最不想见到的地方——马桶里。</p>\n<p>人是傻的也没想那么多，直接把手机捞出来放在水龙头下面猛猛冲。然后身上全湿了，和个傻子一样就回去又坐着了。感觉下巴有点疼，应该是倒下的时候磕到了水龙头，后脑勺有点疼，可能是磕到墙壁了。坐着观察了一下发现头也没有继续痛，慢慢缓解了，就休息了。</p>\n<p>我朋友不放心，让我预约个脑部 CT 看看，一会请假去医院。</p>\n<p>果然人老了干什么都很心酸。</p>\n", "last_modified": 1786666745, "replies": 95, "id": 1234248}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/093f/65e0/59_large.png?m=1747623725", "name": "random", "avatar_normal": "https://cdn.v2ex.com/navatar/093f/65e0/59_normal.png?m=1747623725", "title": "随想", "url": "https://www.v2ex.com/go/random", "topics": 4355, "footer": "", "header": "有的时候，可以停下来找找灵感，然后再继续。", "title_alternative": "Random", "avatar_mini": "https://cdn.v2ex.com/navatar/093f/65e0/59_mini.png?m=1747623725", "stars": 1315, "founder_id": 0, "aliases": [], "root": false, "id": 59, "parent_node_name": "v2ex"}, "member": {"id": 274090, "username": "Danswerme", "url": "https://www.v2ex.com/u/Danswerme", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/7460/e1cd/274090_mini.png?m=1765551963", "avatar_normal": "https://cdn.v2ex.com/avatar/7460/e1cd/274090_normal.png?m=1765551963", "avatar_large": "https://cdn.v2ex.com/avatar/7460/e1cd/274090_large.png?m=1765551963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/7460/e1cd/274090_xlarge.png?m=1765551963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/7460/e1cd/274090_xxlarge.png?m=1765551963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/7460/e1cd/274090_xxxlarge.png?m=1765551963", "created": 1513081062, "last_modified": 1765551963, "pro": 0}, "last_reply_by": "akring", "last_touched": 1786709308, "title": "第一次在本站拉黑人", "url": "https://www.v2ex.com/t/1234332", "created": 1786680706, "deleted": 0, "content": "在互联网上交流时我一直秉持着这样的观点：如果某人的某条言论让我很反感或者不赞同，那也只是在这件事情上。 在别的事情上 Ta 可能会给我带来不一样的观点和思考，因此我不会因为观点相左便拉黑别人。\r\n\r\n然而最近我注意到了两名用户，第一位肆意使用 AI 产出各种垃圾来污染回复，每次看到后都会让我皱起双眉； 另一位则是无论在什么帖子下都要唱反调和阴阳怪气嘲讽，甚至在两个帖子中出现了观点左右互搏的现象，让我第一次觉得拉黑人是如此必要。", "content_rendered": "<p>在互联网上交流时我一直秉持着这样的观点：如果某人的某条言论让我很反感或者不赞同，那也只是在这件事情上。 在别的事情上 Ta 可能会给我带来不一样的观点和思考，因此我不会因为观点相左便拉黑别人。</p>\n<p>然而最近我注意到了两名用户，第一位肆意使用 AI 产出各种垃圾来污染回复，每次看到后都会让我皱起双眉； 另一位则是无论在什么帖子下都要唱反调和阴阳怪气嘲讽，甚至在两个帖子中出现了观点左右互搏的现象，让我第一次觉得拉黑人是如此必要。</p>\n", "last_modified": 1786680706, "replies": 79, "id": 1234332}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240767, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4506, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 287238, "username": "FaustinaD", "url": "https://www.v2ex.com/u/FaustinaD", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9f13/d763/287238_mini.png?m=1775805794", "avatar_normal": "https://cdn.v2ex.com/avatar/9f13/d763/287238_normal.png?m=1775805794", "avatar_large": "https://cdn.v2ex.com/avatar/9f13/d763/287238_large.png?m=1775805794", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xlarge.png?m=1775805794", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xxlarge.png?m=1775805794", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xxxlarge.png?m=1775805794", "created": 1517081618, "last_modified": 1775805794, "pro": 0}, "last_reply_by": "akring", "last_touched": 1786709284, "title": "撸铁并佩戴金戒指的佬们，如何解决戒指被各种哑铃杠铃刮花&搞变形的问题的？", "url": "https://www.v2ex.com/t/1234281", "created": 1786674526, "deleted": 0, "content": "手上一直戴的是一枚银戒指，情侣对戒，毕业第一份工资买的\r\n婚礼交换的也是这枚戒指，俩人戴了十八年了\r\n人到 40 突然想戴金戒指了\r\n\r\n最近这些年攒了一些黄金\r\n七夕我先生问我要啥礼物\r\n我想来想去，最后决定让他出个工费打个金戒指\r\n\r\n但我经常撸铁，银戒指是光面的看不出磨损\r\n两三百块钱的东西刮花了也不是很心疼\r\n金戒指一方面材质比较软，另一方面也不耐刮\r\n所以很想知道平时佩戴金戒指并且经常撸铁的佬们怎么解决这个问题的\r\n\r\n去小红书搜了一圈，全是戒指被哑铃拉丝刮得面目全非的情况\r\n根本没找到一个好的解决方案\r\n练的时候取下来对我这个健忘症来说又几乎等于丢弃\r\n是不是无解了？", "content_rendered": "手上一直戴的是一枚银戒指，情侣对戒，毕业第一份工资买的<br />婚礼交换的也是这枚戒指，俩人戴了十八年了<br />人到 40 突然想戴金戒指了<br /><br />最近这些年攒了一些黄金<br />七夕我先生问我要啥礼物<br />我想来想去，最后决定让他出个工费打个金戒指<br /><br />但我经常撸铁，银戒指是光面的看不出磨损<br />两三百块钱的东西刮花了也不是很心疼<br />金戒指一方面材质比较软，另一方面也不耐刮<br />所以很想知道平时佩戴金戒指并且经常撸铁的佬们怎么解决这个问题的<br /><br />去小红书搜了一圈，全是戒指被哑铃拉丝刮得面目全非的情况<br />根本没找到一个好的解决方案<br />练的时候取下来对我这个健忘症来说又几乎等于丢弃<br />是不是无解了？", "last_modified": 1786674526, "replies": 78, "id": 1234281}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c8ed/21db/722_large.png?m=1751736797", "name": "localllm", "avatar_normal": "https://cdn.v2ex.com/navatar/c8ed/21db/722_normal.png?m=1751736797", "title": "Local LLM", "url": "https://www.v2ex.com/go/localllm", "topics": 347, "footer": "", "header": "这个节点讨论在本地电脑或者局域网里运行 LLM（大语言模型）的技术细节", "title_alternative": "Local LLM", "avatar_mini": "https://cdn.v2ex.com/navatar/c8ed/21db/722_mini.png?m=1751736797", "stars": 390, "founder_id": 0, "aliases": [], "root": false, "id": 722, "parent_node_name": "geek"}, "member": {"id": 590368, "username": "majuzhang", "url": "https://www.v2ex.com/u/majuzhang", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/0ba17787512fc66d329ca84e468b879f?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/0ba17787512fc66d329ca84e468b879f?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/0ba17787512fc66d329ca84e468b879f?s=73&d=retro", "created": 1659602257, "last_modified": 1659602257, "pro": 0}, "last_reply_by": "shelken", "last_touched": 1786712083, "title": "公司本地部署开源模型", "url": "https://www.v2ex.com/t/1234254", "created": 1786669514, "deleted": 0, "content": "想知道公司里部署一个可以供 20-40 人用的开源模型，需要大概怎样的硬件配置，一般会做文档处理，以及一些简单的编程", "content_rendered": "<p>想知道公司里部署一个可以供 20-40 人用的开源模型，需要大概怎样的硬件配置，一般会做文档处理，以及一些简单的编程</p>\n", "last_modified": 1786677250, "replies": 49, "id": 1234254}]