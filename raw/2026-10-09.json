[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242112, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4527, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_large": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_large.png?m=1691393963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xlarge.png?m=1691393963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxlarge.png?m=1691393963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxxlarge.png?m=1691393963", "created": 1663333667, "last_modified": 1691393963, "pro": 0}, "last_reply_by": "lazinesssheep", "last_touched": 1791528198, "title": "第一次相亲，请教下各位怎么聊，应该聊些什么。", "url": "https://www.v2ex.com/t/1247240", "created": 1791508342, "deleted": 0, "content": "刚被裁员，家里又催着相亲，在此之前我已经扛了一两年的催促了，这次实在扛不住了。\r\n\r\n家里人说这两天把女方微信号要过来，让我聊着看看。我还没相过亲，一想到和陌生人尬聊就头痛，毕竟我连异性朋友也很少聊天，实在不知道聊什么。\r\n\r\n去小红书上搜了一圈，上面那些什么打开话题、把握节奏、几次见面、吃什么饭之类的看的我头大如斗，我好反感这些所谓“技巧”的东西，却也不知道到底该聊些什么。\r\n\r\n---\r\n\r\n也看到本站有人说，相亲只是个提供认识的途径，并不是直接谈对象，我能理解他的意思。 但是回想之前的恋爱，那个时候我是先心动，然后对方对我也有意思，并且两人是大学同学，有蛮多共同话题可以聊，两个人很快就能聊起来。\r\n\r\n但到了相亲这里，我真的不知道和别人聊些什么，聊破碎的原生家庭还是聊自己被裁员了？ 或者和对方互查户口？要问我有什么兴趣，打打网游，骑自行车出去乱逛，写点代码做点玩具项目，再或者弹琴。\r\n\r\n我不知道有哪些可以和对方聊的，也不知道对方的兴趣是啥。 据我观察身边的几个同龄女同事，她们每天聊的都是乙游、娱乐圈八卦、追星、衣服、化妆品、旅游啥的，我感觉我一句也插不上。", "content_rendered": "<p>刚被裁员，家里又催着相亲，在此之前我已经扛了一两年的催促了，这次实在扛不住了。</p>\n<p>家里人说这两天把女方微信号要过来，让我聊着看看。我还没相过亲，一想到和陌生人尬聊就头痛，毕竟我连异性朋友也很少聊天，实在不知道聊什么。</p>\n<p>去小红书上搜了一圈，上面那些什么打开话题、把握节奏、几次见面、吃什么饭之类的看的我头大如斗，我好反感这些所谓“技巧”的东西，却也不知道到底该聊些什么。</p>\n<hr/>\n<p>也看到本站有人说，相亲只是个提供认识的途径，并不是直接谈对象，我能理解他的意思。 但是回想之前的恋爱，那个时候我是先心动，然后对方对我也有意思，并且两人是大学同学，有蛮多共同话题可以聊，两个人很快就能聊起来。</p>\n<p>但到了相亲这里，我真的不知道和别人聊些什么，聊破碎的原生家庭还是聊自己被裁员了？ 或者和对方互查户口？要问我有什么兴趣，打打网游，骑自行车出去乱逛，写点代码做点玩具项目，再或者弹琴。</p>\n<p>我不知道有哪些可以和对方聊的，也不知道对方的兴趣是啥。 据我观察身边的几个同龄女同事，她们每天聊的都是乙游、娱乐圈八卦、追星、衣服、化妆品、旅游啥的，我感觉我一句也插不上。</p>\n", "last_modified": 1791508342, "replies": 121, "id": 1247240}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11843, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2502, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 439374, "username": "youngyeah", "url": "https://www.v2ex.com/u/youngyeah", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/9ce32bd49ccdf9524ba888d2a009ebe5?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9ce32bd49ccdf9524ba888d2a009ebe5?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9ce32bd49ccdf9524ba888d2a009ebe5?s=73&d=retro", "created": 1567478552, "last_modified": 1567478552, "pro": 0}, "last_reply_by": "zhao69270", "last_touched": 1791526778, "title": "绝了，碰到神人了！一大早给我奶头气堵了", "url": "https://www.v2ex.com/t/1247250", "created": 1791510117, "deleted": 0, "content": "背景：我们小区有梯控，要刷卡才能上去，所以像京东顺丰一类的快递都是放在电梯里的。\r\n\r\n前两天我的一个京东快递找不到了，昨晚就让管家查了一下监控，后面果然找到了，被另一个邻居给踢出去了。然后我就让管家联系一下那个邻居，为啥踢出去，管家回复说当成垃圾踢出去了。。。态度还很恶劣，说她以为里面是个空盒子就踢出去，不是她拿的，让报警，我一整个黑人问号，一、把垃圾从电梯里踢到一楼的电梯口，有什么意义吗？但凡她把垃圾扔到垃圾桶我都能理解。二、把别人的东西弄丢了还给她急上了，一般这种时候不应该想着给人赔偿吗。\r\n\r\n因为里面就是个几块钱的东西，我跟管家说我不报警了，以后如果我碰到了她家的快递不小心踢出去的话，希望她多多包涵。并且让管家把这个话一定要转告她。\r\n\r\n ![]( https://i.imgur.com/bliFl8f.png)  ![]( https://i.imgur.com/LFIOgup.png)  ![]( https://i.imgur.com/MLUTjX5.png) \r\nhttps://www.lnjubao.cn/minio-jbpt/upload/20261009/0df3122b1a84ab4d1e6509ddfbd675fa.mp4", "content_rendered": "<p>背景：我们小区有梯控，要刷卡才能上去，所以像京东顺丰一类的快递都是放在电梯里的。</p>\n<p>前两天我的一个京东快递找不到了，昨晚就让管家查了一下监控，后面果然找到了，被另一个邻居给踢出去了。然后我就让管家联系一下那个邻居，为啥踢出去，管家回复说当成垃圾踢出去了。。。态度还很恶劣，说她以为里面是个空盒子就踢出去，不是她拿的，让报警，我一整个黑人问号，一、把垃圾从电梯里踢到一楼的电梯口，有什么意义吗？但凡她把垃圾扔到垃圾桶我都能理解。二、把别人的东西弄丢了还给她急上了，一般这种时候不应该想着给人赔偿吗。</p>\n<p>因为里面就是个几块钱的东西，我跟管家说我不报警了，以后如果我碰到了她家的快递不小心踢出去的话，希望她多多包涵。并且让管家把这个话一定要转告她。</p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/bliFl8f.png\"/> <img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/LFIOgup.png\"/> <img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/MLUTjX5.png\"/>\n<a href=\"https://www.lnjubao.cn/minio-jbpt/upload/20261009/0df3122b1a84ab4d1e6509ddfbd675fa.mp4\" rel=\"nofollow\">https://www.lnjubao.cn/minio-jbpt/upload/20261009/0df3122b1a84ab4d1e6509ddfbd675fa.mp4</a></p>\n", "last_modified": 1791510117, "replies": 65, "id": 1247250}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/38af/8613/176_large.png?m=1644885960", "name": "car", "avatar_normal": "https://cdn.v2ex.com/navatar/38af/8613/176_normal.png?m=1644885960", "title": "汽车", "url": "https://www.v2ex.com/go/car", "topics": 3313, "footer": "", "header": "关于买车、开车及汽车文化的技术讨论", "title_alternative": "Car", "avatar_mini": "https://cdn.v2ex.com/navatar/38af/8613/176_mini.png?m=1644885960", "stars": 2310, "founder_id": 0, "aliases": [], "root": false, "id": 176, "parent_node_name": "life"}, "member": {"id": 239594, "username": "jacketma", "url": "https://www.v2ex.com/u/jacketma", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/a941f83ac4192740c2e1f95676ce23c5?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/a941f83ac4192740c2e1f95676ce23c5?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/a941f83ac4192740c2e1f95676ce23c5?s=73&d=retro", "created": 1499704166, "last_modified": 1787729897, "pro": 0}, "last_reply_by": "jasonyang9", "last_touched": 1791527812, "title": "紧急情况，不应该一脚踩死么，还要点点刹？", "url": "https://www.v2ex.com/t/1247194", "created": 1791469588, "deleted": 0, "content": "以前遇到老司机总说我踩刹车，老是一脚踩死，这个习惯不好。应该踩一脚松一下再踩死，这样更安全\r\n\r\n今天网上又看到老司机争论说：高速踩刹车要点点再踩死，说这样既不会踩断刹车，也不打滑。\r\n\r\n能理解多次点刹肯定更不易损坏刹车，也更安全，问题是遇到紧急情况本能就一脚踩到底啊，再松一下不是又往前多冲出距离了么。\r\n\r\n再说，高速情况，踩>松>踩 那得多块的脚速啊，这™是老司机炫技，还是挖坑呢，有老铁说说真的能做到吗？", "content_rendered": "以前遇到老司机总说我踩刹车，老是一脚踩死，这个习惯不好。应该踩一脚松一下再踩死，这样更安全<br /><br />今天网上又看到老司机争论说：高速踩刹车要点点再踩死，说这样既不会踩断刹车，也不打滑。<br /><br />能理解多次点刹肯定更不易损坏刹车，也更安全，问题是遇到紧急情况本能就一脚踩到底啊，再松一下不是又往前多冲出距离了么。<br /><br />再说，高速情况，踩&gt;松&gt;踩 那得多块的脚速啊，这™是老司机炫技，还是挖坑呢，有老铁说说真的能做到吗？", "last_modified": 1791469588, "replies": 60, "id": 1247194}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242112, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4527, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 50585, "username": "chevalier", "url": "https://www.v2ex.com/u/chevalier", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9c76/63be/50585_mini.png?m=1673943926", "avatar_normal": "https://cdn.v2ex.com/avatar/9c76/63be/50585_normal.png?m=1673943926", "avatar_large": "https://cdn.v2ex.com/avatar/9c76/63be/50585_large.png?m=1673943926", "created": 1385430644, "last_modified": 1673943926, "pro": 0}, "last_reply_by": "xlxx", "last_touched": 1791528745, "title": "大家多久没去电影院看电影了", "url": "https://www.v2ex.com/t/1247254", "created": 1791510613, "deleted": 0, "content": "看新闻国庆院线票房创 12 年新低，看来大家都不愿意去影院了\r\n\r\n我已经想不起来上次去电影院看电影是什么时候看的什么电影了\r\n\r\n\r\n个人不喜欢电影院看电影，电影院冬天暖气太热夏天空调又太冷，之前去也都是陪老婆去，更喜欢自己在家用大显示器或电视看，观影角度最佳，可以暂停放水，可以肆无忌惮的吃零食", "content_rendered": "<p>看新闻国庆院线票房创 12 年新低，看来大家都不愿意去影院了</p>\n<p>我已经想不起来上次去电影院看电影是什么时候看的什么电影了</p>\n<p>个人不喜欢电影院看电影，电影院冬天暖气太热夏天空调又太冷，之前去也都是陪老婆去，更喜欢自己在家用大显示器或电视看，观影角度最佳，可以暂停放水，可以肆无忌惮的吃零食</p>\n", "last_modified": 1791510613, "replies": 57, "id": 1247254}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 37424, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6216, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 542027, "username": "YinBuLiao", "url": "https://www.v2ex.com/u/YinBuLiao", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/0013613579c13a61670a400ccdc40e23?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/0013613579c13a61670a400ccdc40e23?s=48&d=retro", "avatar_large": "https: