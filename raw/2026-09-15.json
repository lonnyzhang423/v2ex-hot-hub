[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11691, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2466, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 636623, "username": "HHJY", "url": "https://www.v2ex.com/u/HHJY", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/b5e7/7c1d/636623_mini.png?m=1789449498", "avatar_normal": "https://cdn.v2ex.com/avatar/b5e7/7c1d/636623_normal.png?m=1789449498", "avatar_large": "https://cdn.v2ex.com/avatar/b5e7/7c1d/636623_large.png?m=1789449498", "avatar_xlarge": "https://cdn.v2ex.com/avatar/b5e7/7c1d/636623_xlarge.png?m=1789449498", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/b5e7/7c1d/636623_xxlarge.png?m=1789449498", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/b5e7/7c1d/636623_xxxlarge.png?m=1789449498", "created": 1688119490, "last_modified": 1789449498, "pro": 0}, "last_reply_by": "ruolis", "last_touched": 1789480471, "title": "老婆太颓废了", "url": "https://www.v2ex.com/t/1242123", "created": 1789449358, "deleted": 0, "content": "我和爱人在 2023 年结婚，双方都是计算机行业。她前端我数据。\r\n\r\nai 发展对前端影响非常大，从 24 年底她的工作就不太稳定，25 年上半年基本没有上班（中间零星两三份工作加一起有一个月左右）。25 年下半年找到一个工作，但是加班比较频繁，她一直找我吐槽，我便督促她学习新的知识转行，不要继续前端了，但是她一直以工作忙等理由推辞，时间久了也就不了了之。\r\n\r\n25 年底怀孕了，然后她说公司一直加班且有人在公司抽烟，想辞职在家养胎，我考虑再三后同意了。不过和她说好了要抽空学习，后面找一个别的稳定工作，她也答应了。\r\n\r\n怀孕期间，我多次和她沟通让学习，但是她每次都和我吵架，一直往后拖。到现在宝宝已经出生两个多月了，依然不学习，每次说到找工作，就说我以后随便找个工作干、我去捡破烂、我去电子厂云云。以我对她的了解，这些都不可能。\r\n我们两个家里都是农村的，全靠自己打拼，家里没办法给什么帮助。我的想法是不要求她有多好的工作，但是不能一直在家呆着和社会脱节，哪怕出去找个有意义的工作干着都行。\r\n\r\n今天和她打电话说起来学习找工作的事情，又吵了一架。现在非常烦，不知道她以后就这样一直在家会变成什么样。"