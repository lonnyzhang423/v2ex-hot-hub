[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24494, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3746, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_large": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_large.png?m=1691393963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xlarge.png?m=1691393963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxlarge.png?m=1691393963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxxlarge.png?m=1691393963", "created": 1663333667, "last_modified": 1691393963, "pro": 0}, "last_reply_by": "xzg1993", "last_touched": 1790828182, "title": "节前最后一天，被裁员了。", "url": "https://www.v2ex.com/t/1245891", "created": 1790766879, "deleted": 0, "content": "下午三点，正想着待会吃啥，人事突然叫我去办公室，然后就是宣布裁员，N+1 ，走流程。\r\n\r\n人生第一次经历裁员，我到现在整个人都还是懵的。 回家的地铁上下载了 BOSS 直聘，随便搜了几个前端岗位，脑子烦躁的根本看不下去。\r\n\r\n和另一个同样被裁的同事聊了几句，他说市面上现在都不招前端了，招全栈和 Agent 开发，听得我头大如斗，我的三脚猫 golang 和 php 能算全栈吗？\r\n\r\n储蓄还有两万，赔偿金和本月工资一起在 10 号发放，但房租 11 月就要到期了。 我很发愁再找不到工作还能干啥？唉。", "content_rendered": "<p>下午三点，正想着待会吃啥，人事突然叫我去办公室，然后就是宣布裁员，N+1 ，走流程。</p>\n<p>人生第一次经历裁员，我到现在整个人都还是懵的。 回家的地铁上下载了 BOSS 直聘，随便搜了几个前端岗位，脑子烦躁的根本看不下去。</p>\n<p>和另一个同样被裁的同事聊了几句，他说市面上现在都不招前端了，招全栈和 Agent 开发，听得我头大如斗，我的三脚猫 golang 和 php 能算全栈吗？</p>\n<p>储蓄还有两万，赔偿金和本月工资一起在 10 号发放，但房租 11 月就要到期了。 我很发愁再找不到工作还能干啥？唉。</p>\n", "last_modified": 1790815860, "replies": 53, "id": 1245891}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73670, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 240871, "username": "zackkk", "url": "https://www.v2ex.com/u/zackkk", "website": "https://tigg.cc", "twitter": "", "psn": "", "github": "", "btc": "", "location": "东京", "tagline": "东京，码代码，码字，码一切东西", "bio": "特别喜欢骑车，骑遍整个日本。", "avatar_mini": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_mini.png?m=1789866502", "avatar_normal": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_normal.png?m=1789866502", "avatar_large": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_large.png?m=1789866502", "avatar_xlarge": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_xlarge.png?m=1789866502", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_xxlarge.png?m=1789866502", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_xxxlarge.png?m=1789866502", "created": 1500344816, "last_modified": 1789866502, "pro": 0}, "last_reply_by": "tiaod", "last_touched": 1790841077, "title": "产品形态来说，好多咱们的程序员以为 APP > WEB", "url": "https://www.v2ex.com/t/1245970", "created": 1790820783, "deleted": 0, "content": "web 在咱们这边也有回归的趋势。\r\n规范一直在升级，性能和其他优势越来越多\r\n\r\n而且只是在咱们这边被无法描述的原因，让 APP 横扫一切，但其实地球上不全是这样的\r\n我感觉是喜欢 web", "content_rendered": "<p>web 在咱们这边也有回归的趋势。\n规范一直在升级，性能和其他优势越来越多</p>\n<p>而且只是在咱们这边被无法描述的原因，让 APP 横扫一切，但其实地球上不全是这样的\n我感觉是喜欢 web</p>\n", "last_modified": 1790820783, "replies": 34, "id": 1245970}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73670, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 477100, "username": "ttkit", "url": "https://www.v2ex.com/u/ttkit", "website": "https://ttkit.cn/", "twitter": "", "psn": "", "github": "HelTi", "btc": "", "location": "", "tagline": "不向外求，向内求己。", "bio": "世界因你而不同。", "avatar_mini": "https://cdn.v2ex.com/avatar/70ec/b9bd/477100_mini.png?m=1737708300", "avatar_normal": "https://cdn.v2ex.com/avatar/70ec/b9bd/477100_normal.png?m=1737708300", "avatar_large": "https://cdn.v2ex.com/avatar/70ec/b9bd/477100_large.png?m=1737708300", "avatar_xlarge": "https://cdn.v2ex.com/avatar/70ec/b9bd/477100_xlarge.png?m=1737708300", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/70ec/b9bd/477100_xxlarge.png?m=1737708300", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/70ec/b9bd/477100_xxxlarge.png?m=1737708300", "created": 1584412047, "last_modified": 1737708300, "pro": 0}, "last_reply_by": "Y25tIGxpdmlk", "last_touched": 1790795974, "title": "个人开发者，在职如何申请个体工商户", "url": "https://www.v2ex.com/t/1245878", "created": 1790761572, "deleted": 0, "content": "目前在做小程序，因为个人主体账户不能开发 AI 相关的功能，限制太多，目前想注册个体工商户，但是没有经验。想了解下是否有注册过个体工商户的友友谈下经验。", "content_rendered": "<p>目前在做小程序，因为个人主体账户不能开发 AI 相关的功能，限制太多，目前想注册个体工商户，但是没有经验。想了解下是否有注册过个体工商户的友友谈下经验。</p>\n", "last_modified": 1790761572, "replies": 27, "id": 1245878}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73670, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 758918, "username": "DeepSIeep", "url": "https://www.v2ex.com/u/DeepSIeep", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/142d/6dc1/758918_mini.png?m=1785124240", "avatar_normal": "https://cdn.v2ex.com/avatar/142d/6dc1/758918_normal.png?m=1785124240", "avatar_large": "https://cdn.v2ex.com/avatar/142d/6dc1/758918_large.png?m=1785124240", "created": 1753236507, "last_modified": 1785124240, "pro": 0}, "last_reply_by": "qiaobeier", "last_touched": 1790840641, "title": "AI 写的项目，让 AI 排查问题。但是有没有感觉沟通过程中读 AI 说的话很费劲，很难懂。。。", "url": "https://www.v2ex.com/t/1245889", "created": 1790765708, "deleted": 0, "content": "", "content_rendered": "", "last_modified": 1790765708, "replies": 27, "id": 1245889}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 47366, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6360, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 679304, "username": "osilinka", "url": "https://www.v2ex.com/u/osilinka", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_mini.png?m=1782664383", "avatar_normal": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_normal.png?m=1782664383", "avatar_large": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_large.png?m=1782664383", "avatar_xlarge": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_xlarge.png?m=1782664383", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_xxlarge.png?m=1782664383", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_xxxlarge.png?m=1782664383", "created": 1709826073, "last_modified": 1782664383, "pro": 0}, "last_reply_by": "Simle100", "last_touched": 1790831162, "title": "Gemini 4 出来了，吊打其他的公司啊", "url": "https://www.v2ex.com/t/1245940", "created": 1790799912, "deleted": 0, "content": "Gemini 4 出来了，吊打其他的公司啊\r\n周三，该公司发布了 Gemini4Argon ，这是迄今为止最先进的人工智能模型，在编码、网络安全和复杂的专业工作方面提供了重大改进。\r\n该公司表示，该模型在现实世界的软件工程方面创造了新的记录，在网络安\r\n全方面并列第一，并在衡量金融、法律和其他专业任务绩效的另一项基准中\r\n领先。\r\n谷歌表示，Argon 已在公司内部用于优化其数据中心的内存，无需购买额外硬件即可释放数百 TB 的内存。量子计算研究人员也已利用了该模型。", "content_rendered": "<p>Gemini 4 出来了，吊打其他的公司啊\n周三，该公司发布了 Gemini4Argon ，这是迄今为止最先进的人工智能模型，在编码、网络安全和复杂的专业工作方面提供了重大改进。\n该公司表示，该模型在现实世界的软件工程方面创造了新的记录，在网络安\n全方面并列第一，并在衡量金融、法律和其他专业任务绩效的另一项基准中\n领先。\n谷歌表示，Argon 已在公司内部用于优化其数据中心的内存，无需购买额外硬件即可释放数百 TB 的内存。量子计算研究人员也已利用了该模型。</p>\n", "last_modified": 1790799912, "replies": 22, "id": 1245940}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "avatar_normal": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_normal.png?m=1751736790", "title": "Claude", "url": "https://www.v2ex.com/go/claude", "topics": 963, "footer": "", "header": "", "title_alternative": "Claude", "avatar_mini": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_mini.png?m=1751736790", "stars": 728, "founder_id": 0, "aliases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 102641, "username": "milkleeeeee", "url": "https://www.v2ex.com/u/milkleeeeee", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_mini.png?m=1641529094", "avatar_normal": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_normal.png?m=1641529094", "avatar_large": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_large.png?m=1641529094", "avatar_xlarge": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_xlarge.png?m=1641529094", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_xxlarge.png?m=1641529094", "created": 1425548795, "last_modified": 1641529094, "pro": 0}, "last_reply_by": "tianmenshan", "last_touched": 1790839368, "title": "号被封了……", "url": "https://www.v2ex.com/t/1245975", "created": 1790822687, "deleted": 0, "content": "前情提要： https://www.v2ex.com/t/1244849\r\n\r\n一大早收到了两封邮件，内容一模一样……正在填申诉内容\r\n\r\n```\r\nYour account has been suspended\r\n\r\nHello,\r\n\r\nAn internal investigation of suspicious signals associated with your account indicates a violation of our Usage Policy. As a result, we have revoked your access to Claude.\r\n\r\nTo appeal our decision, log in to claude.ai with this account and you'll be taken to the appeals page. You can learn more about the process here.\r\n\r\nRegards\r\n\r\nAnthropic's Safeguards Team\r\n```", "content_rendered": "<p>前情提要： <a href=\"https://www.v2ex.com/t/1244849\" rel=\"nofollow\">https://www.v2ex.com/t/1244849</a></p>\n<p>一大早收到了两封邮件，内容一模一样……正在填申诉内容</p>\n<pre><code>Your account has been suspended\n\nHello,\n\nAn internal investigation of suspicious signals associated with your account indicates a violation of our Usage Policy. As a result, we have revoked your access to Claude.\n\nTo appeal our decision, log in to claude.ai with this account and you'll be taken to the appeals page. You can learn more about the process here.\n\nRegards\n\nAnthropic's Safeguards Team\n</code></pre>\n", "last_modified": 1790822687, "replies": 20, "id": 1245975}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11803, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2495, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 367295, "username": "iixy", "url": "https://www.v2ex.com/u/iixy", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5fad/1233/367295_mini.png?m=1775722356", "avatar_normal": "https://cdn.v2ex.com/avatar/5fad/1233/367295_normal.png?m=1775722356", "avatar_large": "https://cdn.v2ex.com/avatar/5fad/1233/367295_large.png?m=1775722356", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5fad/1233/367295_xlarge.png?m=1775722356", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5fad/1233/367295_xxlarge.png?m=1775722356", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/5fad/1233/367295_xxxlarge.png?m=1775722356", "created": 1543736687, "last_modified": 1775722356, "pro": 0}, "last_reply_by": "lany", "last_touched": 1790834464, "title": "小区净水器 or 家用净水器选择？", "url": "https://www.v2ex.com/t/1245961", "created": 1790817381, "deleted": 0, "content": "前面几年一直用的小区内装的康基净水器，大概 2 天接一次，我用的 15L 的桶，一次 4 元（折扣前）。\r\n\r\n我一次充大几百有赠送余额，算下来每年实际费用大概在 500 元左右。\r\n\r\n现在在想有没有必要装个家用净水器，又担心小型的家用净水器达不到小区大设备的那个效果，而且装着麻烦占地。不知道要买多少钱的净水器才能达到效果？不追求直饮但要几乎无水垢的。\r\n\r\n自己接水的问题就是有点费人。", "content_rendered": "<p>前面几年一直用的小区内装的康基净水器，大概 2 天接一次，我用的 15L 的桶，一次 4 元（折扣前）。</p>\n<p>我一次充大几百有赠送余额，算下来每年实际费用大概在 500 元左右。</p>\n<p>现在在想有没有必要装个家用净水器，又担心小型的家用净水器达不到小区大设备的那个效果，而且装着麻烦占地。不知道要买多少钱的净水器才能达到效果？不追求直饮但要几乎无水垢的。</p>\n<p>自己接水的问题就是有点费人。</p>\n", "last_modified": 1790817485, "replies": 19, "id": 1245961}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_large.png?m=1751736785", "name": "openai", "avatar_normal": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_normal.png?m=1751736785", "title": "OpenAI", "url": "https://www.v2ex.com/go/openai", "topics": 4906, "footer": "", "header": "关于 OpenAI 旗下产品 GPT，DALL·E，和 ChatGPT 的讨论。请不要在 V2EX 的回复中粘贴复制来自 AI 生成的文本。", "title_alternative": "OpenAI", "avatar_mini": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3384, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 80631, "username": "momowei", "url": "https://www.v2ex.com/u/momowei", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/5d51756303e9a5222f04f031f6a135d4?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/5d51756303e9a5222f04f031f6a135d4?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/5d51756303e9a5222f04f031f6a135d4?s=73&d=retro", "created": 1415367465, "last_modified": 1782810978, "pro": 0}, "last_reply_by": "katoyu", "last_touched": 1790790142, "title": "你们的 gpt6.1 sol 都有了吗", "url": "https://www.v2ex.com/t/1245883", "created": 1790762291, "deleted": 0, "content": "我 plus 账户，为啥到现在 codex cli 里都还没有 gpt6.1 的模型，更新到最新版本了", "content_rendered": "我 plus 账户，为啥到现在 codex cli 里都还没有 gpt6.1 的模型，更新到最新版本了", "last_modified": 1790815907, "replies": 18, "id": 1245883}]