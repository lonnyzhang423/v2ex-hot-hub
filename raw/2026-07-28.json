d": 300, "parent_node_name": "computer"}, "member": {"id": 799621, "username": "sjjgpt", "url": "https://www.v2ex.com/u/sjjgpt", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/96186b4bd88f2e541af57578f1c98dd2?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/96186b4bd88f2e541af57578f1c98dd2?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/96186b4bd88f2e541af57578f1c98dd2?s=73&d=retro", "created": 1775206079, "last_modified": 1775206079, "pro": 0}, "last_reply_by": "panas", "last_touched": 1785223103, "title": "收到律师函了，不让用了", "url": "https://www.v2ex.com/t/1230329", "created": 1785206409, "deleted": 0, "content": "mac 有没有类似于 navicat 的数据库管理工具，找了几个 dbx,hexhub 都差强人意", "content_rendered": "<p>mac 有没有类似于 navicat 的数据库管理工具，找了几个 dbx,hexhub 都差强人意</p>\n", "last_modified": 1785206409, "replies": 75, "id": 1230329}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240273, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4503, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 314256, "username": "Yuki321", "url": "https://www.v2ex.com/u/Yuki321", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/c1ba/1d03/314256_mini.png?m=1785207585", "avatar_normal": "https://cdn.v2ex.com/avatar/c1ba/1d03/314256_normal.png?m=1785207585", "avatar_large": "https://cdn.v2ex.com/avatar/c1ba/1d03/314256_large.png?m=1785207585", "avatar_xlarge": "https://cdn.v2ex.com/avatar/c1ba/1d03/314256_xlarge.png?m=1785207585", "created": 1525431479, "last_modified": 1785207585, "pro": 0}, "last_reply_by": "chjqpmain", "last_touched": 1785222883, "title": "存了 100w+，太想躺平了", "url": "https://www.v2ex.com/t/1230348", "created": 1785207493, "deleted": 0, "content": "现金存款，公积金，商业保险（储蓄性质类）\r\n加起来超 100w 了，无房无贷无娃\r\n每天都想摆烂躺平，低物欲，如果是你们，你们会怎么选择！！\r\n原来想的是，100w 了就去外面上学体验下，现在这个想法又没那么强烈了", "content_rendered": "<p>现金存款，公积金，商业保险（储蓄性质类）\n加起来超 100w 了，无房无贷无娃\n每天都想摆烂躺平，低物欲，如果是你们，你们会怎么选择！！\n原来想的是，100w 了就去外面上学体验下，现在这个想法又没那么强烈了</p>\n", "last_modified": 1785207493, "replies": 72, "id": 1230348}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11332, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2413, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 356707, "username": "SoldierL", "url": "https://www.v2ex.com/u/SoldierL", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "上海", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/33f0/561d/356707_mini.png?m=1774247368", "avatar_normal": "https://cdn.v2ex.com/avatar/33f0/561d/356707_normal.png?m=1774247368", "avatar_large": "https://cdn.v2ex.com/avatar/33f0/561d/356707_large.png?m=1774247368", "avatar_xlarge": "https://cdn.v2ex.com/avatar/33f0/561d/356707_xlarge.png?m=1774247368", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/33f0/561d/356707_xxlarge.png?m=1774247368", "created": 1539765162, "last_modified": 1774247368, "pro": 0}, "last_reply_by": "adimn", "last_touched": 1785223823, "title": "最近悟道了，人生本来就没有意义", "url": "https://www.v2ex.com/t/1230230", "created": 1785157010, "deleted": 0, "content": "苦卷十余载，从年轻小伙子熬成了满头白发。\r\n\r\n从一无所有熬到了有房有车有娃。\r\n\r\n从满身轻松熬到了债务累累。\r\n\r\n想想快到 35 的年龄，看看格子间和小屏幕，不知道还能坚持多久。\r\n\r\n最近总是幻想，几年之后，财务自由，躺在老家的院子里一杯茶一支烟的惬意。\r\n\r\n又不知道什么时候才会到来。\r\n\r\n人生本来就没有意义，总是向往轻松一些，又跳不出这个世俗的圈子和所谓的成就感。\r\n\r\n我说我不卷，他们都在笑。\r\n\r\n在办公室越来越坐不住，原来不是腰疼，也不是颈椎，也不是胃疼，而是我的心，已经不在这里。", "content_rendered": "<p>苦卷十余载，从年轻小伙子熬成了满头白发。</p>\n<p>从一无所有熬到了有房有车有娃。</p>\n<p>从满身轻松熬到了债务累累。</p>\n<p>想想快到 35 的年龄，看看格子间和小屏幕，不知道还能坚持多久。</p>\n<p>最近总是幻想，几年之后，财务自由，躺在老家的院子里一杯茶一支烟的惬意。</p>\n<p>又不知道什么时候才会到来。</p>\n<p>人生本来就没有意义，总是向往轻松一些，又跳不出这个世俗的圈子和所谓的成就感。</p>\n<p>我说我不卷，他们都在笑。</p>\n<p>在办公室越来越坐不住，原来不是腰疼，也不是颈椎，也不是胃疼，而是我的心，已经不在这里。</p>\n", "last_modified": 1785197242, "replies": 67, "id": 1230230}]