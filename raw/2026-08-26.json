[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241056, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4510, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 395473, "username": "hailaz", "url": "https://www.v2ex.com/u/hailaz", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/f81b/a768/395473_mini.png?m=1761878630", "avatar_normal": "https://cdn.v2ex.com/avatar/f81b/a768/395473_normal.png?m=1761878630", "avatar_large": "https://cdn.v2ex.com/avatar/f81b/a768/395473_large.png?m=1761878630", "avatar_xlarge": "https://cdn.v2ex.com/avatar/f81b/a768/395473_xlarge.png?m=1761878630", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/f81b/a768/395473_xxlarge.png?m=1761878630", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/f81b/a768/395473_xxxlarge.png?m=1761878630", "created": 1553592800, "last_modified": 1761878630, "pro": 0}, "last_reply_by": "Yjhenan", "last_touched": 1787710347, "title": "居然没人讨论玄戒 O3,不应该呀？", "url": "https://www.v2ex.com/t/1236977", "created": 1787624325, "deleted": 0, "content": "在 B 站看了几个 up 的视频，虽然是在开发版上测，但是真的强。", "content_rendered": "在 B 站看了几个 up 的视频，虽然是在开发版上测，但是真的强。", "last_modified": 1787624325, "replies": 178, "id": 1236977}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11568, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2452, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 364493, "username": "rafa", "url": "https://www.v2ex.com/u/rafa", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=73&d=retro", "created": 1542711212, "last_modified": 1542711212, "pro": 0}, "last_reply_by": "phithon", "last_touched": 1787710040, "title": "干了件蠢事，拿 WD-40 喷了刹车盘", "url": "https://www.v2ex.com/t/1237045", "created": 1787636270, "deleted": 0, "content": "起因：\r\n 100 块的 手机支架不能正常回弹了，遂去 pdd 买了一瓶 wd40 ，想着缓解下。\r\n 结果喷完后，我脑子立刻生了一个 idea ，我刹车的时候老是发出异响，让我很难受，所以我直接就喷上去了，前后都喷了。。。。。\r\n\r\n好了，刹车没了，下午去换了刹车片，还是不行，刹车效果很差，要换碟了", "content_rendered": "<p>起因：\n100 块的 手机支架不能正常回弹了，遂去 pdd 买了一瓶 wd40 ，想着缓解下。\n结果喷完后，我脑子立刻生了一个 idea ，我刹车的时候老是发出异响，让我很难受，所以我直接就喷上去了，前后都喷了。。。。。</p>\n<p>好了，刹车没了，下午去换了刹车片，还是不行，刹车效果很差，要换碟了</p>\n", "last_modified": 1787636270, "replies": 163, "id": 1237045}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_large.png?m=1784627111", "name": "atm", "avatar_normal": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_normal.png?m=1784627111", "title": "每日一🐢", "url": "https://www.v2ex.com/go/atm", "topics": 20, "footer": "", "header": "除非有实锤或者非常离谱的，否则都当真的看。\r\n不然天天这个假那个假的，还上啥网啊。", "title_alternative": "每日一🐢", "avatar_mini": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_mini.png?m=1784627111", "stars": 372, "founder_id": 415795, "aliases": [], "root": false, "id": 1234, "parent_node_name": null}, "member": {"id": 157791, "username": "dummyx", "url": "https://www.v2ex.com/u/dummyx", "website": "", "twitter": "", "psn": "", "github": "fengxsong", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/3afa/4784/157791_mini.png?m=1787649446", "avatar_normal": "https://cdn.v2ex.com/avatar/3afa/4784/157791_normal.png?m=1787649446", "avatar_large": "https://cdn.v2ex.com/avatar/3afa/4784/157791_large.png?m=1787649446", "avatar_xlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xlarge.png?m=1787649446", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xxlarge.png?m=1787649446", "created": 1454381089, "last_modified": 1787649446, "pro": 0}, "last_reply_by": "dummyx", "last_touched": 1787710139, "title": "说说离婚后的一些事", "url": "https://www.v2ex.com/t/1237123", "created": 1787649448, "deleted": 0, "content": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。\r\n\r\n协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。\r\n\r\n上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。\r\n\r\n感觉很无奈。", "content_rendered": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。<br /><br />协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。<br /><br />上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。<br /><br />感觉很无奈。", "last_modified": 1787649448, "replies": 99, "id": 1237123}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241056, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4510, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 777887, "username": "KingW777", "url": "https://www.v2ex.com/u/KingW777", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_mini.png?m=1765501354", "avatar_normal": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_normal.png?m=1765501354", "avatar_large": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_large.png?m=1765501354", "avatar_xlarge": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_xlarge.png?m=1765501354", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_xxlarge.png?m=1765501354", "created": 1765500480, "last_modified": 1765501354, "pro": 0}, "last_reply_by": "hengo", "last_touched": 1787710431, "title": "绿米指纹锁阵亡，建议换哪个牌子靠谱？", "url": "https://www.v2ex.com/t/1237038", "created": 1787633900, "deleted": 0, "content": "绿米当年的团队已经解散，微信联系了当时安装的师傅，建议我直接换新（但不建议再买绿米）。京东看下来销量高的也就德施曼和凯迪仕牌子销量大一些，价格还都不高。\r\n这两个名字听起来有点混血基因的指纹锁功能繁杂，应该选德施曼还是凯迪仕？有踩过坑的同学吗？", "content_rendered": "<p>绿米当年的团队已经解散，微信联系了当时安装的师傅，建议我直接换新（但不建议再买绿米）。京东看下来销量高的也就德施曼和凯迪仕牌子销量大一些，价格还都不高。\n这两个名字听起来有点混血基因的指纹锁功能繁杂，应该选德施曼还是凯迪仕？有踩过坑的同学吗？</p>\n", "last_modified": 1787633930, "replies": 63, "id": 1237038}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "avatar_normal": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_normal.png?m=1751736790", "title": "Claude", "url": "https://www.v2ex.com/go/claude", "topics": 880, "footer": "", "header": "", "title_alternative": "Claude", "avatar_mini": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_mini.png?m=1751736790", "stars": 699, "founder_id": 0, "aliases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 674540, "username": "creafTi", "url": "https://www.v2ex.com/u/creafTi", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_mini.png?m=1774410372", "avatar_normal": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_normal.png?m=1774410372", "avatar_large": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_large.png?m=1774410372", "avatar_xlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xlarge.png?m=1774410372", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xxlarge.png?m=1774410372", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xxxlarge.png?m=1774410372", "created": 1706862177, "last_modified": 1774410372, "pro": 0}, "last_reply_by": "zpxshl", "last_touched": 1787709567, "title": "Claude 是真是👍，四天被封俩号，不想折腾了", "url": "https://www.v2ex.com/t/1237175", "created": 1787665424, "deleted": 0, "content": "最近重构一个项目，sol5.6 老降智商，防御性编码太多，设计出来的东西也要跟他掰扯很久才能如意\r\n\r\n#### 第一次\r\n想想开个 Claude 试试，AppStore 付款，爽蹬一个下午，感觉还挺耐用，一个半小时差不多跑完了五小时限额的 80%。\r\n然后喜提 ON HOLD 。很快啊，写了解封邮件。calude 你不讲武德啊，我正儿八经搞项目呢，你给我封了是弄啥嘞。\r\n然后丝滑小连招，appleStore 同步申请退款。\r\n\r\n过了一天 apple 退款到账，第二天 calude 回复 remain ON HOLD 。不给我解封是吧，你等着\r\n\r\n#### 第二次\r\n然后又注册了一个号\r\n这次做足准备，查了 calude 封号原因，ip 是很大一个因素，重金上车了美区 DMIT EB VPS 。号称家宽优化\r\n那顶的确实比第一次久一点，足足用了三天！不过我分析可能是头两天没怎么用，今天重度使用了一下，直接又 ON HOLD 了， 我淦霖娘啊 CLAUDE ！\r\n让 gpt 帮我写了解封申请，不过已经不抱什么希望了，就这样吧 bro 。\r\n\r\n\r\n#### 最后\r\n折腾了一圈，用回了 GPT 、感觉也不是那么差嘛。\r\nclaude 不让用，咱也没必要上赶着给他送钱\r\n自此 openAI 又眉清目秀了起来\r\n一切又回到了原来的起点...\r\n\r\n(多写点 promote 就好啦", "content_rendered": "<p>最近重构一个项目，sol5.6 老降智商，防御性编码太多，设计出来的东西也要跟他掰扯很久才能如意</p>\n<h4>第一次</h4>\n<p>想想开个 Claude 试试，AppStore 付款，爽蹬一个下午，感觉还挺耐用，一个半小时差不多跑完了五小时限额的 80%。\n然后喜提 ON HOLD 。很快啊，写了解封邮件。calude 你不讲武德啊，我正儿八经搞项目呢，你给我封了是弄啥嘞。\n然后丝滑小连招，appleStore 同步申请退款。</p>\n<p>过了一天 apple 退款到账，第二天 calude 回复 remain ON HOLD 。不给我解封是吧，你等着</p>\n<h4>第二次</h4>\n<p>然后又注册了一个号\n这次做足准备，查了 calude 封号原因，ip 是很大一个因素，重金上车了美区 DMIT EB VPS 。号称家宽优化\n那顶的确实比第一次久一点，足足用了三天！不过我分析可能是头两天没怎么用，今天重度使用了一下，直接又 ON HOLD 了， 我淦霖娘啊 CLAUDE ！\n让 gpt 帮我写了解封申请，不过已经不抱什么希望了，就这样吧 bro 。</p>\n<h4>最后</h4>\n<p>折腾了一圈，用回了 GPT 、感觉也不是那么差嘛。\nclaude 不让用，咱也没必要上赶着给他送钱\n自此 openAI 又眉清目秀了起来\n一切又回到了原来的起点...</p>\n<p>(多写点 promote 就好啦</p>\n", "last_modified": 1787665424, "replies": 59, "id": 1237175}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/3cef/96dc/949_large.png?m=1730363795", "name": "nas", "avatar_normal": "https://cdn.v2ex.com/navatar/3cef/96dc/949_normal.png?m=1730363795", "title": "NAS", "url": "https://www.v2ex.com/go/nas", "topics": 3273, "footer": "", "header": "关于网络存储设备的讨论", "title_alternative": "NAS", "avatar_mini": "https://cdn.v2ex.com/navatar/3cef/96dc/949_mini.png?m=1730363795", "stars": 3091, "founder_id": 0, "aliases": [], "root": false, "id": 949, "parent_node_name": "hardware"}, "member": {"id": 284636, "username": "Flynn2018", "url": "https://www.v2ex.com/u/Flynn2018", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5ffd/8a93/284636_mini.png?m=1764376245", "avatar_normal": "https://cdn.v2ex.com/avatar/5ffd/8a93/284636_normal.png?m=1764376245", "avatar_large": "https://cdn.v2ex.com/avatar/5ffd/8a93/284636_large.png?m=1764376245", "created": 1516405071, "last_modified": 1764376245, "pro": 0}, "last_reply_by": "FabricPath", "last_touched": 1787710455, "title": "最适合小白的 NAS 系统就是 飞牛 fnOS", "url": "https://www.v2ex.com/t/1237048", "created": 1787637537, "deleted": 0, "content": "本小白在旧电脑上尝试安装了\r\n- truenas\r\n- OMV\r\n- 黑群晖\r\n- 飞牛\r\n- zimaOS\r\n- PVE （严格说不算 nas 系统）\r\n\r\n发现最适合小白的就是飞牛了，由于只有一个硬盘（ nvme ），安装完系统后，只有黑群晖和飞牛可以创建存储文件夹，其他的都无法直接创建。\r\n\r\n黑群晖还需要插上引导 U 盘才能进系统，只剩飞牛最简单了。", "content_rendered": "<p>本小白在旧电脑上尝试安装了</p>\n<ul>\n<li>truenas</li>\n<li>OMV</li>\n<li>黑群晖</li>\n<li>飞牛</li>\n<li>zimaOS</li>\n<li>PVE （严格说不算 nas 系统）</li>\n</ul>\n<p>发现最适合小白的就是飞牛了，由于只有一个硬盘（ nvme ），安装完系统后，只有黑群晖和飞牛可以创建存储文件夹，其他的都无法直接创建。</p>\n<p>黑群晖还需要插上引导 U 盘才能进系统，只剩飞牛最简单了。</p>\n", "last_modified": 1787637537, "replies": 54, "id": 1237048}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6353/8fe6/519_large.png?m=1595507885", "name": "ideas", "avatar_normal": "https://cdn.v2ex.com/navatar/6353/8fe6/519_normal.png?m=1595507885", "title": "奇思妙想", "url": "https://www.v2ex.com/go/ideas", "topics": 6597, "footer": "", "header": "让你的创意在这里自由流动吧。", "title_alternative": "Ideas", "avatar_mini": "https://cdn.v2ex.com/navatar/6353/8fe6/519_mini.png?m=1595507885", "stars": 3251, "founder_id": 0, "aliases": [], "root": false, "id": 519, "parent_node_name": "v2ex"}, "member": {"id": 325069, "username": "lzxz1234", "url": "https://www.v2ex.com/u/lzxz1234", "website": "https://lzxz1234.cn", "twitter": "", "psn": "", "github": "lzxz1234", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/02e5c2dc4519b3b3f21d678a01e3a73f?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/02e5c2dc4519b3b3f21d678a01e3a73f?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/02e5c2dc4519b3b3f21d678a01e3a73f?s=73&d=retro", "created": 1530086521, "last_modified": 1782953697, "pro": 0}, "last_reply_by": "dddd1919", "last_touched": 1787685421, "title": "开个脑洞，关于电车闲置算力", "url": "https://www.v2ex.com/t/1237004", "created": 1787627550, "deleted": 0, "content": "带智驾的电车算力是非常充裕的，而且每天真正开车的时间可能就几个小时，其它时间能否把算力共享出租出去卖 token\r\n\r\n电、网、算力都是现成的，不用多可惜", "content_rendered": "<p>带智驾的电车算力是非常充裕的，而且每天真正开车的时间可能就几个小时，其它时间能否把算力共享出租出去卖 token</p>\n<p>电、网、算力都是现成的，不用多可惜</p>\n", "last_modified": 1787627550, "replies": 45, "id": 1237004}]