[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_large.png?m=1784627111", "name": "atm", "avatar_normal": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_normal.png?m=1784627111", "title": "每日一🐢", "url": "https://www.v2ex.com/go/atm", "topics": 20, "footer": "", "header": "除非有实锤或者非常离谱的，否则都当真的看。\r\n不然天天这个假那个假的，还上啥网啊。", "title_alternative": "每日一🐢", "avatar_mini": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_mini.png?m=1784627111", "stars": 376, "founder_id": 415795, "aliases": [], "root": false, "id": 1234, "parent_node_name": null}, "member": {"id": 157791, "username": "dummyx", "url": "https://www.v2ex.com/u/dummyx", "website": "", "twitter": "", "psn": "", "github": "fengxsong", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/3afa/4784/157791_mini.png?m=1787649446", "avatar_normal": "https://cdn.v2ex.com/avatar/3afa/4784/157791_normal.png?m=1787649446", "avatar_large": "https://cdn.v2ex.com/avatar/3afa/4784/157791_large.png?m=1787649446", "avatar_xlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xlarge.png?m=1787649446", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xxlarge.png?m=1787649446", "created": 1454381089, "last_modified": 1787649446, "pro": 0}, "last_reply_by": "lsdvincent", "last_touched": 1787729663, "title": "说说离婚后的一些事", "url": "https://www.v2ex.com/t/1237123", "created": 1787649448, "deleted": 0, "content": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。\r\n\r\n协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。\r\n\r\n上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。\r\n\r\n感觉很无奈。", "content_rendered": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。<br /><br />协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。<br /><br />上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。<br /><br />感觉很无奈。", "last_modified": 1787649448, "replies": 144, "id": 1237123}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "avatar_normal": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_normal.png?m=1751736790", "title": "Claude", "url": "https://www.v2ex.com/go/claude", "topics": 882, "footer": "", "header": "", "title_alternative": "Claude", "avatar_mini": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_mini.png?m=1751736790", "stars": 699, "founder_id": 0, "aliases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 674540, "username": "creafTi", "url": "https://www.v2ex.com/u/creafTi", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_mini.png?m=1774410372", "avatar_normal": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_normal.png?m=1774410372", "avatar_large": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_large.png?m=1774410372", "avatar_xlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xlarge.png?m=1774410372", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xxlarge.png?m=1774410372", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xxxlarge.png?m=1774410372", "created": 1706862177, "last_modified": 1774410372, "pro": 0}, "last_reply_by": "waterlaw", "last_touched": 1787727725, "title": "Claude 是真是👍，四天被封俩号，不想折腾了", "url": "https://www.v2ex.com/t/1237175", "created": 1787665424, "deleted": 0, "content": "最近重构一个项目，sol5.6 老降智商，防御性编码太多，设计出来的东西也要跟他掰扯很久才能如意\r\n\r\n#### 第一次\r\n想想开个 Claude 试试，AppStore 付款，爽蹬一个下午，感觉还挺耐用，一个半小时差不多跑完了五小时限额的 80%。\r\n然后喜提 ON HOLD 。很快啊，写了解封邮件。calude 你不讲武德啊，我正儿八经搞项目呢，你给我封了是弄啥嘞。\r\n然后丝滑小连招，appleStore 同步申请退款。\r\n\r\n过了一天 apple 退款到账，第二天 calude 回复 remain ON HOLD 。不给我解封是吧，你等着\r\n\r\n#### 第二次\r\n然后又注册了一个号\r\n这次做足准备，查了 calude 封号原因，ip 是很大一个因素，重金上车了美区 DMIT EB VPS 。号称家宽优化\r\n那顶的确实比第一次久一点，足足用了三天！不过我分析可能是头两天没怎么用，今天重度使用了一下，直接又 ON HOLD 了， 我淦霖娘啊 CLAUDE ！\r\n让 gpt 帮我写了解封申请，不过已经不抱什么希望了，就这样吧 bro 。\r\n\r\n\r\n#### 最后\r\n折腾了一圈，用回了 GPT 、感觉也不是那么差嘛。\r\nclaude 不让用，咱也没必要上赶着给他送钱\r\n自此 openAI 又眉清目秀了起来\r\n一切又回到了原来的起点...\r\n\r\n(多写点 promote 就好啦", "content_rendered": "<p>最近重构一个项目，sol5.6 老降智商，防御性编码太多，设计出来的东西也要跟他掰扯很久才能如意</p>\n<h4>第一次</h4>\n<p>想想开个 Claude 试试，AppStore 付款，爽蹬一个下午，感觉还挺耐用，一个半小时差不多跑完了五小时限额的 80%。\n然后喜提 ON HOLD 。很快啊，写了解封邮件。calude 你不讲武德啊，我正儿八经搞项目呢，你给我封了是弄啥嘞。\n然后丝滑小连招，appleStore 同步申请退款。</p>\n<p>过了一天 apple 退款到账，第二天 calude 回复 remain ON HOLD 。不给我解封是吧，你等着</p>\n<h4>第二次</h4>\n<p>然后又注册了一个号\n这次做足准备，查了 calude 封号原因，ip 是很大一个因素，重金上车了美区 DMIT EB VPS 。号称家宽优化\n那顶的确实比第一次久一点，足足用了三天！不过我分析可能是头两天没怎么用，今天重度使用了一下，直接又 ON HOLD 了， 我淦霖娘啊 CLAUDE ！\n让 gpt 帮我写了解封申请，不过已经不抱什么希望了，就这样吧 bro 。</p>\n<h4>最后</h4>\n<p>折腾了一圈，用回了 GPT 、感觉也不是那么差嘛。\nclaude 不让用，咱也没必要上赶着给他送钱\n自此 openAI 又眉清目秀了起来\n一切又回到了原来的起点...</p>\n<p>(多写点 promote 就好啦</p>\n", "last_modified": 1787665424, "replies": 83, "id": 1237175}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24174, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3730, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_la