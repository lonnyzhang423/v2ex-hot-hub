[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241059, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4510, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 395473, "username": "hailaz", "url": "https://www.v2ex.com/u/hailaz", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/f81b/a768/395473_mini.png?m=1761878630", "avatar_normal": "https://cdn.v2ex.com/avatar/f81b/a768/395473_normal.png?m=1761878630", "avatar_large": "https://cdn.v2ex.com/avatar/f81b/a768/395473_large.png?m=1761878630", "avatar_xlarge": "https://cdn.v2ex.com/avatar/f81b/a768/395473_xlarge.png?m=1761878630", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/f81b/a768/395473_xxlarge.png?m=1761878630", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/f81b/a768/395473_xxxlarge.png?m=1761878630", "created": 1553592800, "last_modified": 1761878630, "pro": 0}, "last_reply_by": "bearqq", "last_touched": 1787690742, "title": "居然没人讨论玄戒 O3,不应该呀？", "url": "https://www.v2ex.com/t/1236977", "created": 1787624325, "deleted": 0, "content": "在 B 站看了几个 up 的视频，虽然是在开发版上测，但是真的强。", "content_rendered": "在 B 站看了几个 up 的视频，虽然是在开发版上测，但是真的强。", "last_modified": 1787624325, "replies": 172, "id": 1236977}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72948, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9765, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 221751, "username": "tht1286545749", "url": "https://www.v2ex.com/u/tht1286545749", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "前端 - 全栈 - agent - 项目管理", "avatar_mini": "https://cdn.v2ex.com/avatar/11a3/7af8/221751_mini.png?m=1785396673", "avatar_normal": "https://cdn.v2ex.com/avatar/11a3/7af8/221751_normal.png?m=1785396673", "avatar_large": "https://cdn.v2ex.com/avatar/11a3/7af8/221751_large.png?m=1785396673", "avatar_xlarge": "https://cdn.v2ex.com/avatar/11a3/7af8/221751_xlarge.png?m=1785396673", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/11a3/7af8/221751_xxlarge.png?m=1785396673", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/11a3/7af8/221751_xxxlarge.png?m=1785396673", "created": 1489848211, "last_modified": 1785396673, "pro": 0}, "last_reply_by": "QingXuJiaZhi", "last_touched": 1787704377, "title": "为什么机器人一定是“人”呢", "url": "https://www.v2ex.com/t/1236973", "created": 1787623700, "deleted": 0, "content": "我一直有个没太想明白的问题：为什么现在的机器人，尤其是所谓的“通用机器人”，都在大力往“人形”方向设计？\r\n\r\n人类真正厉害的，我觉得可能主要是“脑袋”——会思考、会学习、会判断、会适应环境。至于身体，其实并没有想象中那么优秀。\r\n\r\n比如，想让机器人跑得快，为什么一定要用两条腿？轮胎不是更高效吗？\r\n\r\n想让它拧螺丝，为什么还要设计一只机械手去拿螺丝刀？直接把手做成螺丝刀，不是更简单直接？\r\n\r\n如果目标真的是“什么都能干”，那为什么是两只手？三头六臂听起来反而更符合“通用”的逻辑把。", "content_rendered": "我一直有个没太想明白的问题：为什么现在的机器人，尤其是所谓的“通用机器人”，都在大力往“人形”方向设计？<br /><br />人类真正厉害的，我觉得可能主要是“脑袋”——会思考、会学习、会判断、会适应环境。至于身体，其实并没有想象中那么优秀。<br /><br />比如，想让机器人跑得快，为什么一定要用两条腿？轮胎不是更高效吗？<br /><br />想让它拧螺丝，为什么还要设计一只机械手去拿螺丝刀？直接把手做成螺丝刀，不是更简单直接？<br /><br />如果目标真的是“什么都能干”，那为什么是两只手？三头六臂听起来反而更符合“通用”的逻辑把。", "last_modified": 1787623700, "replies": 167, "id": 1236973}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11565, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2451, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 364493, "username": "rafa", "url": "https://www.v2ex.com/u/rafa", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=73&d=retro", "created": 1542711212, "last_modified": 1542711212, "pro": 0}, "last_reply_by": "a9k1n9", "last_touched": 1787679863, "title": "干了件蠢事，拿 WD-40 喷了刹车盘", "url": "https://www.v2ex.com/t/1237045", "created": 1787636270, "deleted": 0, "content": "起因：\r\n 100 块的 手机支架不能正常回弹了，遂去 pdd 买了一瓶 wd40 ，想着缓解下。\r\n 结果喷完后，我脑子立刻生了一个 idea ，我刹车的时候老是发出异响，让我很难受，所以我直接就喷上去了，前后都喷了。。。。。\r\n\r\n好了，刹车没了，下午去换了刹车片，还是不行，刹车效果很差，要换碟了", "content_rendered": "<p>起因：\n100 块的 手机支架不能正常回弹了，遂去 pdd 买了一瓶 wd40 ，想着缓解下。\n结果喷完后，我脑子立刻生了一个 idea ，我刹车的时候老是发出异响，让我很难受，所以我直接就喷上去了，前后都喷了。。。。。</p>\n<p>好了，刹车没了，下午去换了刹车片，还是不行，刹车效果很差，要换碟了</p>\n", "last_modified": 1787636270, "replies": 152, "id": 1237045}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 47037, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6345, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 287238, "username": "FaustinaD", "url": "https://www.v2ex.com/u/FaustinaD", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9f13/d763/287238_mini.png?m=1775805794", "avatar_normal": "https://cdn.v2ex.com/avatar/9f13/d763/287238_normal.png?m=1775805794", "avatar_large": "https://cdn.v2ex.com/avatar/9f13/d763/287238_large.png?m=1775805794", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xlarge.png?m=1775805794", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xxlarge.png?m=1775805794", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xxxlarge.png?m=1775805794", "created": 1517081618, "last_modified": 1775805794, "pro": 0}, "last_reply_by": "tsubasa2017", "last_touched": 1787680640, "title": "发现了最好的助眠药物", "url": "https://www.v2ex.com/t/1236961", "created": 1787622182, "deleted": 0, "content": "上周出差执行一周\r\n换床不适应+同事突发甲流+项目执行工作繁重+压力太大皮质醇爆表\r\n每日平均睡眠低至 4-5 小时\r\n每天 2-3 杯咖啡顶着才不至于崩溃\r\n\r\n周五执行结束，周五和周六晚上依然是 4 小时睡眠\r\n人都快疯了\r\n\r\n周日突发荨麻疹，无奈之下吃了一颗盐酸左西替利嗪\r\n好嘛，直接开启嗜睡模式\r\n周日中午 11 点半吃上药\r\n下午一直在景点之间骑车，当时还没啥感觉\r\n最后一个景点逛完，吃了顿钵钵鸡打车回酒店\r\n从上了网约车，就开启了睡眠模式\r\n钵钵鸡到酒店，睡了 20 分钟\r\n酒店到机场睡了一路，70 分钟\r\n机场候机，坐下就睡，又睡了 40 分钟，差点错过登机\r\n上了飞机坐下又开始睡，飞了 150 分钟，中间就清醒了 10 分钟吃了个飞机餐\r\n下了飞机从机场回家的路上又睡一个小时\r\n到了家洗完澡 11 点多，倒头就睡，一觉睡到早上 6 点半我老公离家\r\n6 点 45 又续上，睡到 8 点闹铃响，又按掉闹铃再续 10 分钟\r\n\r\n让 AI 帮我算了算，吃上药到早上起床的这段时间\r\n总共睡了 14 个小时+\r\n这可比我平时撸完铁吃的什么褪黑素 南非醉茄 谷氨酸镁都管用多了……\r\n\r\n以后再不敢工作白天吃西替利嗪了(￣▽￣\")", "content_rendered": "上周出差执行一周<br />换床不适应+同事突发甲流+项目执行工作繁重+压力太大皮质醇爆表<br />每日平均睡眠低至 4-5 小时<br />每天 2-3 杯咖啡顶着才不至于崩溃<br /><br />周五执行结束，周五和周六晚上依然是 4 小时睡眠<br />人都快疯了<br /><br />周日突发荨麻疹，无奈之下吃了一颗盐酸左西替利嗪<br />好嘛，直接开启嗜睡模式<br />周日中午 11 点半吃上药<br />下午一直在景点之间骑车，当时还没啥感觉<br />最后一个景点逛完，吃了顿钵钵鸡打车回酒店<br />从上了网约车，就开启了睡眠模式<br />钵钵鸡到酒店，睡了 20 分钟<br />酒店到机场睡了一路，70 分钟<br />机场候机，坐下就睡，又睡了 40 分钟，差点错过登机<br />上了飞机坐下又开始睡，飞了 150 分钟，中间就清醒了 10 分钟吃了个飞机餐<br />下了飞机从机场回家的路上又睡一个小时<br />到了家洗完澡 11 点多，倒头就睡，一觉睡到早上 6 点半我老公离家<br />6 点 45 又续上，睡到 8 点闹铃响，又按掉闹铃再续 10 分钟<br /><br />让 AI 帮我算了算，吃上药到早上起床的这段时间<br />总共睡了 14 个小时+<br />这可比我平时撸完铁吃的什么褪黑素 南非醉茄 谷氨酸镁都管用多了……<br /><br />以后再不敢工作白天吃西替利嗪了(￣▽￣\")", "last_modified": 1787622182, "replies": 112, "id": 1236961}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24163, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3729, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 553579, "username": "lueluev", "url": "https://www.v2ex.com/u/lueluev", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/c47b/dc0c/553579_mini.png?m=1648629927", "avatar_normal": "https://cdn.v2ex.com/avatar/c47b/dc0c/553579_normal.png?m=1648629927", "avatar_large": "https://cdn.v2ex.com/avatar/c47b/dc0c/553579_large.png?m=1648629927", "avatar_xlarge": "https://cdn.v2ex.com/avatar/c47b/dc0c/553579_xlarge.png?m=1648629927", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/c47b/dc0c/553579_xxlarge.png?m=1648629927", "created": 1629170639, "last_modified": 1648629927, "pro": 0}, "last_reply_by": "lidedongsn", "last_touched": 1787678133, "title": "不干程序员后干啥", "url": "https://www.v2ex.com/t/1236970", "created": 1787623019, "deleted": 0, "content": "也干了几年程序员了，干得比较平庸混口饭吃。现在一方面感觉形势在收缩岗位越来越少裁员越来越多，失业也是早晚的事；另一方面还在招聘的岗位也没啥信心能拿下。要是真不干程序员了，一时还真想不到有啥能干的（除了送外卖跑滴滴）。\r\n\r\n\r\n都说趁早改行，改行干啥呢，各位佬有啥思路吗。", "content_rendered": "<p>也干了几年程序员了，干得比较平庸混口饭吃。现在一方面感觉形势在收缩岗位越来越少裁员越来越多，失业也是早晚的事；另一方面还在招聘的岗位也没啥信心能拿下。要是真不干程序员了，一时还真想不到有啥能干的（除了送外卖跑滴滴）。</p>\n<p>都说趁早改行，改行干啥呢，各位佬有啥思路吗。</p>\n", "last_modified": 1787623512, "replies": 107, "id": 1236970}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/55b3/7c5c/649_large.png?m=1651386010", "name": "wechat", "avatar_normal": "https://cdn.v2ex.com/navatar/55b3/7c5c/649_normal.png?m=1651386010", "title": "微信", "url": "https://www.v2ex.com/go/wechat", "topics": 4461, "footer": "", "header": "关于微信及微信小程序的讨论节点", "title_alternative": "WeChat", "avatar_mini": "https://cdn.v2ex.com/navatar/55b3/7c5c/649_mini.png?m=1651386010", "stars": 824, "founder_id": 0, "aliases": [], "root": false, "id": 649, "parent_node_name": "internet"}, "member": {"id": 32412, "username": "mephisto", "url": "https://www.v2ex.com/u/mephisto", "website": "https://mephisto.cc", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/efc7/802a/32412_mini.png?m=1787622304", "avatar_normal": "https://cdn.v2ex.com/avatar/efc7/802a/32412_normal.png?m=1787622304", "avatar_large": "https://cdn.v2ex.com/avatar/efc7/802a/32412_large.png?m=1787622304", "avatar_xlarge": "https://cdn.v2ex.com/avatar/efc7/802a/32412_xlarge.png?m=1787622304", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/efc7/802a/32412_xxlarge.png?m=1787622304", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/efc7/802a/32412_xxxlarge.png?m=1787622304", "created": 1358299223, "last_modified": 1787622304, "pro": 0}, "last_reply_by": "mephisto", "last_touched": 1787676526, "title": "网络义父们，微信小程序用户上传图片一般怎么控制成本的？", "url": "https://www.v2ex.com/t/1236964", "created": 1787622408, "deleted": 0, "content": "各位大佬，前些天我业余做的个人小程序 ![恋恋双人记] https://postimg.cc/0b3PBRF2\r\n\r\n陆续来了一些自然用户，它真的有人在用了！目前除了自己外，有十几对人，按小程序官方算累计用户有 230 多个。\r\n\r\n早上有用户通过客服留言联系到我，希望其中一个模块添加图片上传功能，可是该小程序目前还是还未盈利倒贴钱的状态，用户多了的话，根本无力负担额外存储成本。\r\n\r\n如何在不增加成本的情况下，让用户能有限度的上传少量图片？现在好下不容易来了点真实用户，不想让别人失望啊。\r\n\r\n对象存储、微信云存储的免费额度都很少，超了都需要额外付钱。", "content_rendered": "<p>各位大佬，前些天我业余做的个人小程序 ![恋恋双人记] <a href=\"https://postimg.cc/0b3PBRF2\" rel=\"nofollow\">https://postimg.cc/0b3PBRF2</a></p>\n<p>陆续来了一些自然用户，它真的有人在用了！目前除了自己外，有十几对人，按小程序官方算累计用户有 230 多个。</p>\n<p>早上有用户通过客服留言联系到我，希望其中一个模块添加图片上传功能，可是该小程序目前还是还未盈利倒贴钱的状态，用户多了的话，根本无力负担额外存储成本。</p>\n<p>如何在不增加成本的情况下，让用户能有限度的上传少量图片？现在好下不容易来了点真实用户，不想让别人失望啊。</p>\n<p>对象存储、微信云存储的免费额度都很少，超了都需要额外付钱。</p>\n", "last_modified": 1787622408, "replies": 82, "id": 1236964}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_large.png?m=1784627111", "name": "atm", "avatar_normal": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_normal.png?m=1784627111", "title": "每日一🐢", "url": "https://www.v2ex.com/go/atm", "topics": 20, "footer": "", "header": "除非有实锤或者非常离谱的，否则都当真的看。\r\n不然天天这个假那个假的，还上啥网啊。", "title_alternative": "每日一🐢", "avatar_mini": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_mini.png?m=1784627111", "stars": 370, "founder_id": 415795, "aliases": [], "root": false, "id": 1234, "parent_node_name": null}, "member": {"id": 157791, "username": "dummyx", "url": "https://www.v2ex.com/u/dummyx", "website": "", "twitter": "", "psn": "", "github": "fengxsong", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/3afa/4784/157791_mini.png?m=1787649446", "avatar_normal": "https://cdn.v2ex.com/avatar/3afa/4784/157791_normal.png?m=1787649446", "avatar_large": "https://cdn.v2ex.com/avatar/3afa/4784/157791_large.png?m=1787649446", "avatar_xlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xlarge.png?m=1787649446", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xxlarge.png?m=1787649446", "created": 1454381089, "last_modified": 1787649446, "pro": 0}, "last_reply_by": "tuobatian", "last_touched": 1787704274, "title": "说说离婚后的一些事", "url": "https://www.v2ex.com/t/1237123", "created": 1787649448, "deleted": 0, "content": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。\r\n\r\n协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。\r\n\r\n上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。\r\n\r\n感觉很无奈。", "content_rendered": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。<br /><br />协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。<br /><br />上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。<br /><br />感觉很无奈。", "last_modified": 1787649448, "replies": 64, "id": 1237123}]