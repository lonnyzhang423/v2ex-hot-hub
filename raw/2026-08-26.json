[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11571, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2452, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 364493, "username": "rafa", "url": "https://www.v2ex.com/u/rafa", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/ede8c6d4208ed440078a0917bc6d0649?s=73&d=retro", "created": 1542711212, "last_modified": 1542711212, "pro": 0}, "last_reply_by": "crackdawnm", "last_touched": 1787714480, "title": "干了件蠢事，拿 WD-40 喷了刹车盘", "url": "https://www.v2ex.com/t/1237045", "created": 1787636270, "deleted": 0, "content": "起因：\r\n 100 块的 手机支架不能正常回弹了，遂去 pdd 买了一瓶 wd40 ，想着缓解下。\r\n 结果喷完后，我脑子立刻生了一个 idea ，我刹车的时候老是发出异响，让我很难受，所以我直接就喷上去了，前后都喷了。。。。。\r\n\r\n好了，刹车没了，下午去换了刹车片，还是不行，刹车效果很差，要换碟了", "content_rendered": "<p>起因：\n100 块的 手机支架不能正常回弹了，遂去 pdd 买了一瓶 wd40 ，想着缓解下。\n结果喷完后，我脑子立刻生了一个 idea ，我刹车的时候老是发出异响，让我很难受，所以我直接就喷上去了，前后都喷了。。。。。</p>\n<p>好了，刹车没了，下午去换了刹车片，还是不行，刹车效果很差，要换碟了</p>\n", "last_modified": 1787636270, "replies": 171, "id": 1237045}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_large.png?m=1784627111", "name": "atm", "avatar_normal": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_normal.png?m=1784627111", "title": "每日一🐢", "url": "https://www.v2ex.com/go/atm", "topics": 20, "footer": "", "header": "除非有实锤或者非常离谱的，否则都当真的看。\r\n不然天天这个假那个假的，还上啥网啊。", "title_alternative": "每日一🐢", "avatar_mini": "https://cdn.v2ex.com/navatar/81dc/9bdb/1234_mini.png?m=1784627111", "stars": 375, "founder_id": 415795, "aliases": [], "root": false, "id": 1234, "parent_node_name": null}, "member": {"id": 157791, "username": "dummyx", "url": "https://www.v2ex.com/u/dummyx", "website": "", "twitter": "", "psn": "", "github": "fengxsong", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/3afa/4784/157791_mini.png?m=1787649446", "avatar_normal": "https://cdn.v2ex.com/avatar/3afa/4784/157791_normal.png?m=1787649446", "avatar_large": "https://cdn.v2ex.com/avatar/3afa/4784/157791_large.png?m=1787649446", "avatar_xlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xlarge.png?m=1787649446", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/3afa/4784/157791_xxlarge.png?m=1787649446", "created": 1454381089, "last_modified": 1787649446, "pro": 0}, "last_reply_by": "xiangbohua", "last_touched": 1787714809, "title": "说说离婚后的一些事", "url": "https://www.v2ex.com/t/1237123", "created": 1787649448, "deleted": 0, "content": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。\r\n\r\n协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。\r\n\r\n上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。\r\n\r\n感觉很无奈。", "content_rendered": "24 年中闹离婚，25 年 5 月第一次离婚庭审，26 年 1 月二审协议离婚。<br /><br />协议结果就是孩子归女方，每月 3000 抚养费，到 18 岁，每周六下午到周日晚 6 点我都可以带娃回自己家；婚前自己买的房亏了挺多，但是还是要按照不打折的婚内还款补偿一半给女方，20 万左右；婚内转给女方的钱不再追溯； 23 年女方父母出大头买的车补偿我 5 万。<br /><br />上周五收到法院传票，女方母亲起诉我跟女方要偿还她转给女方 23 万的购车款，不太明白在自己有钱有支付能力的前提下为何要写了张借 23 万的借条（女方母亲的确出示了 23 万的转账记录，而车款都不用 23 万），还是在离婚的时候才出示的借条。<br /><br />感觉很无奈。", "last_modified": 1787649448, "replies": 128, "id": 1237123}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "avatar_normal": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_normal.png?m=1751736790", "title": "Claude", "url": "https://www.v2ex.com/go/claude", "topics": 880, "footer": "", "header": "", "title_alternative": "Claude", "avatar_mini": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_mini.png?m=1751736790", "stars": 699, "founder_id": 0, "aliases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 674540, "username": "creafTi", "url": "https://www.v2ex.com/u/creafTi", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_mini.png?m=1774410372", "avatar_normal": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_normal.png?m=1774410372", "avatar_large": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_large.png?m=1774410372", "avatar_xlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xlarge.png?m=1774410372", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xxlarge.png?m=1774410372", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/c7b2/de40/674540_xxxlarge.png?m=1774410372", "created": 1706862177, "last_modified": 1774410372, "pro": 0}, "last_reply_by": "meetxie", "last_touched": 1787715570, "title": "Claude 是真是👍，四天被封俩号，不想折腾了", "url": "https://www.v2ex.com/t/1237175", "created": 1787665424, "deleted": 0, "content": "最近重构一个项目，sol5.6 老降智商，防御性编码太多，设计出来的东西也要跟他掰扯很久才能如意\r\n\r\n#### 第一次\r\n想想开个 Claude 试试，AppStore 付款，爽蹬一个下午，感觉还挺耐用，一个半小时差不多跑完了五小时限额的 80%。\r\n然后喜提 ON HOLD 。很快啊，写了解封邮件。calude 你不讲武德啊，我正儿八经搞项目呢，你给我封了是弄啥嘞。\r\n然后丝滑小连招，appleStore 同步申请退款。\r\n\r\n过了一天 apple 退款到账，第二天 calude 回复 remain ON HOLD 。不给我解封是吧，你等着\r\n\r\n#### 第二次\r\n然后又注册了一个号\r\n这次做足准备，查了 calude 封号原因，ip 是很大一个因素，重金上车了美区 DMIT EB VPS 。号称家宽优化\r\n那顶的确实比第一次久一点，足足用了三天！不过我分析可能是头两天没怎么用，今天重度使用了一下，直接又 ON HOLD 了， 我淦霖娘啊 CLAUDE ！\r\n让 gpt 帮我写了解封申请，不过已经不抱什么希望了，就这样吧 bro 。\r\n\r\n\r\n#### 最后\r\n折腾了一圈，用回了 GPT 、感觉也不是那么差嘛。\r\nclaude 不让用，咱也没必要上赶着给他送钱\r\n自此 openAI 又眉清目秀了起来\r\n一切又回到了原来的起点...\r\n\r\n(多写点 promote 就好啦", "content_rendered": "<p>最近重构一个项目，sol5.6 老降智商，防御性编码太多，设计出来的东西也要跟他掰扯很久才能如意</p>\n<h4>第一次</h4>\n<p>想想开个 Claude 试试，AppStore 付款，爽蹬一个下午，感觉还挺耐用，一个半小时差不多跑完了五小时限额的 80%。\n然后喜提 ON HOLD 。很快啊，写了解封邮件。calude 你不讲武德啊，我正儿八经搞项目呢，你给我封了是弄啥嘞。\n然后丝滑小连招，appleStore 同步申请退款。</p>\n<p>过了一天 apple 退款到账，第二天 calude 回复 remain ON HOLD 。不给我解封是吧，你等着</p>\n<h4>第二次</h4>\n<p>然后又注册了一个号\n这次做足准备，查了 calude 封号原因，ip 是很大一个因素，重金上车了美区 DMIT EB VPS 。号称家宽优化\n那顶的确实比第一次久一点，足足用了三天！不过我分析可能是头两天没怎么用，今天重度使用了一下，直接又 ON HOLD 了， 我淦霖娘啊 CLAUDE ！\n让 gpt 帮我写了解封申请，不过已经不抱什么希望了，就这样吧 bro 。</p>\n<h4>最后</h4>\n<p>折腾了一圈，用回了 GPT 、感觉也不是那么差嘛。\nclaude 不让用，咱也没必要上赶着给他送钱\n自此 openAI 又眉清目秀了起来\n一切又回到了原来的起点...</p>\n<p>(多写点 promote 就好啦</p>\n", "last_modified": 1787665424, "replies": 71, "id": 1237175}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241067, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4510, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 777887, "username": "KingW777", "url": "https://www.v2ex.com/u/KingW777", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_mini.png?m=1765501354", "avatar_normal": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_normal.png?m=1765501354", "avatar_large": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_large.png?m=1765501354", "avatar_xlarge": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_xlarge.png?m=1765501354", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/e1db/dddc/777887_xxlarge.png?m=1765501354", "created": 1765500480, "last_modified": 1765501354, "pro": 0}, "last_reply_by": "Zaden", "last_touched": 1787714318, "title": "绿米指纹锁阵亡，建议换哪个牌子靠谱？", "url": "https://www.v2ex.com/t/1237038", "created": 1787633900, "deleted": 0, "content": "绿米当年的团队已经解散，微信联系了当时安装的师傅，建议我直接换新（但不建议再买绿米）。京东看下来销量高的也就德施曼和凯迪仕牌子销量大一些，价格还都不高。\r\n这两个名字听起来有点混血基因的指纹锁功能繁杂，应该选德施曼还是凯迪仕？有踩过坑的同学吗？", "content_rendered": "<p>绿米当年的团队已经解散，微信联系了当时安装的师傅，建议我直接换新（但不建议再买绿米）。京东看下来销量高的也就德施曼和凯迪仕牌子销量大一些，价格还都不高。\n这两个名字听起来有点混血基因的指纹锁功能繁杂，应该选德施曼还是凯迪仕？有踩过坑的同学吗？</p>\n", "last_modified": 1787633930, "replies": 65, "id": 1237038}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24172, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3730, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_large": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_large.png?m=1691393963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xlarge.png?m=1691393963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxlarge.png?m=1691393963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxxlarge.png?m=1691393963", "created": 1663333667, "last_modified": 1691393963, "pro": 0}, "last_reply_by": "jsonparse", "last_touched": 1787715113, "title": "同事好臭，我好想被香香的人包围。", "url": "https://www.v2ex.com/t/1237128", "created": 1787650065, "deleted": 0, "content": "旁边的同事有脚臭，斜对面的不洗澡，对面的有口臭，还老是站起来冲着我说话。  每次我都暗自屏住呼吸强颜欢笑和他说话。唉。  我也好想和那些女同事坐一起，起码不用受这些人的摧残。\r\n\r\n这么热的天，为什么有人不洗澡不刷牙啊....", "content_rendered": "<p>旁边的同事有脚臭，斜对面的不洗澡，对面的有口臭，还老是站起来冲着我说话。  每次我都暗自屏住呼吸强颜欢笑和他说话。唉。  我也好想和那些女同事坐一起，起码不用受这些人的摧残。</p>\n<p>这么热的天，为什么有人不洗澡不刷牙啊....</p>\n", "last_modified": 1787706558, "replies": 61, "id": 1237128}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/3cef/96dc/949_large.png?m=1730363795", "name": "nas", "avatar_normal": "https://cdn.v2ex.com/navatar/3cef/96dc/949_normal.png?m=1730363795", "title": "NAS", "url": "https://www.v2ex.com/go/nas", "topics": 3273, "footer": "", "header": "关于网络存储设备的讨论", "title_alternative": "NAS", "avatar_mini": "https://cdn.v2ex.com/navatar/3cef/96dc/949_mini.png?m=1730363795", "stars": 3092, "founder_id": 0, "aliases": [], "root": false, "id": 949, "parent_node_name": "hardware"}, "member": {"id": 284636, "username": "Flynn2018", "url": "https://www.v2ex.com/u/Flynn2018", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5ffd/8a93/284636_mini.png?m=1764376245", "avatar_normal": "https://cdn.v2ex.com/avatar/5ffd/8a93/284636_normal.png?m=1764376245", "avatar_large": "https://cdn.v2ex.com/avatar/5ffd/8a93/284636_large.png?m=1764376245", "created": 1516405071, "last_modified": 1764376245, "pro": 0}, "last_reply_by": "Baooz", "last_touched": 1787713876, "title": "最适合小白的 NAS 系统就是 飞牛 fnOS", "url": "https://www.v2ex.com/t/1237048", "created": 1787637537, "deleted": 0, "content": "本小白在旧电脑上尝试安装了\r\n- truenas\r\n- OMV\r\n- 黑群晖\r\n- 飞牛\r\n- zimaOS\r\n- PVE （严格说不算 nas 系统）\r\n\r\n发现最适合小白的就是飞牛了，由于只有一个硬盘（ nvme ），安装完系统后，只有黑群晖和飞牛可以创建存储文件夹，其他的都无法直接创建。\r\n\r\n黑群晖还需要插上引导 U 盘才能进系统，只剩飞牛最简单了。", "content_rendered": "<p>本小白在旧电脑上尝试安装了</p>\n<ul>\n<li>truenas</li>\n<li>OMV</li>\n<li>黑群晖</li>\n<li>飞牛</li>\n<li>zimaOS</li>\n<li>PVE （严格说不算 nas 系统）</li>\n</ul>\n<p>发现最适合小白的就是飞牛了，由于只有一个硬盘（ nvme ），安装完系统后，只有黑群晖和飞牛可以创建存储文件夹，其他的都无法直接创建。</p>\n<p>黑群晖还需要插上引导 U 盘才能进系统，只剩飞牛最简单了。</p>\n", "last_modified": 1787637537, "replies": 57, "id": 1237048}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11571, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2452, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 567860, "username": "metavacuum", "url": "https://www.v2ex.com/u/metavacuum", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/0e42/8eae/567860_mini.png?m=1655337811", "avatar_normal": "https://cdn.v2ex.com/avatar/0e42/8eae/567860_normal.png?m=1655337811", "avatar_large": "https://cdn.v2ex.com/avatar/0e42/8eae/567860_large.png?m=1655337811", "avatar_xlarge": "https://cdn.v2ex.com/avatar/0e42/8eae/567860_xlarge.png?m=1655337811", "created": 1641261485, "last_modified": 1655337811, "pro": 0}, "last_reply_by": "bitlaoyuan", "last_touched": 1787691527, "title": "老哥借贷炒股，亏了至少十几万", "url": "https://www.v2ex.com/t/1237025", "created": 1787630328, "deleted": 0, "content": "他之前工作大概是卖保险，人脉消耗完之后进了非法集资的公司（拍电影融资，也是想转快钱），蹲了一个月的橘子，\r\n出来之后有案底工作不好找，然后送快递把脚趾头摔骨折了，现在找了个类似保安的工作，月薪 3k\r\n四十来岁的人了，三个娃快 10 岁了\r\n老婆比他年轻几岁，因为三个娃年纪较近，小的时候还全职带娃了几年，后面重新找了个工作\r\n现在情况是他老婆收入比他高，他老婆带娃还比他多\r\n他自己却处处不如意，上次他借贷炒股的时候亏钱了我还支持他 5k 了，这次又亏，其他亲戚朋友也支持过他\r\n现在老婆甚至要闹离婚\r\n\r\n中年男人，没有资源没有事业，想赚快钱，赚了自己的，亏了窟窿家人填\r\n\r\n我爸妈说已经给他做过好多次心理工作了让他脚踏实地，身为老弟对此很无奈，但已经不想给经济上的支持了，我也刚失业一个月", "content_rendered": "他之前工作大概是卖保险，人脉消耗完之后进了非法集资的公司（拍电影融资，也是想转快钱），蹲了一个月的橘子，<br />出来之后有案底工作不好找，然后送快递把脚趾头摔骨折了，现在找了个类似保安的工作，月薪 3k<br />四十来岁的人了，三个娃快 10 岁了<br />老婆比他年轻几岁，因为三个娃年纪较近，小的时候还全职带娃了几年，后面重新找了个工作<br />现在情况是他老婆收入比他高，他老婆带娃还比他多<br />他自己却处处不如意，上次他借贷炒股的时候亏钱了我还支持他 5k 了，这次又亏，其他亲戚朋友也支持过他<br />现在老婆甚至要闹离婚<br /><br />中年男人，没有资源没有事业，想赚快钱，赚了自己的，亏了窟窿家人填<br /><br />我爸妈说已经给他做过好多次心理工作了让他脚踏实地，身为老弟对此很无奈，但已经不想给经济上的支持了，我也刚失业一个月", "last_modified": 1787630328, "replies": 50, "id": 1237025}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/735b/90b4/67_large.png?m=1706750053", "name": "taste", "avatar_normal": "https://cdn.v2ex.com/navatar/735b/90b4/67_normal.png?m=1706750053", "title": "美酒与美食", "url": "https://www.v2ex.com/go/taste", "topics": 883, "footer": "", "header": "关于那些好喝和好吃的", "title_alternative": "Taste", "avatar_mini": "https://cdn.v2ex.com/navatar/735b/90b4/67_mini.png?m=1706750053", "stars": 852, "founder_id": 0, "aliases": [], "root": false, "id": 67, "parent_node_name": "life"}, "member": {"id": 708439, "username": "EasonIndie", "url": "https://www.v2ex.com/u/EasonIndie", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/6243/806b/708439_mini.png?m=1784247968", "avatar_normal": "https://cdn.v2ex.com/avatar/6243/806b/708439_normal.png?m=1784247968", "avatar_large": "https://cdn.v2ex.com/avatar/6243/806b/708439_large.png?m=1784247968", "avatar_xlarge": "https://cdn.v2ex.com/avatar/6243/806b/708439_xlarge.png?m=1784247968", "created": 1725013275, "last_modified": 1784247968, "pro": 0}, "last_reply_by": "jaytang", "last_touched": 1787715512, "title": "咬牙下单了个茶，昨天晚上喝了一下真好喝啊，之前喝的都是啥玩意啊", "url": "https://www.v2ex.com/t/1237223", "created": 1787704768, "deleted": 0, "content": "价格 65 块 50g ，我之前都是和 65 150g 的，没想到提升一下预算差别这么明显\r\n茶叶 叶叶分明\r\n风味 跟说明的风味描述一直，荔枝风味很明显\r\n如果不是加了乱七八糟的调味，以后就加入口粮茶了\r\n\r\n在工位我喝猴王茉莉花茶量大管饱，家里用二才杯喝这个心情愉悦", "content_rendered": "<p>价格 65 块 50g ，我之前都是和 65 150g 的，没想到提升一下预算差别这么明显\n茶叶 叶叶分明\n风味 跟说明的风味描述一直，荔枝风味很明显\n如果不是加了乱七八糟的调味，以后就加入口粮茶了</p>\n<p>在工位我喝猴王茉莉花茶量大管饱，家里用二才杯喝这个心情愉悦</p>\n", "last_modified": 1787704768, "replies": 48, "id": 1237223}]