[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73018, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9768, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 427671, "username": "jedeft", "url": "https://www.v2ex.com/u/jedeft", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/32c4cbaf6d15745f0c2582540a7038b7?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/32c4cbaf6d15745f0c2582540a7038b7?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/32c4cbaf6d15745f0c2582540a7038b7?s=73&d=retro", "created": 1562548715, "last_modified": 1785919990, "pro": 0}, "last_reply_by": "winnerczwx", "last_touched": 1788068424, "title": "AI 时代，软件已经不值钱了", "url": "https://www.v2ex.com/t/1238096", "created": 1788018824, "deleted": 0, "content": "纯软件很难建立起优势了，包括个人和企业", "content_rendered": "<p>纯软件很难建立起优势了，包括个人和企业</p>\n", "last_modified": 1788018824, "replies": 43, "id": 1238096}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24201, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3731, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 276277, "username": "chniccs", "url": "https://www.v2ex.com/u/chniccs", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/62031a8745e8929e0be3dd99908a97cf?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/62031a8745e8929e0be3dd99908a97cf?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/62031a8745e8929e0be3dd99908a97cf?s=73&d=retro", "created": 1513927680, "last_modified": 1703469299, "pro": 0}, "last_reply_by": "wobuchiyu", "last_touched": 1788034144, "title": "所有程序员都用 AI 的话，那以后怎么判断能力的高低？", "url": "https://www.v2ex.com/t/1238034", "created": 1787987608, "deleted": 0, "content": "面试的时候还会问八股文吗？是不是更看重学历背景了？性格好，擅于言辞的人是不是更容易面试成功？", "content_rendered": "面试的时候还会问八股文吗？是不是更看重学历背景了？性格好，擅于言辞的人是不是更容易面试成功？", "last_modified": 1788053993, "replies": 32, "id": 1238034}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a4f2/3670/260_large.png?m=1778555478", "name": "security", "avatar_normal": "https://cdn.v2ex.com/navatar/a4f2/3670/260_normal.png?m=1778555478", "title": "信息安全", "url": "https://www.v2ex.com/go/security", "topics": 2073, "footer": "", "header": "我们都希望自己管理的计算机系统在运转过程中不要遇到任何安全事件。只是，这个不完美的世界的现实告诉我们：学无止境。", "title_alternative": "Security", "avatar_mini": "https://cdn.v2ex.com/navatar/a4f2/3670/260_mini.png?m=1778555478", "stars": 2190, "founder_id": 0, "aliases": [], "root": false, "id": 260, "parent_node_name": "geek"}, "member": {"id": 657037, "username": "loveshuyuan", "url": "https://www.v2ex.com/u/loveshuyuan", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/5748ab1470d85aeb96409817a0ab421a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/5748ab1470d85aeb96409817a0ab421a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/5748ab1470d85aeb96409817a0ab421a?s=73&d=retro", "created": 1698669994, "last_modified": 1726033181, "pro": 0}, "last_reply_by": "aaronysj", "last_touched": 1788069079, "title": "我的网站被入侵了，损失了几千块", "url": "https://www.v2ex.com/t/1238129", "created": 1788060575, "deleted": 0, "content": "经过排查，攻击者通过管理员的 apikey 通过接口更改了余额然后进行提现。比起损失，我更想知道 apikey 怎么被泄露的，但是我永远也不会知道了。", "content_rendered": "<p>经过排查，攻击者通过管理员的 apikey 通过接口更改了余额然后进行提现。比起损失，我更想知道 apikey 怎么被泄露的，但是我永远也不会知道了。</p>\n", "last_modified": 1788061023, "replies": 28, "id": 1238129}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73018, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9768, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 71832, "username": "xinghelee", "url": "https://www.v2ex.com/u/xinghelee", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/7e6d/6496/71832_mini.png?m=1788007756", "avatar_normal": "https://cdn.v2ex.com/avatar/7e6d/6496/71832_normal.png?m=1788007756", "avatar_large": "https://cdn.v2ex.com/avatar/7e6d/6496/71832_large.png?m=1788007756", "created": 1408869990, "last_modified": 1788007756, "pro": 0}, "last_reply_by": "rb6221", "last_touched": 1788030387, "title": "免费，开源， V2EX Android 客户端首个正式版本， Kotlin + Jetpack Compose 构建。", "url": "https://www.v2ex.com/t/1238073", "created": 1788008077, "deleted": 0, "content": "在被苹果审核教育一番之后以及 V 友的邀请之下做了安卓版本\r\n\r\n1. Kotlin + Jetpack Compose 全原生构建\r\n2. 凭据加密存储（ Android Keystore + EncryptedSharedPreferences ）\r\n3. 支持折叠屏，内外屏无缝切换\r\n4. 站内完成全部互动 —— 回复、发帖、收藏，@ 补全、通知直达\r\n5. 分享为卡片 —— 一键生成带二维码的话题图片卡\r\n\r\n\r\nGitHub：[https://github.com/xinghelee/v2ex-android]( https://github.com/xinghelee/v2ex-android)\r\n\r\n![]( https://i.v2ex.co/Ouuht1Um.png)\r\n\r\n\r\nGitHub：[https://github.com/xinghelee/v2ex-android]( https://github.com/xinghelee/v2ex-android)", "content_rendered": "<p>在被苹果审核教育一番之后以及 V 友的邀请之下做了安卓版本</p>\n<ol>\n<li>Kotlin + Jetpack Compose 全原生构建</li>\n<li>凭据加密存储（ Android Keystore + EncryptedSharedPreferences ）</li>\n<li>支持折叠屏，内外屏无缝切换</li>\n<li>站内完成全部互动 —— 回复、发帖、收藏，@ 补全、通知直达</li>\n<li>分享为卡片 —— 一键生成带二维码的话题图片卡</li>\n</ol>\n<p>GitHub：<a href=\"https://github.com/xinghelee/v2ex-android\" rel=\"nofollow\">https://github.com/xinghelee/v2ex-android</a></p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.v2ex.co/Ouuht1Um.png\"/></p>\n<p>GitHub：<a href=\"https://github.com/xinghelee/v2ex-android\" rel=\"nofollow\">https://github.com/xinghelee/v2ex-android</a></p>\n", "last_modified": 1788008077, "replies": 25, "id": 1238073}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73018, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9768, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 636100, "username": "liupeiqiang", "url": "https://www.v2ex.com/u/liupeiqiang", "website": null, "twitter": "", "psn": "", "github": "0xlau", "btc": "", "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/e180/5805/636100_mini.png?m=1788021364", "avatar_normal": "https://cdn.v2ex.com/avatar/e180/5805/636100_normal.png?m=1788021364", "avatar_large": "https://cdn.v2ex.com/avatar/e180/5805/636100_large.png?m=1788021364", "avatar_xlarge": "https://cdn.v2ex.com/avatar/e180/5805/636100_xlarge.png?m=1788021364", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/e180/5805/636100_xxlarge.png?m=1788021364", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/e180/5805/636100_xxxlarge.png?m=1788021364", "created": 1687855568, "last_modified": 1788021364, "pro": 0}, "last_reply_by": "aaronysj", "last_touched": 1788069689, "title": "独立做了一个 Mac 语音输入工具，终于有了第一个付费用户，却高兴不起来了", "url": "https://www.v2ex.com/t/1238099", "created": 1788021504, "deleted": 0, "content": "先自报家门，我做了一个 Mac AI 语音输入工具，叫 Openbroca ，官网是 openbroca.com 。\r\n\r\n今天终于收到了第一个真实付费用户。\r\n\r\n我原本以为自己会很开心，可能会截图纪念，或者找朋友喝一杯。真正看到订单的时候，我只是盯着后台确认了几遍，然后长出了一口气。\r\n\r\n第一笔收入当然值得记录，可我心里更多的感觉是累。\r\n\r\nOpenbroca 最早来源于我自己的需求。我在 Mac 上写邮件、文档和长消息时，经常觉得思考速度比打字快很多。普通语音输入又会保留大量停顿、重复和口头语，最后还要重新修改一遍。\r\n\r\n所以我做了 Openbroca 。\r\n\r\n按下快捷键直接说话，它会把自然口述整理成清晰文字，再写入当前光标所在的位置。它还有屏幕上下文、个人词典和边说边翻译。一路做下来，原生 Swift 客户端、云端语音识别、文字整理、用户系统、支付、配额、官网、SEO 、数据分析，几乎每一块都比预想中更耗时间。\r\n\r\n写代码反而是其中比较确定的一部分。最折磨人的，是产品做出来以后没有人知道，也很难判断大家到底愿不愿意付费。\r\n\r\n在国内推广独立效率工具真的很难。\r\n\r\n前有微信输入法，后有豆包输入法。Typeless 把 AI 语音输入这个方向验证出来以后，越来越多大厂开始快速跟进。类似产品会越来越多，渠道、品牌、模型资源和免费策略都很难正面竞争。\r\n\r\nOpenbroca 来源于我自己的真实需求，与追逐风口无关。可当大厂进入同一个方向以后，一个独立产品想获得流量、建立信任、说服用户付费，每一步都很重。\r\n\r\n第一个付费用户至少证明了一件事，这个需求真实存在，也确实有人愿意为它付钱。\r\n\r\n可我一点也高兴不起来。\r\n\r\n因为这一笔订单同时让我看清了，这条路比我预想中难太多。第一位用户来了，接下来怎样找到十个、一百个用户，怎样保证服务稳定，怎样持续承担模型成本，每一个问题都还在前面。\r\n\r\n我目前能看到的一条路，可能是出海。\r\n\r\n海外用户对 Mac 生产力工具和订阅软件的接受度相对更高，Openbroca 本身也适合跨语言写作。接下来我准备把更多精力放在海外内容、搜索流量和真实使用场景上。\r\n\r\n也想借这次经历提醒准备做独立产品的朋友。\r\n\r\n如果主要面向国内，尽量寻找足够垂直、足够小众、又确实有人愿意付费的需求。\r\n\r\n这个市场最好小到暂时进不了大厂的优先级，同时痛点又足够具体。你能直接找到用户，也能比大厂更深入地理解场景。\r\n\r\n这样的方向，做起来才有机会事半功倍。\r\n\r\n热门赛道看起来空间很大，竞争成本也会迅速变得很高。独立开发者的时间和资金都有限，选错方向以后，产品做得再认真，也可能长期卡在获客这一步。\r\n\r\n如果你愿意体验，链接放在这里：openbroca.com 。\r\n\r\n如果你做过出海产品，也很想听听你是怎样找到前十个、前一百个用户的。\r\n\r\n第一笔付费已经有了。\r\n\r\n我现在只觉得，太难了。", "content_rendered": "<p>先自报家门，我做了一个 Mac AI 语音输入工具，叫 Openbroca ，官网是 <a href=\"http://openbroca.com\" rel=\"nofollow\">openbroca.com</a> 。</p>\n<p>今天终于收到了第一个真实付费用户。</p>\n<p>我原本以为自己会很开心，可能会截图纪念，或者找朋友喝一杯。真正看到订单的时候，我只是盯着后台确认了几遍，然后长出了一口气。</p>\n<p>第一笔收入当然值得记录，可我心里更多的感觉是累。</p>\n<p>Openbroca 最早来源于我自己的需求。我在 Mac 上写邮件、文档和长消息时，经常觉得思考速度比打字快很多。普通语音输入又会保留大量停顿、重复和口头语，最后还要重新修改一遍。</p>\n<p>所以我做了 Openbroca 。</p>\n<p>按下快捷键直接说话，它会把自然口述整理成清晰文字，再写入当前光标所在的位置。它还有屏幕上下文、个人词典和边说边翻译。一路做下来，原生 Swift 客户端、云端语音识别、文字整理、用户系统、支付、配额、官网、SEO 、数据分析，几乎每一块都比预想中更耗时间。</p>\n<p>写代码反而是其中比较确定的一部分。最折磨人的，是产品做出来以后没有人知道，也很难判断大家到底愿不愿意付费。</p>\n<p>在国内推广独立效率工具真的很难。</p>\n<p>前有微信输入法，后有豆包输入法。Typeless 把 AI 语音输入这个方向验证出来以后，越来越多大厂开始快速跟进。类似产品会越来越多，渠道、品牌、模型资源和免费策略都很难正面竞争。</p>\n<p>Openbroca 来源于我自己的真实需求，与追逐风口无关。可当大厂进入同一个方向以后，一个独立产品想获得流量、建立信任、说服用户付费，每一步都很重。</p>\n<p>第一个付费用户至少证明了一件事，这个需求真实存在，也确实有人愿意为它付钱。</p>\n<p>可我一点也高兴不起来。</p>\n<p>因为这一笔订单同时让我看清了，这条路比我预想中难太多。第一位用户来了，接下来怎样找到十个、一百个用户，怎样保证服务稳定，怎样持续承担模型成本，每一个问题都还在前面。</p>\n<p>我目前能看到的一条路，可能是出海。</p>\n<p>海外用户对 Mac 生产力工具和订阅软件的接受度相对更高，Openbroca 本身也适合跨语言写作。接下来我准备把更多精力放在海外内容、搜索流量和真实使用场景上。</p>\n<p>也想借这次经历提醒准备做独立产品的朋友。</p>\n<p>如果主要面向国内，尽量寻找足够垂直、足够小众、又确实有人愿意付费的需求。</p>\n<p>这个市场最好小到暂时进不了大厂的优先级，同时痛点又足够具体。你能直接找到用户，也能比大厂更深入地理解场景。</p>\n<p>这样的方向，做起来才有机会事半功倍。</p>\n<p>热门赛道看起来空间很大，竞争成本也会迅速变得很高。独立开发者的时间和资金都有限，选错方向以后，产品做得再认真，也可能长期卡在获客这一步。</p>\n<p>如果你愿意体验，链接放在这里：<a href=\"http://openbroca.com\" rel=\"nofollow\">openbroca.com</a> 。</p>\n<p>如果你做过出海产品，也很想听听你是怎样找到前十个、前一百个用户的。</p>\n<p>第一笔付费已经有了。</p>\n<p>我现在只觉得，太难了。</p>\n", "last_modified": 1788021504, "replies": 25, "id": 1238099}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/1f0e/3dad/19_large.png?m=1650127314", "name": "beijing", "avatar_normal": "https://cdn.v2ex.com/navatar/1f0e/3dad/19_normal.png?m=1650127314", "title": "北京", "url": "https://www.v2ex.com/go/beijing", "topics": 4495, "footer": "", "header": "", "title_alternative": "Beijing", "avatar_mini": "https://cdn.v2ex.com/navatar/1f0e/3dad/19_mini.png?m=1650127314", "stars": 2394, "founder_id": 