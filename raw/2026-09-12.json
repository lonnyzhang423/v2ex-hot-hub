[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241544, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4514, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_large": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_large.png?m=1691393963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xlarge.png?m=1691393963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxlarge.png?m=1691393963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxxlarge.png?m=1691393963", "created": 1663333667, "last_modified": 1691393963, "pro": 0}, "last_reply_by": "firelynx", "last_touched": 1789189945, "title": "筷子不能竖着插在饭里是全国性的常识吗？", "url": "https://www.v2ex.com/t/1241327", "created": 1789108164, "deleted": 0, "content": "今天在推特上刷到一个关于中日韩文化禁忌的帖子，让我想起来初中时发生的一件事。\r\n\r\n某次吃饭时，我将筷子竖着插在了米饭里，父亲仿佛像被狗咬了一样蹦起来狠狠揍了我一顿，又是打又是骂，说广东人给先人上供的时候才这么干。\r\n\r\n我心里愤愤不平，你一个甘肃人，又不是广东人，你急什么；再说也没人给我说过这件事啊，家里也不供奉什么先祖灵位，我咋知道有这回事。\r\n\r\n---\r\n\r\n从那以后每次我想起这件事心头就蒙起了一层阴影，只要自己一个人吃饭都要将筷子竖着插在米饭里，不知不觉成为了习惯，一直到今天。\r\n\r\n我想知道，这件事情你们从小就知道吗？", "content_rendered": "<p>今天在推特上刷到一个关于中日韩文化禁忌的帖子，让我想起来初中时发生的一件事。</p>\n<p>某次吃饭时，我将筷子竖着插在了米饭里，父亲仿佛像被狗咬了一样蹦起来狠狠揍了我一顿，又是打又是骂，说广东人给先人上供的时候才这么干。</p>\n<p>我心里愤愤不平，你一个甘肃人，又不是广东人，你急什么；再说也没人给我说过这件事啊，家里也不供奉什么先祖灵位，我咋知道有这回事。</p>\n<hr/>\n<p>从那以后每次我想起这件事心头就蒙起了一层阴影，只要自己一个人吃饭都要将筷子竖着插在米饭里，不知不觉成为了习惯，一直到今天。</p>\n<p>我想知道，这件事情你们从小就知道吗？</p>\n", "last_modified": 1789108164, "replies": 188, "id": 1241327}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a4a0/42cf/171_large.png?m=1782097568", "name": "invest", "avatar_normal": "https://cdn.v2ex.com/navatar/a4a0/42cf/171_normal.png?m=1782097568", "title": "投资", "url": "https://www.v2ex.com/go/invest", "topics": 3819, "footer": "", "header": "Can you make money with money?", "title_alternative": "Invest", "avatar_mini": "https://cdn.v2ex.com/navatar/a4a0/42cf/171_mini.png?m=1782097568", "stars": 4649, "founder_id": 0, "aliases": [], "root": false, "id": 171, "parent_node_name": ""}, "member": {"id": 534551, "username": "277", "url": "https://www.v2ex.com/u/277", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/7de9ff6d09bee0a81294b6377d65559d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/7de9ff6d09bee0a81294b6377d65559d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/7de9ff6d09bee0a81294b6377d65559d?s=73&d=retro", "created": 1614146367, "last_modified": 1762838160, "pro": 0}, "last_reply_by": "yyh0808", "last_touched": 1789186384, "title": "-52% 还能回本吗", "url": "https://www.v2ex.com/t/1241315", "created": 1789106233, "deleted": 0, "content": "有没有过来人给个经验，不加仓的情况下 -52% 死拿有希望回本吗，拿了一年多了\r\n\r\n不甘心啊\r\n\r\n害怕倒在黎明前\r\n\r\n有没有经历过相同情况的大佬，回本了，给我点希望。", "content_rendered": "<p>有没有过来人给个经验，不加仓的情况下 -52% 死拿有希望回本吗，拿了一年多了</p>\n<p>不甘心啊</p>\n<p>害怕倒在黎明前</p>\n<p>有没有经历过相同情况的大佬，回本了，给我点希望。</p>\n", "last_modified": 1789172223, "replies": 79, "id": 1241315}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73293, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9782, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 368971, "username": "crstudio", "url": "https://www.v2ex.com/u/crstudio", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/3af5/506c/368971_mini.png?m=1621591420", "avatar_normal": "https://cdn.v2ex.com/avatar/3af5/506c/368971_normal.png?m=1621591420", "avatar_large": "https://cdn.v2ex.com/avatar/3af5/506c/368971_large.png?m=1621591420", "created": 1544242082, "last_modified": 1621591420, "pro": 0}, "last_reply_by": "jackerbauer", "last_touched": 1789188534, "title": "有人买了中转站 6TB 的数据，里面有大量的服务器账号安全数据，看你们还敢用中转吗？", "url": "https://www.v2ex.com/t/1241336", "created": 1789110279, "deleted": 0, "content": "说是花了 5 位数买的，看截图，貌似里面有很多互联网大厂的服务器数据，不过大厂的应该很多是内部账号吧。\r\n有用中转的朋友做自己项目的，赶紧改密码吧。\r\n\r\n![82c654dfly1igzkr838o4j21480xpwr3.jpg]( https://picui.ogmua.cn/s1/2026/09/11/6aa3a7e344849.webp)", "content_rendered": "<p>说是花了 5 位数买的，看截图，貌似里面有很多互联网大厂的服务器数据，不过大厂的应该很多是内部账号吧。\n有用中转的朋友做自己项目的，赶紧改密码吧。</p>\n<p><img alt=\"82c654dfly1igzkr838o4j21480xpwr3.jpg\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://picui.ogmua.cn/s1/2026/09/11/6aa3a7e344849.webp\"/></p>\n", "last_modified": 1789110453, "replies": 61, "id": 1241336}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 36564, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6190, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 136189, "username": "andforce", "url": "https://www.v2ex.com/u/andforce", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/5fd5/33c7/136189_mini.png?m=1788171559", "avatar_normal": "https://cdn.v2ex.com/avatar/5fd5/33c7/136189_normal.png?m=1788171559", "avatar_large": "https://cdn.v2ex.com/avatar/5fd5/33c7/136189_large.png?m=1788171559", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5fd5/33c7/136189_xlarge.png?m=1788171559", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5fd5/33c7/136189_xxlarge.png?m=1788171559", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/5fd5/33c7/136189_xxxlarge.png?m=1788171559", "created": 1441017989, "last_modified": 1788171559, "pro": 0}, "last_reply_by": "daniums", "last_touched": 1789171182, "title": "[送码]在手机端 AI 编程最佳应用： Octrix", "url": "https://www.v2ex.com/t/1241311", "created": 1789105717, "deleted": 0, "content": "# 用户群体是谁？\r\nAI 编程发展到现在，在手机上编程已经不是什么新鲜事了，像 Codex 的手机客户端进行远程控制编程就非常好用。\r\n\r\n为什么做这个 APP 呢？是因为我发现并不是所有人都用 Codex ，他们可能是用 CodeX 接入国产模型（比如 Kimi 、DeepSeek 等等），这些不支持使用 Codex 官方的手机 APP 进行远程控制。\r\n\r\n为了实现远程控制，大家往往会在手机上使用终端去处理。但在手机上用终端是一个非常反人类的操作，体验特别差，这就是我开发这个软件的核心点所在。\r\n\r\n# 工作原理\r\n这个软件的核心工作原理很简单：\r\n\r\n1. 在 Mac 上起一个服务模拟 TUI ，这样就有了跟各种 AI agent 进行通信的能力（支持 Codex 、Cloud Code 等十余款 CLI 工具）\r\n2. 通过一个后端中转服务，把手机和 Mac 进行通信与配对绑定\r\n\r\n这样在手机端就是一个聊天对话框，可以完成与 Mac 上的通信\r\n\r\n\r\n# 特色\r\n0 、全部开源，从 iOS 客户端，到中继服务，到落地页都开源\r\n1 、支持大部分 AI CLI ，理论上可以适配所有 CLI\r\n2 、自带语音输入（需要配置 DeepSeek 的 API Key ）\r\n3 、支持长按进入文件、图片等\r\n\r\n\r\n# 资源\r\n\r\n开源地址 https://github.com/andforce/octrix\r\n\r\niOS 应用下载地址 https://apps.apple.com/cn/app/octrix/id6786918049\r\n\r\n\r\n官网 https://octrix.work/\r\n\r\n用户群：\r\n\r\n![0]( https://raw.githubusercontent.com/andforce/octrix/refs/heads/main/docs/images/wechat-user-group.jpeg)\r\n\r\n\r\n# 产品部分截图\r\n\r\n![1]( https://octrix.work/macbook-web-tui.webp)\r\n\r\n\r\n\r\n![2]( https://raw.githubusercontent.com/andforce/octrix/main/docs/images/ios-conversation-list.png)\r\n\r\n\r\n\r\n![3]( https://github.com/andforce/octrix/raw/main/docs/images/ios-voice-input.png)", "content_rendered": "<h1>用户群体是谁？</h1>\n<p>AI 编程发展到现在，在手机上编程已经不是什么新鲜事了，像 Codex 的手机客户端进行远程控制编程就非常好用。</p>\n<p>为什么做这个 APP 呢？是因为我发现并不是所有人都用 Codex ，他们可能是用 CodeX 接入国产模型（比如 Kimi 、DeepSeek 等等），这些不支持使用 Codex 官方的手机 APP 进行远程控制。</p>\n<p>为了实现远程控制，大家往往会在手机上使用终端去处理。但在手机上用终端是一个非常反人类的操作，体验特别差，这就是我开发这个软件的核心点所在。</p>\n<h1>工作原理</h1>\n<p>这个软件的核心工作原理很简单：</p>\n<ol>\n<li>在 Mac 上起一个服务模拟 TUI ，这样就有了跟各种 AI agent 进行通信的能力（支持 Codex 、Cloud Code 等十余款 CLI 工具）</li>\n<li>通过一个后端中转服务，把手机和 Mac 进行通信与配对绑定</li>\n</ol>\n<p>这样在手机端就是一个聊天对话框，可以完成与 Mac 上的通信</p>\n<h1>特色</h1>\n<p>0 、全部开源，从 iOS 客户端，到中继服务，到落地页都开源\n1 、支持大部分 AI CLI ，理论上可以适配所有 CLI\n2 、自带语音输入（需要配置 DeepSeek 的 API Key ）\n3 、支持长按进入文件、图片等</p>\n<h1>资源</h1>\n<p>开源地址 <a href=\"https://github.com/andforce/octrix\" rel=\"nofollow\">https://github.com/andforce/octrix</a></p>\n<p>iOS 应用下载地址 <a href=\"https://apps.apple.com/cn/app/octrix/id6786918049\" rel=\"nofollow\">https://apps.apple.com/cn/app/octrix/id6786918049</a></p>\n<p>官网 <a href=\"https://octrix.work/\" rel=\"nofollow\">https://octrix.work/</a></p>\n<p>用户群：</p>\n<p><img alt=\"0\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://raw.githubusercontent.com/andforce/octrix/refs/heads/main/docs/images/wechat-user-group.jpeg\"/></p>\n<h1>产品部分截图</h1>\n<p><img alt=\"1\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://octrix.work/macbook-web-tui.webp\"/></p>\n<p><img alt=\"2\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://raw.githubusercontent.com/andforce/octrix/main/docs/images/ios-conversation-list.png\"/></p>\n<p><img alt=\"3\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://github.com/andforce/octrix/raw/main/docs/images/ios-voice-input.png\"/></p>\n", "last_modified": 1789105717, "replies": 57, "id": 1241311}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241544, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4514, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 476351, "username": "chaoming", "url": "https://www.v2ex.com/u/chaoming", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/1cccd9557eb9e93dedc9b7e510b0ab6d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/1cccd9557eb9e93dedc9b7e510b0ab6d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/1cccd9557eb9e93dedc9b7e510b0ab6d?s=73&d=retro", "created": 1584068326, "last_modified": 1789108295, "pro": 0}, "last_reply_by": "tokas93", "last_touched": 1789155352, "title": "为一个弱智的问题 大家怎么插入的图片", "url": "https://www.v2ex.com/t/1241328", "created": 1789108322, "deleted": 0, "content": "想问问这个初级小白的问题，怎么插入的图片啊？？？", "content_rendered": "<p>想问问这个初级小白的问题，怎么插入的图片啊？？？</p>\n", "last_modified": 1789108322, "replies": 56, "id": 1241328}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/093f/65e0/59_large.png?m=1747623725", "name": "random", "avatar_normal": "https://cdn.v2ex.com/navatar/093f/65e0/59_normal.png?m=1747623725", "title": "随想", "url": "https://www.v2ex.com/go/random", "topics": 4373, "footer": "", "header": "有的时候，可以停下来找找灵感，然后再继续。", "title_alternative": "Random", "avatar_mini": "https://cdn.v2ex.com/navatar/093f/65e0/59_mini.png?m=1747623725", "stars": 1315, "founder_id": 0, "aliases": [], "root": false, "id": 59, "parent_node_name": "v2ex"}, "member": {"id": 46684, "username": "dawn009", "url": "https://www.v2ex.com/u/dawn009", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/2742/7f5b/46684_mini.png?m=1401146806", "avatar_normal": "https://cdn.v2ex.com/avatar/2742/7f5b/46684_normal.png?m=1401146806", "avatar_large": "https://cdn.v2ex.com/avatar/2742/7f5b/46684_large.png?m=1401146806", "created": 1381536778, "last_modified": 1401146806, "pro": 0}, "last_reply_by": "yungo8", "last_touched": 1789185105, "title": "有些人不允许别人把筷子竖着插进饭里", "url": "https://www.v2ex.com/t/1241413", "created": 1789123660, "deleted": 0, "content": "看到了这个帖子 /t/1241327 “筷子不能竖着插在饭里是全国性的常识吗？”\r\n\r\n于是查了下有没有别的关于碗筷的“禁忌”。有些人不允许别人：\r\n\r\n把筷子横着放在碗上；\r\n把筷子竖着插进饭里；\r\n把筷子一长一短地摆放；\r\n把两双筷子交叉摆放；\r\n用筷子敲碗、敲盘子；\r\n在碗里剩很多饭；\r\n把饭碗倒扣；\r\n把碗放在地上；\r\n用筷子叉食物；\r\n用筷子互相传递食物；\r\n吃饭前把筷子在桌上反复磕齐；\r\n用筷子拨碗碟、转盘；\r\n盛饭盛得特别高、特别尖；\r\n\r\n\r\n其实这些禁忌的性质相同，都是对别人行为的限制。有人觉得是礼貌，有人觉得是规矩，有人觉得是不合时宜的糟粕。但不可否认的是，来源于旧时代习俗在现代社会中正变得越来越淡薄，用不了太久就会变成小众的记忆。\r\n\r\n在我看来，别人照顾这些忌讳是情分不是本分，可以请求但不该命令、不该强迫。", "content_rendered": "看到了这个帖子 <a target=\"_blank\" href=\"/t/1241327\" rel=\"nofollow noopener\">/t/1241327</a> “筷子不能竖着插在饭里是全国性的常识吗？”<br /><br />于是查了下有没有别的关于碗筷的“禁忌”。有些人不允许别人：<br /><br />把筷子横着放在碗上；<br />把筷子竖着插进饭里；<br />把筷子一长一短地摆放；<br />把两双筷子交叉摆放；<br />用筷子敲碗、敲盘子；<br />在碗里剩很多饭；<br />把饭碗倒扣；<br />把碗放在地上；<br />用筷子叉食物；<br />用筷子互相传递食物；<br />吃饭前把筷子在桌上反复磕齐；<br />用筷子拨碗碟、转盘；<br />盛饭盛得特别高、特别尖；<br /><br /><br />其实这些禁忌的性质相同，都是对别人行为的限制。有人觉得是礼貌，有人觉得是规矩，有人觉得是不合时宜的糟粕。但不可否认的是，来源于旧时代习俗在现代社会中正变得越来越淡薄，用不了太久就会变成小众的记忆。<br /><br />在我看来，别人照顾这些忌讳是情分不是本分，可以请求但不该命令、不该强迫。", "last_modified": 1789123674, "replies": 54, "id": 1241413}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73293, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9782, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 753900, "username": "wKong753900", "url": "https://www.v2ex.com/u/wKong753900", "website": "", "twitter": "", "psn": "", "github": "Kun-GitHub", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/52ecc1a35bf472a593afba5faa3c2b62?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/52ecc1a35bf472a593afba5faa3c2b62?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/52ecc1a35bf472a593afba5faa3c2b62?s=73&d=retro", "created": 1750491712, "last_modified": 1765516219, "pro": 0}, "last_reply_by": "bowencool", "last_touched": 1789189894, "title": "讨论一下在手机上编程是不是伪需求", "url": "https://www.v2ex.com/t/1241482", "created": 1789176044, "deleted": 0, "content": "如题，手机编程，不是手机远程电脑编程哈\r\n\r\n个人观点是伪需求，谢谢，下一个", "content_rendered": "<p>如题，手机编程，不是手机远程电脑编程哈</p>\n<p>个人观点是伪需求，谢谢，下一个</p>\n", "last_modified": 1789176044, "replies": 43, "id": 1241482}]