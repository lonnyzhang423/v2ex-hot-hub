[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241548, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4514, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_large": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_large.png?m=1691393963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xlarge.png?m=1691393963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxlarge.png?m=1691393963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxxlarge.png?m=1691393963", "created": 1663333667, "last_modified": 1691393963, "pro": 0}, "last_reply_by": "wxppkm", "last_touched": 1789147969, "title": "筷子不能竖着插在饭里是全国性的常识吗？", "url": "https://www.v2ex.com/t/1241327", "created": 1789108164, "deleted": 0, "content": "今天在推特上刷到一个关于中日韩文化禁忌的帖子，让我想起来初中时发生的一件事。\r\n\r\n某次吃饭时，我将筷子竖着插在了米饭里，父亲仿佛像被狗咬了一样蹦起来狠狠揍了我一顿，又是打又是骂，说广东人给先人上供的时候才这么干。\r\n\r\n我心里愤愤不平，你一个甘肃人，又不是广东人，你急什么；再说也没人给我说过这件事啊，家里也不供奉什么先祖灵位，我咋知道有这回事。\r\n\r\n---\r\n\r\n从那以后每次我想起这件事心头就蒙起了一层阴影，只要自己一个人吃饭都要将筷子竖着插在米饭里，不知不觉成为了习惯，一直到今天。\r\n\r\n我想知道，这件事情你们从小就知道吗？", "content_rendered": "<p>今天在推特上刷到一个关于中日韩文化禁忌的帖子，让我想起来初中时发生的一件事。</p>\n<p>某次吃饭时，我将筷子竖着插在了米饭里，父亲仿佛像被狗咬了一样蹦起来狠狠揍了我一顿，又是打又是骂，说广东人给先人上供的时候才这么干。</p>\n<p>我心里愤愤不平，你一个甘肃人，又不是广东人，你急什么；再说也没人给我说过这件事啊，家里也不供奉什么先祖灵位，我咋知道有这回事。</p>\n<hr/>\n<p>从那以后每次我想起这件事心头就蒙起了一层阴影，只要自己一个人吃饭都要将筷子竖着插在米饭里，不知不觉成为了习惯，一直到今天。</p>\n<p>我想知道，这件事情你们从小就知道吗？</p>\n", "last_modified": 1789108164, "replies": 173, "id": 1241327}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 36555, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6190, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 612296, "username": "gswgudujian", "url": "https://www.v2ex.com/u/gswgudujian", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/9946139482db58d89d695da99db50f54?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9946139482db58d89d695da99db50f54?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9946139482db58d89d695da99db50f54?s=73&d=retro", "created": 1675418622, "last_modified": 1789090892, "pro": 0}, "last_reply_by": "killeder", "last_touched": 1789128525, "title": "把老站重做了一遍： Windows 10/11 精简版、全量版、LTSC，装完基本不用再配", "url": "https://www.v2ex.com/t/1241226", "created": 1789091464, "deleted": 0, "content": "断断续续折腾 Windows 部署和优化挺久了，最近把之前的站点重新迁移整理了一遍，\r\n放到 wlite.cn 上。\r\n\r\n站上主要放这几类东西：\r\n\r\n- Windows 10 / 11 的各种版本：精简版、全量版、原版、LTSC ，另外还有 WinPE\r\n- 每个镜像都是自己装过、跑过一轮才发出来的，不是从别处转的\r\n- 装完系统通常要装的软件都集成好了：压缩、备份还原、磁盘分析、截图、\r\n  运行库、输入法这些，装完基本不用再自己配一遍\r\n- 系统本身干净，没有夹带推广，主页和默认搜索也不会被动\r\n- 做了一些比较省心的调整，日常用起来不用再折腾\r\n\r\n起因挺简单的：帮朋友装机，装完原版还得再花一两个小时装软件、调设置，\r\n后来干脆一次都弄好。\r\n\r\n技术上是 NodeBB 改的，前端自己调，顺手把 SEO 那些也做了一遍。\r\n\r\n想听听实际的反馈：\r\n- 这种\"装完就能用\"的思路，真用起来会不会觉得哪里多余，或者还缺什么\r\n- 站点的分类结构和下载体验上，有什么可以改的\r\n\r\n站里有个会员功能（主要是下载加速和资源），我准备了 10 个兑换码，\r\n回帖的朋友里随机抽 10 位发，有需要的回帖说一声就行。\r\n\r\n地址： https://wlite.cn\r\n\r\n欢迎来试，也欢迎直接拍砖。\r\n\r\n\r\n ![]( https://i.imgur.com/sS4vcMo.png) \r\n\r\n ![]( https://i.imgur.com/71HY2WN.png)\r\n ![]( https://imgur.com/dGHUc48)", "content_rendered": "<p>断断续续折腾 Windows 部署和优化挺久了，最近把之前的站点重新迁移整理了一遍，\n放到 <a href=\"http://wlite.cn\" rel=\"nofollow\">wlite.cn</a> 上。</p>\n<p>站上主要放这几类东西：</p>\n<ul>\n<li>Windows 10 / 11 的各种版本：精简版、全量版、原版、LTSC ，另外还有 WinPE</li>\n<li>每个镜像都是自己装过、跑过一轮才发出来的，不是从别处转的</li>\n<li>装完系统通常要装的软件都集成好了：压缩、备份还原、磁盘分析、截图、\n运行库、输入法这些，装完基本不用再自己配一遍</li>\n<li>系统本身干净，没有夹带推广，主页和默认搜索也不会被动</li>\n<li>做了一些比较省心的调整，日常用起来不用再折腾</li>\n</ul>\n<p>起因挺简单的：帮朋友装机，装完原版还得再花一两个小时装软件、调设置，\n后来干脆一次都弄好。</p>\n<p>技术上是 NodeBB 改的，前端自己调，顺手把 SEO 那些也做了一遍。</p>\n<p>想听听实际的反馈：</p>\n<ul>\n<li>这种\"装完就能用\"的思路，真用起来会不会觉得哪里多余，或者还缺什么</li>\n<li>站点的分类结构和下载体验上，有什么可以改的</li>\n</ul>\n<p>站里有个会员功能（主要是下载加速和资源），我准备了 10 个兑换码，\n回帖的朋友里随机抽 10 位发，有需要的回帖说一声就行。</p>\n<p>地址： <a href=\"https://wlite.cn\" rel=\"nofollow\">https://wlite.cn</a></p>\n<p>欢迎来试，也欢迎直接拍砖。</p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/sS4vcMo.png\"/> </p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/71HY2WN.png\"/>\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://imgur.com/dGHUc48\"/></p>\n", "last_modified": 1789091936, "replies": 101, "id": 1241226}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24317, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3739, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 601695, "username": "cityeys", "url": "https://www.v2ex.com/u/cityeys", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/59cd5b00c6a5e74b2366d2f368c61838?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/59cd5b00c6a5e74b2366d2f368c61838?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/59cd5b00c6a5e74b2366d2f368c61838?s=73&d=retro", "created": 1668389184, "last_modified": 1668389184, "pro": 0}, "last_reply_by": "gefangshuai", "last_touched": 1789140698, "title": "大家会跟同事或者领导说自己用 Ai 完成需求吗？", "url": "https://www.v2ex.com/t/1241204", "created": 1789088333, "deleted": 0, "content": "当一个非常规的开发需求，比如爬取数据、整理表格数据，类似这种常规做法需要耗时但 Ai 又很轻松能做完的工作，会跟同事或者领导说自己用 Ai 高效的完成工作吗？", "content_rendered": "<p>当一个非常规的开发需求，比如爬取数据、整理表格数据，类似这种常规做法需要耗时但 Ai 又很轻松能做完的工作，会跟同事或者领导说自己用 Ai 高效的完成工作吗？</p>\n", "last_modified": 1789099451, "replies": 96, "id": 1241204}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11664, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2464, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 713662, "username": "en26sky", "url": "https://www.v2ex.com/u/en26sky", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/ab7628b57e65e600c10821062af4070a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/ab7628b57e65e600c10821062af4070a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/ab7628b57e65e600c10821062af4070a?s=73&d=retro", "created": 1728366431, "last_modified": 1778335672, "pro": 0}, "last_reply_by": "zryadj", "last_touched": 1789146549, "title": "躺平是不是版本答案？", "url": "https://www.v2ex.com/t/1241205", "created": 1789088740, "deleted": 0, "content": "1.不工作：现在工作难找，就算有工作也很累。如果没结婚没娃没房贷，到小地方租房躺平真的很划算。而且上班交那么多社保，到退休领的估计只够喝稀饭。\r\n2.不结婚：没有彩礼没有乱七八糟的家庭关系。\r\n3.不买房：不用花高价住鸽子楼，也不用给 zf 和银行打工。\r\n4.不生娃：生娃除了能给自己情感反馈，其他基本是负收益。你看 4 岁娃事件，这只是生活中的小事，其他麻烦事更多。\r\nps:我结婚有娃没房没车在上班，但是好想躺平呀", "content_rendered": "1.不工作：现在工作难找，就算有工作也很累。如果没结婚没娃没房贷，到小地方租房躺平真的很划算。而且上班交那么多社保，到退休领的估计只够喝稀饭。<br />2.不结婚：没有彩礼没有乱七八糟的家庭关系。<br />3.不买房：不用花高价住鸽子楼，也不用给 zf 和银行打工。<br />4.不生娃：生娃除了能给自己情感反馈，其他基本是负收益。你看 4 岁娃事件，这只是生活中的小事，其他麻烦事更多。<br />ps:我结婚有娃没房没车在上班，但是好想躺平呀", "last_modified": 1789088740, "replies": 83, "id": 1241205}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241548, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4514, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 534551, "username": "277", "url": "https://www.v2ex.com/u/277", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/7de9ff6d09bee0a81294b6377d65559d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/7de9ff6d09bee0a81294b6377d65559d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/7de9ff6d09bee0a81294b6377d65559d?s=73&d=retro", "created": 1614146367, "last_modified": 1762838160, "pro": 0}, "last_reply_by": "docx", "last_touched": 1789145479, "title": "-52% 还能回本吗", "url": "https://www.v2ex.com/t/1241315", "created": 1789106233, "deleted": 0, "content": "有没有过来人给个经验，不加仓的情况下 -52% 死拿有希望回本吗，拿了一年多了\r\n\r\n不甘心啊\r\n\r\n害怕倒在黎明前\r\n\r\n有没有经历过相同情况的大佬，回本了，给我点希望。", "content_rendered": "<p>有没有过来人给个经验，不加仓的情况下 -52% 死拿有希望回本吗，拿了一年多了</p>\n<p>不甘心啊</p>\n<p>害怕倒在黎明前</p>\n<p>有没有经历过相同情况的大佬，回本了，给我点希望。</p>\n", "last_modified": 1789106233, "replies": 61, "id": 1241315}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73296, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9782, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 651647, "username": "wannerkingof69", "url": "https://www.v2ex.com/u/wannerkingof69", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/60b4/c5b2/651647_mini.png?m=1789100230", "avatar_normal": "https://cdn.v2ex.com/avatar/60b4/c5b2/651647_normal.png?m=1789100230", "avatar_large": "https://cdn.v2ex.com/avatar/60b4/c5b2/651647_large.png?m=1789100230", "avatar_xlarge": "https://cdn.v2ex.com/avatar/60b4/c5b2/651647_xlarge.png?m=1789100230", "created": 1695887341, "last_modified": 1789100230, "pro": 0}, "last_reply_by": "luya", "last_touched": 1789140722, "title": "真难啊，做个网站 3 个月 600 曝光， 40 次点击。", "url": "https://www.v2ex.com/t/1241297", "created": 1789100269, "deleted": 0, "content": "https://i.imgur.com/uWVIdzh.png", "content_rendered": "<a target=\"_blank\" href=\"https://i.imgur.com/uWVIdzh.png\" rel=\"nofollow noopener\" target=\"_blank\"><img src=\"https://i.imgur.com/uWVIdzh.png\" class=\"embedded_image\" rel=\"noreferrer\"></a>", "last_modified": 1789100269, "replies": 58, "id": 1241297}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24317, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3739, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 654059, "username": "kemo", "url": "https://www.v2ex.com/u/kemo", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/a3138872d871d2b066bccec08b743a72?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/a3138872d871d2b066bccec08b743a72?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/a3138872d871d2b066bccec08b743a72?s=73&d=retro", "created": 1696920375, "last_modified": 1722999656, "pro": 0}, "last_reply_by": "qqqvexxdh", "last_touched": 1789133845, "title": "最近几月大家用 ai 开发之后，还会加班吗？", "url": "https://www.v2ex.com/t/1241211", "created": 1789089658, "deleted": 0, "content": "前几月 gpt5.5 和 claude4.6 出来之前的不算，当时 ai 算力还不够，还会用 ai 经常调试几遍，\r\n\r\n可最近明显感觉身边开发的同事和朋友**下班越来越早**，ai 写的代码会自己控制电脑检查，最后给你一个完整的版本，**基本上都是一遍过。**\r\n\r\n再也回不到当年一个 bug 运行报错，吭哧吭哧加班到深夜才解决后的那种**快感和成就满足感**，\r\n\r\n以前别人都说**程序员加班严重**，现在这个帽子可以摘掉了嘛？\r\n\r\n问心自问，**工作的开发需求量还真需要你加班才能完成吗？还是表演式加班？**", "content_rendered": "<p>前几月 gpt5.5 和 claude4.6 出来之前的不算，当时 ai 算力还不够，还会用 ai 经常调试几遍，</p>\n<p>可最近明显感觉身边开发的同事和朋友<strong>下班越来越早</strong>，ai 写的代码会自己控制电脑检查，最后给你一个完整的版本，<strong>基本上都是一遍过。</strong></p>\n<p>再也回不到当年一个 bug 运行报错，吭哧吭哧加班到深夜才解决后的那种<strong>快感和成就满足感</strong>，</p>\n<p>以前别人都说<strong>程序员加班严重</strong>，现在这个帽子可以摘掉了嘛？</p>\n<p>问心自问，<strong>工作的开发需求量还真需要你加班才能完成吗？还是表演式加班？</strong></p>\n", "last_modified": 1789089658, "replies": 55, "id": 1241211}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241548, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4514, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 476351, "username": "chaoming", "url": "https://www.v2ex.com/u/chaoming", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/1cccd9557eb9e93dedc9b7e510b0ab6d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/1cccd9557eb9e93dedc9b7e510b0ab6d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/1cccd9557eb9e93dedc9b7e510b0ab6d?s=73&d=retro", "created": 1584068326, "last_modified": 1789108295, "pro": 0}, "last_reply_by": "Need4more", "last_touched": 1789144552, "title": "为一个弱智的问题 大家怎么插入的图片", "url": "https://www.v2ex.com/t/1241328", "created": 1789108322, "deleted": 0, "content": "想问问这个初级小白的问题，怎么插入的图片啊？？？", "content_rendered": "<p>想问问这个初级小白的问题，怎么插入的图片啊？？？</p>\n", "last_modified": 1789108322, "replies": 53, "id": 1241328}]