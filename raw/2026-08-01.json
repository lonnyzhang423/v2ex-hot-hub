r/093f/65e0/59_mini.png?m=1747623725", "stars": 1315, "founder_id": 0, "aliases": [], "root": false, "id": 59, "parent_node_name": "v2ex"}, "member": {"id": 473521, "username": "erwin985211", "url": "https://www.v2ex.com/u/erwin985211", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/4892/cea6/473521_mini.png?m=1779008813", "avatar_normal": "https://cdn.v2ex.com/avatar/4892/cea6/473521_normal.png?m=1779008813", "avatar_large": "https://cdn.v2ex.com/avatar/4892/cea6/473521_large.png?m=1779008813", "created": 1583112090, "last_modified": 1779008813, "pro": 0}, "last_reply_by": "Tory12138", "last_touched": 1785585455, "title": "无语，县城的健身房早上九点就爆满。真服了", "url": "https://www.v2ex.com/t/1231388", "created": 1785553019, "deleted": 0, "content": "可能现在是暑假吧，真不该贪便宜选这个健身房。一天到晚全是人。有氧器械根本没有位置，一开始以为就 5 点以后人多。所有时间段都尝试了一遍除了现在最热的 2-3 人少一点。其他时间全是人。钱真白花了😂。比我在上海 99 三个月的社区健身房人都多（这个健身房价格 99 一个月）。感觉小县城的年轻人都来了", "content_rendered": "<p>可能现在是暑假吧，真不该贪便宜选这个健身房。一天到晚全是人。有氧器械根本没有位置，一开始以为就 5 点以后人多。所有时间段都尝试了一遍除了现在最热的 2-3 人少一点。其他时间全是人。钱真白花了😂。比我在上海 99 三个月的社区健身房人都多（这个健身房价格 99 一个月）。感觉小县城的年轻人都来了</p>\n", "last_modified": 1785589631, "replies": 27, "id": 1231388}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240403, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4505, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 63792, "username": "rfo", "url": "https://www.v2ex.com/u/rfo", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "a