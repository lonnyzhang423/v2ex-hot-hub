[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11355, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2417, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 640121, "username": "fengzi666", "url": "https://www.v2ex.com/u/fengzi666", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/faf288fe722838902857226d99134162?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/faf288fe722838902857226d99134162?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/faf288fe722838902857226d99134162?s=73&d=retro", "created": 1690272190, "last_modified": 1785310896, "pro": 0}, "last_reply_by": "TheCoupleTree", "last_touched": 1785531312, "title": "7 月的最后一天，大家说一个这个月一直坚持做的事情。", "url": "https://www.v2ex.com/t/1231229", "created": 1785478968, "deleted": 0, "content": "我先来，周一中午练胸，周二中午练背，周三中午练肩，周四中午练二头三头，周五中午练腿。\r\n周一晚上周四晚上练肩的后束，周三晚上练核心。 练了一个月 体重从 66.7kg 到 65.1kg ，体脂率从 16.3% 到 15.5% 骨骼肌从 29.7kg 到 31.3kg", "content_rendered": "我先来，周一中午练胸，周二中午练背，周三中午练肩，周四中午练二头三头，周五中午练腿。<br />周一晚上周四晚上练肩的后束，周三晚上练核心。 练了一个月 体重从 66.7kg 到 65.1kg ，体脂率从 16.3% 到 15.5% 骨骼肌从 29.7kg 到 31.3kg", "last_modified": 1785478968, "replies": 99, "id": 1231229}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11355, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2417, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 798311, "username": "emmathoermer", "url": "https://www.v2ex.com/u/emmathoermer", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8358/3eff/798311_mini.png?m=1784930360", "avatar_normal": "https://cdn.v2ex.com/avatar/8358/3eff/798311_normal.png?m=1784930360", "avatar_large": "https://cdn.v2ex.com/avatar/8358/3eff/798311_large.png?m=1784930360", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8358/3eff/798311_xlarge.png?m=1784930360", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8358/3eff/798311_xxlarge.png?m=1784930360", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8358/3eff/798311_xxxlarge.png?m=1784930360", "created": 1774834673, "last_modified": 1784930360, "pro": 0}, "last_reply_by": "linyoude", "last_touched": 1785560467, "title": "娃今年 12 岁，沉迷荒野乱斗，求大佬们在我帖子里说一句话劝劝他，我会给他看帖子", "url": "https://www.v2ex.com/t/1231374", "created": 1785544497, "deleted": 0, "content": "我一直在诱导他走 AI 和英语这两大块方向，但是毫无作用。我一直跟他说分数不重要，但是自我学习能力很重要。有时候真的很无奈。求大佬们说几句话劝劝他，他现在对游戏感兴趣，不玩游戏说话都没力气。我想让他明白将来是 AI 时代，提前学 AI 和英文很重要。", "content_rendered": "我一直在诱导他走 AI 和英语这两大块方向，但是毫无作用。我一直跟他说分数不重要，但是自我学习能力很重要。有时候真的很无奈。求大佬们说几句话劝劝他，他现在对游戏感兴趣，不玩游戏说话都没力气。我想让他明白将来是 AI 时代，提前学 AI 和英文很重要。", "last_modified": 1785556318, "replies": 81, "id": 1231374}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72450, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9739, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 443675, "username": "jxl594", "url": "https://www.v2ex.com/u/jxl594", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/fbfb465b1b1e2d0baf8ad70bb7b8327b?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/fbfb465b1b1e2d0baf8ad70bb7b8327b?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/fbfb465b1b1e2d0baf8ad70bb7b8327b?s=73&d=retro", "created": 1569574057, "last_modified": 1569574057, "pro": 0}, "last_reply_by": "Binwalker", "last_touched": 1785561008, "title": "最新的 deepseek-v4-flash 正式版真的有这么强吗？", "url": "https://www.v2ex.com/t/1231255", "created": 1785482721, "deleted": 0, "content": "deepseek-v4-flash 正式版卡在 7 月最后一天发布，看评测数据很强，受不了智谱这种涨价方式，梁圣才是中国 AI 真正的希望", "content_rendered": "<p>deepseek-v4-flash 正式版卡在 7 月最后一天发布，看评测数据很强，受不了智谱这种涨价方式，梁圣才是中国 AI 真正的希望</p>\n", "last_modified": 1785482721, "replies": 81, "id": 1231255}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72450, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9739, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 833545, "username": "grindmule", "url": "https://www.v2ex.com/u/grindmule", "website": "www.video-downloader.ai", "twitter": null, "psn": null, "github": null, "btc": null, "location": "一会深圳 一会长沙 一会佛山", "tagline": "一个人写代码，和一群 Bug 开会", "bio": "独立开发者，正在认真地做一些看起来很简单、做起来全是坑的小工具。负责产品、开发、SEO、运营和客服，偶尔也负责安慰服务器。最近在做 video-downloader.ai，希望让下载视频这件小事，真的只需要几秒钟。欢迎交流独立开发、工具出海和 SEO，也欢迎帮我发现那些我还没遇到的 Bug。", "avatar_mini": "https://cdn.v2ex.com/avatar/703f/85d7/833545_mini.png?m=1785318296", "avatar_normal": "https://cdn.v2ex.com/avatar/703f/85d7/833545_normal.png?m=1785318296", "avatar_large": "https://cdn.v2ex.com/avatar/703f/85d7/833545_large.png?m=1785318296", "avatar_xlarge": "https://cdn.v2ex.com/avatar/703f/85d7/833545_xlarge.png?m=1785318296", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/703f/85d7/833545_xxlarge.png?m=1785318296", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/703f/85d7/833545_xxxlarge.png?m=1785318296", "created": 1785315696, "last_modified": 1785318296, "pro": 0}, "last_reply_by": "niubilewodev", "last_touched": 1785559641, "title": "大家每个月在 AI 工具上花多少钱？我算了下已经 500 -1000 多了", "url": "https://www.v2ex.com/t/1231290", "created": 1785487421, "deleted": 0, "content": "最近的 AI 工具感觉越定越多，单看貌似不多，但是认真算了一下，叠加起来也不少了\r\n\r\n我目前大概是：\r\nChatGPT Plus：20 美元/月\r\nClaude/Gemini：20 美元左右/月\r\nAI 编程工具：10-30 美元左右/月\r\nAPI 和其他零散工具：10 ～ 50 美元/月\r\n这些加起来，每个月也是快小 100 美元了，一个月折合人民币多的时候一千多了。\r\n\r\n这些工具也不是每个都能用满额，也不是都不可替代，但是偶尔确实有需要使用；有时候觉得模型能力差别没那么大，真正让我不想退订的，反而是使用习惯、上下文、编程工作流和响应速度。\r\n\r\n所以比较好奇大家目前是啥情况？\r\n\r\n每个月在 AI 、API 这些地方要花掉多少预算？\r\n\r\n不知道我这个属于正常水平，还是有些浪费呢？", "content_rendered": "<p>最近的 AI 工具感觉越定越多，单看貌似不多，但是认真算了一下，叠加起来也不少了</p>\n<p>我目前大概是：\nChatGPT Plus：20 美元/月\nClaude/Gemini：20 美元左右/月\nAI 编程工具：10-30 美元左右/月\nAPI 和其他零散工具：10 ～ 50 美元/月\n这些加起来，每个月也是快小 100 美元了，一个月折合人民币多的时候一千多了。</p>\n<p>这些工具也不是每个都能用满额，也不是都不可替代，但是偶尔确实有需要使用；有时候觉得模型能力差别没那么大，真正让我不想退订的，反而是使用习惯、上下文、编程工作流和响应速度。</p>\n<p>所以比较好奇大家目前是啥情况？</p>\n<p>每个月在 AI 、API 这些地方要花掉多少预算？</p>\n<p>不知道我这个属于正常水平，还是有些浪费呢？</p>\n", "last_modified": 1785487421, "replies": 66, "id": 1231290}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 46783, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6340, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 398633, "username": "jadehare", "url": "https://www.v2ex.com/u/jadehare", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/c98db88a0793a8b6839d9d93e09b5835?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/c98db88a0793a8b6839d9d93e09b5835?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/c98db88a0793a8b6839d9d93e09b5835?s=73&d=retro", "created": 1554368855, "last_modified": 1554368855, "pro": 0}, "last_reply_by": "genesislive", "last_touched": 1785517684, "title": "快进入梁圣阶段了， DeepSeek-V4-Flash 正式版上线！", "url": "https://www.v2ex.com/t/1231216", "created": 1785477461, "deleted": 0, "content": "", "content_rendered": "", "last_modified": 1785477461, "replies": 62, "id": 1231216}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240393, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4505, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 646576, "username": "JShen", "url": "https://www.v2ex.com/u/JShen", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/74d6dff540e6ac840e99075d1bc571dd?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/74d6dff540e6ac840e99075d1bc571dd?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/74d6dff540e6ac840e99075d1bc571dd?s=73&d=retro", "created": 1693555994, "last_modified": 1761889509, "pro": 0}, "last_reply_by": "wpei", "last_touched": 1785520124, "title": "LOL 怀旧服近期悄然上线，而我的青春却不在了。", "url": "https://www.v2ex.com/t/1231233", "created": 1785479510, "deleted": 0, "content": "近期看到《 LOL 》怀旧服上线，心里一下子涌出了很多感慨。\r\n\r\n我是高二（ 2012 年）开始接触《英雄联盟》的。那时候其实一直在玩 CF ，但网吧里几乎所有同学都在玩 LOL 。我就让高中室友带着我玩了几局，结果一发不可收拾。\r\n\r\n后来，高中后半程的生活几乎就在**学习和网吧**之间来回切换。一半时间学习，一半时间上网，每周包夜两三次，而且这种状态一直持续到了高考。\r\n\r\n所以成绩一直中等偏下，最后考了一所普通二本。\r\n\r\n现在回头看，当年确实没有把学习放在第一位，但我好像也没有后悔过。\r\n\r\n我们县重点高中的管理属于放养式。学生可以在校外租房住，晚上没有老师查寝，只要校门关了别回来就行。\r\n\r\n那时候我们经常在网吧玩到凌晨三四点，然后跑到同学租的房子里睡觉。\r\n\r\n我印象最深的一次，是我们班六七个人一起包夜。结果第二天集体睡过头了。最后还是另一个同学一路跑到我们的“窝点”，把我们一个个喊起来去上早自习。\r\n\r\n我现在都还记得，当时整个人是被吓醒的，睁眼第一反应就是：“完了！”\r\n\r\n紧接着就看到几个人一边穿衣服一边往外冲，疯狂朝学校跑，恨不得脚底生风。\r\n\r\n现在想起来，真的是一段又荒唐、又好笑的青春。\r\n\r\n那时候觉得未来遥不可及，总想着赶紧长大。可真正长大以后才发现，最怀念的，偏偏就是那个时候。\r\n\r\n如今，我已经成家了，孩子也出生了。\r\n\r\n我还是喜欢玩游戏，只是《英雄联盟》已经很久没有打开过。\r\n\r\n今天早上出门前，我提前把怀旧服下载好了。\r\n\r\n下班以后，我想进去看看，体验一下那个最纯粹的 LOL 。\r\n\r\n那里没有复杂的机制，没有那么多花里胡哨的内容。\r\n\r\n那里有我的青春，有一起开黑的同学，有已经很久没有联系的朋友，也有那个会为了赢下一把排位而激动一整晚的自己。\r\n\r\n现在的我，可以轻轻松松付得起网费，也买得起曾经梦寐以求的电脑和外设。机器的配置越来越高，帧数越来越稳。\r\n\r\n只是，当年那个反应飞快、能连续鏖战几个小时的脑子，却再也回不来了。\r\n\r\n或许怀旧服真正怀念的，从来都不是游戏。\r\n\r\n而是那个会为了一个五杀欢呼、为了一场团战熬夜、为了兄弟一句“再来一把”就能玩到天亮的自己。\r\n\r\n青春不会重来，但总有一些东西，会在登录游戏的那一刻，悄悄回来。", "content_rendered": "<p>近期看到《 LOL 》怀旧服上线，心里一下子涌出了很多感慨。</p>\n<p>我是高二（ 2012 年）开始接触《英雄联盟》的。那时候其实一直在玩 CF ，但网吧里几乎所有同学都在玩 LOL 。我就让高中室友带着我玩了几局，结果一发不可收拾。</p>\n<p>后来，高中后半程的生活几乎就在<strong>学习和网吧</strong>之间来回切换。一半时间学习，一半时间上网，每周包夜两三次，而且这种状态一直持续到了高考。</p>\n<p>所以成绩一直中等偏下，最后考了一所普通二本。</p>\n<p>现在回头看，当年确实没有把学习放在第一位，但我好像也没有后悔过。</p>\n<p>我们县重点高中的管理属于放养式。学生可以在校外租房住，晚上没有老师查寝，只要校门关了别回来就行。</p>\n<p>那时候我们经常在网吧玩到凌晨三四点，然后跑到同学租的房子里睡觉。</p>\n<p>我印象最深的一次，是我们班六七个人一起包夜。结果第二天集体睡过头了。最后还是另一个同学一路跑到我们的“窝点”，把我们一个个喊起来去上早自习。</p>\n<p>我现在都还记得，当时整个人是被吓醒的，睁眼第一反应就是：“完了！”</p>\n<p>紧接着就看到几个人一边穿衣服一边往外冲，疯狂朝学校跑，恨不得脚底生风。</p>\n<p>现在想起来，真的是一段又荒唐、又好笑的青春。</p>\n<p>那时候觉得未来遥不可及，总想着赶紧长大。可真正长大以后才发现，最怀念的，偏偏就是那个时候。</p>\n<p>如今，我已经成家了，孩子也出生了。</p>\n<p>我还是喜欢玩游戏，只是《英雄联盟》已经很久没有打开过。</p>\n<p>今天早上出门前，我提前把怀旧服下载好了。</p>\n<p>下班以后，我想进去看看，体验一下那个最纯粹的 LOL 。</p>\n<p>那里没有复杂的机制，没有那么多花里胡哨的内容。</p>\n<p>那里有我的青春，有一起开黑的同学，有已经很久没有联系的朋友，也有那个会为了赢下一把排位而激动一整晚的自己。</p>\n<p>现在的我，可以轻轻松松付得起网费，也买得起曾经梦寐以求的电脑和外设。机器的配置越来越高，帧数越来越稳。</p>\n<p>只是，当年那个反应飞快、能连续鏖战几个小时的脑子，却再也回不来了。</p>\n<p>或许怀旧服真正怀念的，从来都不是游戏。</p>\n<p>而是那个会为了一个五杀欢呼、为了一场团战熬夜、为了兄弟一句“再来一把”就能玩到天亮的自己。</p>\n<p>青春不会重来，但总有一些东西，会在登录游戏的那一刻，悄悄回来。</p>\n", "last_modified": 1785479510, "replies": 60, "id": 1231233}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11355, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2417, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 685141, "username": "zbm0711", "url": "https://www.v2ex.com/u/zbm0711", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/5aa6/07c2/685141_mini.png?m=1715392813", "avatar_normal": "https://cdn.v2ex.com/avatar/5aa6/07c2/685141_normal.png?m=1715392813", "avatar_large": "https://cdn.v2ex.com/avatar/5aa6/07c2/685141_large.png?m=1715392813", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5aa6/07c2/685141_xlarge.png?m=1715392813", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5aa6/07c2/685141_xxlarge.png?m=1715392813", "created": 1713142621, "last_modified": 1715392813, "pro": 0}, "last_reply_by": "keaidejim", "last_touched": 1785519404, "title": "兄弟们，从什么时候开始打游戏无法获得快乐了？", "url": "https://www.v2ex.com/t/1231224", "created": 178547