[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11758, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2483, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 543246, "username": "icoolboy", "url": "https://www.v2ex.com/u/icoolboy", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/b86f/adbb/543246_mini.png?m=1760231269", "avatar_normal": "https://cdn.v2ex.com/avatar/b86f/adbb/543246_normal.png?m=1760231269", "avatar_large": "https://cdn.v2ex.com/avatar/b86f/adbb/543246_large.png?m=1760231269", "avatar_xlarge": "https://cdn.v2ex.com/avatar/b86f/adbb/543246_xlarge.png?m=1760231269", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/b86f/adbb/543246_xxlarge.png?m=1760231269", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/b86f/adbb/543246_xxxlarge.png?m=1760231269", "created": 1619005604, "last_modified": 1760231269, "pro": 0}, "last_reply_by": "hs444", "last_touched": 1790558033, "title": "女朋友说“在你这里很没有气氛”，性格沉闷的我该怎么补救？", "url": "https://www.v2ex.com/t/1244983", "created": 1790473164, "deleted": 0, "content": "认真求助大家，最近心里特别受挫。中秋节那天，女朋友在外地奔波，傍晚才赶回本地，第二天一早还要去上课，很辛苦。晚上聊天我像往常一样问她吃什么、洗澡了没，结果她委屈地说：“今天都快过完了，你都没跟我说节日快乐，在你这很没有气氛，家人一大早就给我发了。”其实中秋那天，我翻朋友圈看到其他人的动态都特别有节日氛围，聚会、赏月、过得热热闹闹。反观我自己，平时生活极简、圈子小、不爱社交，整个人沉闷又无趣，只会在家打 dota 。看到大家那么有气氛，再对比自己，心里本能地自卑和落差。我确实太糙、太缺少仪式感了，想关心人一开口却总像查户口。我很想为了她改变，但不知道对于我这种天生沉闷、不擅长社交的性格，平时该怎么自然地给女朋友提供仪式感和情绪价值？重要节日不在身边时，大家一般怎么做能让对方觉得被在乎？求过来人指点，谢谢！", "content_rendered": "<p>认真求助大家，最近心里特别受挫。中秋节那天，女朋友在外地奔波，傍晚才赶回本地，第二天一早还要去上课，很辛苦。晚上聊天我像往常一样问她吃什么、洗澡了没，结果她委屈地说：“今天都快过完了，你都没跟我说节日快乐，在你这很没有气氛，家人一大早就给我发了。”其实中秋那天，我翻朋友圈看到其他人的动态都特别有节日氛围，聚会、赏月、过得热热闹闹。反观我自己，平时生活极简、圈子小、不爱社交，整个人沉闷又无趣，只会在家打 dota 。看到大家那么有气氛，再对比自己，心里本能地自卑和落差。我确实太糙、太缺少仪式感了，想关心人一开口却总像查户口。我很想为了她改变，但不知道对于我这种天生沉闷、不擅长社交的性格，平时该怎么自然地给女朋友提供仪式感和情绪价值？重要节日不在身边时，大家一般怎么做能让对方觉得被在乎？求过来人指点，谢谢！</p>\n", "last_modified": 1790475896, "replies": 95, "id": 1244983}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4914/42df/1203_large.png?m=1774036775", "name": "agent", "avatar_normal": "https://cdn.v2ex.com/navatar/4914/42df/1203_normal.png?m=1774036775", "title": "AI Agent 智能体", "url": "https://www.v2ex.com/go/agent", "topics": 276, "footer": "## 节点赞助商\r\n- [KIE AI]( https://kie.ai?ref=943410ffac83c9740ac67a6bdbc476b4)\r\n- [ClawDaddy]( https://clawdaddy.run/)", "header": "分享 AI Agent / Skills / MCP / Tool Use / Workflow 的技术与应用。", "title_alternative": "AI Agent 智能体", "avatar_mini": "https://cdn.v2ex.com/navatar/4914/42df/1203_mini.png?m=1774036775", "stars": 129, "founder_id": 23327, "aliases": [], "root": false, "id": 1203, "parent_node_name": null}, "member": {"id": 687243, "username": "Saika00", "url": "https://www.v2ex.com/u/Saika00", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/979c/91e4/687243_mini.png?m=1732160383", "avatar_normal": "https://cdn.v2ex.com/avatar/979c/91e4/687243_normal.png?m=1732160383", "avatar_large": "https://cdn.v2ex.com/avatar/979c/91e4/687243_large.png?m=1732160383", "avatar_xlarge": "https://cdn.v2ex.com/avatar/979c/91e4/687243_xlarge.png?m=1732160383", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/979c/91e4/687243_xxlarge.png?m=1732160383", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/979c/91e4/687243_xxxlarge.png?m=1732160383", "created": 1714267669, "last_modified": 1732160383, "pro": 0}, "last_reply_by": "gelan233", "last_touched": 1790557821, "title": "muse 注册非常丝滑，正常注册就行！", "url": "https://www.v2ex.com/t/1245031", "created": 1790491640, "deleted": 0, "content": "分析一些经验：\r\n\r\n1 、Facebook 账号直接注册，就连电话都不需要验证，丝滑～\r\n\r\n2 、美区全局\r\n\r\n大家一起来薅羊毛，我的邀请码：BMIKGH", "content_rendered": "分析一些经验：<br /><br />1 、Facebook 账号直接注册，就连电话都不需要验证，丝滑～<br /><br />2 、美区全局<br /><br />大家一起来薅羊毛，我的邀请码：BMIKGH", "last_modified": 1790491640, "replies": 51, "id": 1245031}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73603, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9790, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 808942, "username": "LeBronJames1996", "url": "https://www.v2ex.com/u/LeBronJames1996", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/10a1833321c59bf33c0b2eae130a2fe8?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/10a1833321c59bf33c0b2eae130a2fe8?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/10a1833321c59bf33c0b2eae130a2fe8?s=73&d=retro", "created": 1777980872, "last_modified": 1777980872, "pro": 0}, "last_reply_by": "Smipto", "last_touched": 1790557900, "title": "看了影视飓风 Tim 的创业视频，聊聊我的看法", "url": "https://www.v2ex.com/t/1245104", "created": 1790533076, "deleted": 0, "content": "看了影视飓风 Tim 发了一个讲自己创业的视频，他给年轻人的建议是「先发内容，再考虑商业模式」。\r\n\r\n之前上班也积累了不少，今年没上班了，收入还算稳定，聊聊我的看法\r\n\r\n1 、在没有产品的时候\r\n\r\n找对标或者先发内容都是一种找方向的办法；在没有方向的时候，要么对标别人的路径去干，要么自己走走看摸索摸索。\r\n\r\n我的看法：只要把事干了，成为一个有价值的人，给别人带来价值，都能找到自己的道路。\r\n\r\n2 、在有产品的时候\r\n\r\n对于没有创作经验的人来说，缺乏产品是个枷锁 —— 因为不知道自己该发什么。\r\n\r\n产品对内容的限制真的是一个天大的问题：\r\n\r\n因为你需要面向公众表现出特定的形象\r\n因为你需要卖掉你的产品\r\n因为你需要反复强调某个领域的话题\r\n\r\n我的看法：只要有稳定、持续的收入，还是建议走垂直赛道", "content_rendered": "<p>看了影视飓风 Tim 发了一个讲自己创业的视频，他给年轻人的建议是「先发内容，再考虑商业模式」。</p>\n<p>之前上班也积累了不少，今年没上班了，收入还算稳定，聊聊我的看法</p>\n<p>1 、在没有产品的时候</p>\n<p>找对标或者先发内容都是一种找方向的办法；在没有方向的时候，要么对标别人的路径去干，要么自己走走看摸索摸索。</p>\n<p>我的看法：只要把事干了，成为一个有价值的人，给别人带来价值，都能找到自己的道路。</p>\n<p>2 、在有产品的时候</p>\n<p>对于没有创作经验的人来说，缺乏产品是个枷锁 —— 因为不知道自己该发什么。</p>\n<p>产品对内容的限制真的是一个天大的问题：</p>\n<p>因为你需要面向公众表现出特定的形象\n因为你需要卖掉你的产品\n因为你需要反复强调某个领域的话题</p>\n<p>我的看法：只要有稳定、持续的收入，还是建议走垂直赛道</p>\n", "last_modified": 1790533076, "replies": 37, "id": 1245104}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/3b5d/ca50/819_large.png?m=1633251402", "name": "watch", "avatar_normal": "https://cdn.v2ex.com/navatar/3b5d/ca50/819_normal.png?m=1633251402", "title": " WATCH", "url": "https://www.v2ex.com/go/watch", "topics": 1516, "footer": "", "header": "<a href=\"/go/apple\">Apple</a> 公司设计的智能手表产品", "title_alternative": " WATCH", "avatar_mini": "https://cdn.v2ex.com/navatar/3b5d/ca50/819_mini.png?m=1633251402", "stars": 593, "founder_id": 0, "aliases": [], "root": false, "id": 819, "parent_node_name": "apple"}, "member": {"id": 232650, "username": "qwertyyb", "url": "https://www.v2ex.com/u/qwertyyb", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/d252/312c/232650_mini.png?m=1602564756", "avatar_normal": "https://cdn.v2ex.com/avatar/d252/312c/232650_normal.png?m=1602564756", "avatar_large": "https://cdn.v2ex.com/avatar/d252/312c/232650_large.png?m=1602564756", "created": 1495777598, "last_modified": 1602564756, "pro": 0}, "last_reply_by": "explorerproxy", "last_touched": 1790558124, "title": "新款 Apple Watch 的设计太离谱了吧", "url": "https://www.v2ex.com/t/1245062", "created": 1790511580, "deleted": 0, "content": "欲购入 AW ，感受老去的时光，本眼红国行有国补，纠结于无快充，但算了笔账，发现港版相比国行贵 100 多感觉可以接受，于是下定前去体验店摸了一把，非常失望。\r\n\r\nS12 的大圆角宽边框是认真的吗？\r\n一天一充但是搭配官方表带却没有一个取戴方便的？", "content_rendered": "<p>欲购入 AW ，感受老去的时光，本眼红国行有国补，纠结于无快充，但算了笔账，发现港版相比国行贵 100 多感觉可以接受，于是下定前去体验店摸了一把，非常失望。</p>\n<p>S12 的大圆角宽边框是认真的吗？\n一天一充但是搭配官方表带却没有一个取戴方便的？</p>\n", "last_modified": 1790512031, "replies": 32, "id": 1245062}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24454, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3744, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 560286, "username": "hayden007", "url": "https://www.v2ex.com/u/hayden007", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/c1c74814ddfa28f13400acb7f07a262e?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/c1c74814ddfa28f13400acb7f07a262e?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/c1c74814ddfa28f13400acb7f07a262e?s=73&d=retro", "created": 1635729998, "last_modified": 1635729998, "pro": 0}, "last_reply_by": "MoeDisk", "last_touched": 1790528430, "title": "离职半年了， AI 对工作流程的影响有多大？想回去上班", "url": "https://www.v2ex.com/t/1245020", "created": 1790486307, "deleted": 0, "content": "我是一个程序员，半年前离职做独立开发。上架了 4 个 APP ，但是卖不出去，半年白折腾了。\r\n挣不到钱，想回去上班了。我之前擅长的 Java 、Python 、golang ，还有一些技术像数据库、缓存、并发等这些还有用？\r\n还是现在都已经 ALL in AI 了，没人在意这些技术栈了", "content_rendered": "<p>我是一个程序员，半年前离职做独立开发。上架了 4 个 APP ，但是卖不出去，半年白折腾了。\n挣不到钱，想回去上班了。我之前擅长的 Java 、Python 、golang ，还有一些技术像数据库、缓存、并发等这些还有用？\n还是现在都已经 ALL in AI 了，没人在意这些技术栈了</p>\n", "last_modified": 1790486307, "replies": 21, "id": 1245020}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a3c6/5c29/108_large.png?m=1691642161", "name": "bb", "avatar_normal": "https://cdn.v2ex.com/navatar/a3c6/5c29/108_normal.png?m=1691642161", "title": "宽带症候群", "url": "https://www.v2ex.com/go/bb", "topics": 19077, "footer": "", "header": "网速很重要。比快更快。", "title_alternative": "Broadband Symptom Complex", "avatar_mini": "https://cdn.v2ex.com/navatar/a3c6/5c29/108_mini.png?m=1691642161", "stars": 8326, "founder_id": 0, "aliases": [], "root": false, "id": 108, "parent_node_name": "geek"}, "member": {"id": 84374, "username": "chenchuangfeng", "url": "https://www.v2ex.com/u/chenchuangfeng", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/05f2269c556c739418be94176c414cd2?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/05f2269c556c739418be94176c414cd2?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/05f2269c556c739418be94176c414cd2?s=73&d=retro", "created": 1417258765, "last_modified": 1790492844, "pro": 0}, "last_reply_by": "rsyjjsn", "last_touched": 1790527435, "title": "求家庭组网方案建议", "url": "https://www.v2ex.com/t/1245037", "created": 1790493331, "deleted": 0, "content": "https://i.imgur.com/a/gjhdJQt.png\r\n\r\n求家庭组网方案建议。\r\n\r\n目前新房子 125 方已经设计好了网线布线：\r\n1. 弱电箱位于门口。\r\n2. 鞋柜处有一个 NAS 的网口。\r\n3. 4 个房间以及客厅均有网口。\r\n\r\n我的需求是全屋能够支持 NAS 的高速传输，目前宽是 1000m ，未来如果合适的话 也会在网上升级网络。房间网口 3 ，这里是书房，平时会在这里办公，对网速的质量要求比较高，主卧的要求也是比较高。主卧是网口 5 。\r\n之前想用 TP-Link 的无线 AP 来支持，但整套下来，每个房间的网口都换成 TP-Link 的面板，预算大概需要 3800~4000 元左右，感觉这个预算还是比较高的。\r\n\r\n在此请求各位大佬们：\r\n1. 花 3800 多来布这个网划算吗？\r\n2. 有没有更好的方案，或者同等性能下更好、更便宜的方案可以推荐一下？", "content_rendered": "<a target=\"_blank\" href=\"https://i.imgur.com/a/gjhdJQt.png\" rel=\"nofollow noopener\">https://i.imgur.com/a/gjhdJQt.png</a><br /><br />求家庭组网方案建议。<br /><br />目前新房子 125 方已经设计好了网线布线：<br />1. 弱电箱位于门口。<br />2. 鞋柜处有一个 NAS 的网口。<br />3. 4 个房间以及客厅均有网口。<br /><br />我的需求是全屋能够支持 NAS 的高速传输，目前宽是 1000m ，未来如果合适的话 也会在网上升级网络。房间网口 3 ，这里是书房，平时会在这里办公，对网速的质量要求比较高，主卧的要求也是比较高。主卧是网口 5 。<br />之前想用 TP-Link 的无线 AP 来支持，但整套下来，每个房间的网口都换成 TP-Link 的面板，预算大概需要 3800~4000 元左右，感觉这个预算还是比较高的。<br /><br />在此请求各位大佬们：<br />1. 花 3800 多来布这个网划算吗？<br />2. 有没有更好的方案，或者同等性能下更好、更便宜的方案可以推荐一下？", "last_modified": 1790493826, "replies": 21, "id": 1245037}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_large.png?m=1630643913", "name": "apple", "avatar_normal": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_normal.png?m=1630643913", "title": "Apple", "url": "https://www.v2ex.com/go/apple", "topics": 31241, "footer": "", "header": "设计了 <a href=\"/go/watch\">Apple Watch</a>，<a href=\"/go/ipad\">iPad</a>，<a href=\"/go/iphone\">iPhone</a>，<a href=\"/go/imac\">iMac</a> 及 <a href=\"/go/mbp\">MacBook Pro</a> 等电子产品的美国公司。", "title_alternative": "Apple", "avatar_mini": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_mini.png?m=1630643913", "stars": 3357, "founder_id": 0, "aliases": [], "root": false, "id": 184, "parent_node_name": "hardware"}, "member": {"id": 274933, "username": "yyluxe", "url": "https://www.v2ex.com/u/yyluxe", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/473deb4b03dbd419eac156ee229472e5?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/473deb4b03dbd419eac156ee229472e5?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/473deb4b03dbd419eac156ee229472e5?s=73&d=retro", "created": 1513413763, "last_modified": 1513413763, "pro": 0}, "last_reply_by": "howencilx", "last_touched": 1790530224, "title": "主账号都用的国区还是用外区 apple id??", "url": "https://www.v2ex.com/t/1245059", "created": 1790510611, "deleted": 0, "content": "主账号用外区 apple id 的话   有什么注意事项么各位大佬", "content_rendered": "主账号用外区 apple id 的话   有什么注意事项么各位大佬", "last_modified": 1790510611, "replies": 16, "id": 1245059}]