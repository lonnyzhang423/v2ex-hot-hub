[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72899, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9765, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 26655, "username": "287854442", "url": "https://www.v2ex.com/u/287854442", "website": "http://www.xueshi.me", "twitter": "XueshiQiao", "psn": "", "github": "XueshiQiao", "btc": "", "location": "北京", "tagline": "观云卷云舒，赏花开花落", "bio": "小红书号：4690373435 https://www.xiaohongshu.com/user/profile/65897ec300000000220147bf", "avatar_mini": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_mini.png?m=1785848289", "avatar_normal": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_normal.png?m=1785848289", "avatar_large": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_large.png?m=1785848289", "created": 1347442180, "last_modified": 1785848289, "pro": 0}, "last_reply_by": "levelworm", "last_touched": 1787506490, "title": "大家现在日常/办公中，语音输入占比大概有多少？", "url": "https://www.v2ex.com/t/1236583", "created": 1787476342, "deleted": 0, "content": "大概 7 个月前，我做了一个预言，说 1 年之后语音输入将会成为主流，现在半年都过去了，我说一下我现在情况\r\n\r\n不得不说，现在语音转文字准确率越来越高，所以现在在手机上几乎不怎么打字了（除非敲一些命令），各种聊天 发帖子 或者是 跟 agent 协同等，基本上都是靠语音转文字来输入了\r\n\r\n电脑上也是如此，基本上 80 ～ 90% 的场景吧，都是语音转文字来进行输入\r\n\r\n办公场景可能会稍低一些，有时候不方便说的还是靠打字，大部分情况下都还好。\r\n\r\n想看看大家的占比是怎么样的。", "content_rendered": "<p>大概 7 个月前，我做了一个预言，说 1 年之后语音输入将会成为主流，现在半年都过去了，我说一下我现在情况</p>\n<p>不得不说，现在语音转文字准确率越来越高，所以现在在手机上几乎不怎么打字了（除非敲一些命令），各种聊天 发帖子 或者是 跟 agent 协同等，基本上都是靠语音转文字来输入了</p>\n<p>电脑上也是如此，基本上 80 ～ 90% 的场景吧，都是语音转文字来进行输入</p>\n<p>办公场景可能会稍低一些，有时候不方便说的还是靠打字，大部分情况下都还好。</p>\n<p>想看看大家的占比是怎么样的。</p>\n", "last_modified": 1787476342, "replies": 65, "id": 1236583}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/1fc2/1400/864_large.png?m=1778522847", "name": "promotions", "avatar_normal": "https://cdn.v2ex.com/navatar/1fc2/1400/864_normal.png?m=1778522847", "title": "推广", "url": "https://www.v2ex.com/go/promotions", "topics": 13624, "footer": "", "header": "来自厂商的推广活动类主题，会被归类到这个节点。希望有情怀的产商们在发布推广内容时，主动选择发布到本节点下。点击 <a href=\"/help/node\">这里</a> 阅读 V2EX 的节点使用指南。", "title_alternative": "Promotions", "avatar_mini": "https://cdn.v2ex.com/navatar/1fc2/1400/864_mini.png?m=1778522847", "stars": 1452, "founder_id": 0, "aliases": [], "root": false, "id": 864, "parent_node_name": ""}, "member": {"id": 523153, "username": "mrergouwang666", "url": "https://www.v2ex.com/u/mrergouwang666", "website": "https://buildorskip.dev/", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/560156422f6cd4318acece8fcb5e9884?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/560156422f6cd4318acece8fcb5e9884?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/560156422f6cd4318acece8fcb5e9884?s=73&d=retro", "created": 1607557290, "last_modified": 1787456408, "pro": 0}, "last_reply_by": "mrergouwang666", "last_touched": 1786634396, "title": "我把全网在赚钱的站点变成了一张榜单", "url": "https://www.v2ex.com/t/1236529", "created": 1787456430, "deleted": 0, "content": "以前找产品方向，我会在 Product Hunt 、X 、Reddit 收藏一大堆链接。\r\n\r\n但最后还是回答不了一个问题：\r\n\r\n这些产品只是有人讨论，还是真的在赚钱？\r\n\r\n所以我做了 Build or Skip （ buildorskip.dev)。\r\n\r\n现在站内收录了 14 万+ 在赚钱的产品，可以查看估算订单、增长状态、趋势、DR 、产品分类、定价、收入模式、广告平台和目标用户。\r\n\r\n现在我只需要看那个产品我能打得过，然后“先抄再超”就行了。\r\n\r\n![buildorskip.dev]( https://i.imgs.ovh/2026/08/23/7f8068e9064d0736490af3da77382199.png)\r\n\r\n![buildorskip.dev]( https://i.imgs.ovh/2026/08/23/4ff0a39115165f61d83b47ebd1a8cc6d.png)", "content_rendered": "<p>以前找产品方向，我会在 Product Hunt 、X 、Reddit 收藏一大堆链接。</p>\n<p>但最后还是回答不了一个问题：</p>\n<p>这些产品只是有人讨论，还是真的在赚钱？</p>\n<p>所以我做了 Build or Skip （ buildorskip.dev)。</p>\n<p>现在站内收录了 14 万+ 在赚钱的产品，可以查看估算订单、增长状态、趋势、DR 、产品分类、定价、收入模式、广告平台和目标用户。</p>\n<p>现在我只需要看那个产品我能打得过，然后“先抄再超”就行了。</p>\n<p><img alt=\"buildorskip.dev\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgs.ovh/2026/08/23/7f8068e9064d0736490af3da77382199.png\"/></p>\n<p><img alt=\"buildorskip.dev\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgs.ovh/2026/08/23/4ff0a39115165f61d83b47ebd1a8cc6d.png\"/></p>\n", "last_modified": 1787498438, "replies": 48, "id": 1236529}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240990, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4509, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 84957, "username": "metrue", "url": "https://www.v2ex.com/u/metrue", "website": "https://blog.minghe.me", "twitter": "_metrue", "psn": "", "github": "metrue", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/043a/5783/84957_mini.png?m=1785968845", "avatar_normal": "https://cdn.v2ex.com/avatar/043a/5783/84957_normal.png?m=1785968845", "avatar_large": "https://cdn.v2ex.com/avatar/043a/5783/84957_large.png?m=1785968845", "avatar_xlarge": "https://cdn.v2ex.com/avatar/043a/5783/84957_xlarge.png?m=1785968845", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/043a/5783/84957_xxlarge.png?m=1785968845", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/043a/5783/84957_xxxlarge.png?m=1785968845", "created": 1417578487, "last_modified": 1785968845, "pro": 0}, "last_reply_by": "ichou", "last_touched": 1787508625, "title": "2026 年键盘求推荐", "url": "https://www.v2ex.com/t/1236534", "created": 1787459357, "deleted": 0, "content": "用了十年的 HHKB ，最近时不时有各种小问题，大家有推荐的键盘么？", "content_rendered": "用了十年的 HHKB ，最近时不时有各种小问题，大家有推荐的键盘么？", "last_modified": 1787459357, "replies": 44, "id": 1236534}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240990, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4509, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 655652, "username": "YaD2x", "url": "https://www.v2ex.com/u/YaD2x", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/a2fe32cd7e7f224016ee299e235f7d40?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/a2fe32cd7e7f224016ee299e235f7d40?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/a2fe32cd7e7f224016ee299e235f7d40?s=73&d=retro", "created": 1697812766, "last_modified": 1766556407, "pro": 0}, "last_reply_by": "z7356995", "last_touched": 1787512312, "title": "关于楼上渗水到楼下的问题，请友友们提供一些建议。", "url": "https://www.v2ex.com/t/1236528", "created": 1787456376, "deleted": 0, "content": "首先，我是楼上的住户。\r\n\r\n楼下住户最近装修，拆了吊顶后发现楼上卫生间淋浴间地漏附近有水渗下去，周围有明显被水浸泡的痕迹。\r\n\r\n昨天咸鱼找师傅过来看了一下，给我一个方案。似乎是用一种液体胶水混合水之后覆盖在瓷砖上，然后让液体顺着有缝隙的地方流进去，等到干固之后就能够把缝隙填充，解决渗水的问题。\r\n\r\n不知道这个方案是不现在比较主流的一种方法，关于费用，他报价在 2000 元左右。\r\n\r\n友友们有没有过类似的经历呀？\r\n\r\n关于这个价格和方案靠谱吗？\r\n\r\n拍的一张图片\r\n\r\n![0cb696fb86fd4a8265d26e8a82a63d83.jpg]( https://s3.bmp.ovh/2026/08/23/QxzuUlZP.jpg)", "content_rendered": "<p>首先，我是楼上的住户。</p>\n<p>楼下住户最近装修，拆了吊顶后发现楼上卫生间淋浴间地漏附近有水渗下去，周围有明显被水浸泡的痕迹。</p>\n<p>昨天咸鱼找师傅过来看了一下，给我一个方案。似乎是用一种液体胶水混合水之后覆盖在瓷砖上，然后让液体顺着有缝隙的地方流进去，等到干固之后就能够把缝隙填充，解决渗水的问题。</p>\n<p>不知道这个方案是不现在比较主流的一种方法，关于费用，他报价在 2000 元左右。</p>\n<p>友友们有没有过类似的经历呀？</p>\n<p>关于这个价格和方案靠谱吗？</p>\n<p>拍的一张图片</p>\n<p><img alt=\"0cb696fb86fd4a8265d26e8a82a63d83.jpg\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s3.bmp.ovh/2026/08/23/QxzuUlZP.jpg\"/></p>\n", "last_modified": 1787456376, "replies": 37, "id": 1236528}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240990, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4509, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 357200, "username": "yfixx", "url": "https://www.v2ex.com/u/yfixx", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/6138b0dbd40e3fc92a5321892282dd7a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/6138b0dbd40e3fc92a5321892282dd7a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/6138b0dbd40e3fc92a5321892282dd7a?s=73&d=retro", "created": 1539934775, "last_modified": 1787363967, "pro": 0}, "last_reply_by": "ktyang", "last_touched": 1787500411, "title": "你们 vibe coding 的时候更喜欢用 TUI 还是 GUI ?", "url": "https://www.v2ex.com/t/1236538", "created": 1787460800, "deleted": 0, "content": "你们氛围编程是喜欢用 tui 还是 gui ，或者哪种模式更有优势一些呢？", "content_rendered": "<p>你们氛围编程是喜欢用 tui 还是 gui ，或者哪种模式更有优势一些呢？</p>\n", "last_modified": 178746