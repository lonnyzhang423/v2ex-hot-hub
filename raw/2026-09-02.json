[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_large.png?m=1643940920", "name": "ev", "avatar_normal": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_normal.png?m=1643940920", "title": "电动汽车", "url": "https://www.v2ex.com/go/ev", "topics": 472, "footer": "", "header": "", "title_alternative": "EV", "avatar_mini": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_mini.png?m=1643940920", "stars": 464, "founder_id": 0, "aliases": [], "root": false, "id": 1034, "parent_node_name": "tech"}, "member": {"id": 698792, "username": "bunai", "url": "https://www.v2ex.com/u/bunai", "website": "https://tps.bunai.cc", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/668c/46b7/698792_mini.png?m=1786500068", "avatar_normal": "https://cdn.v2ex.com/avatar/668c/46b7/698792_normal.png?m=1786500068", "avatar_large": "https://cdn.v2ex.com/avatar/668c/46b7/698792_large.png?m=1786500068", "avatar_xlarge": "https://cdn.v2ex.com/avatar/668c/46b7/698792_xlarge.png?m=1786500068", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/668c/46b7/698792_xxlarge.png?m=1786500068", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/668c/46b7/698792_xxxlarge.png?m=1786500068", "created": 1719794770, "last_modified": 1786500068, "pro": 0}, "last_reply_by": "herozzm", "last_touched": 1788313410, "title": "20-25 万电车推荐，油车也可以", "url": "https://www.v2ex.com/t/1238590", "created": 1788230697, "deleted": 0, "content": "### 比较看了后比较中意得\r\n\r\n - 小米 su7\r\n - 小米 yu7\r\n - 方程豹钛 7 ，但是这个不知道哪个版本好点\r\n - 特斯拉\r\n\r\n### 拒绝\r\n\r\n - 理想\r\n \r\n### 大家还有什么推荐的\r\n\r\n - 目前开的是塞车轿车 2021 款\r\n - 个人开车比较野\r\n - tank300 最后得选择吧", "content_rendered": "<h3>比较看了后比较中意得</h3>\n<ul>\n<li>小米 su7</li>\n<li>小米 yu7</li>\n<li>方程豹钛 7 ，但是这个不知道哪个版本好点</li>\n<li>特斯拉</li>\n</ul>\n<h3>拒绝</h3>\n<ul>\n<li>理想</li>\n</ul>\n<h3>大家还有什么推荐的</h3>\n<ul>\n<li>目前开的是塞车轿车 2021 款</li>\n<li>个人开车比较野</li>\n<li>tank300 最后得选择吧</li>\n</ul>\n", "last_modified": 1788233386, "replies": 231, "id": 1238590}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/38af/8613/176_large.png?m=1644885960", "name": "car", "avatar_normal": "https://cdn.v2ex.com/navatar/38af/8613/176_normal.png?m=1644885960", "title": "汽车", "url": "https://www.v2ex.com/go/car", "topics": 3291, "footer": "", "header": "关于买车、开车及汽车文化的技术讨论", "title_alternative": "Car", "avatar_mini": "https://cdn.v2ex.com/navatar/38af/8613/176_mini.png?m=1644885960", "stars": 2293, "founder_id": 0, "aliases": [], "root": false, "id": 176, "parent_node_name": "life"}, "member": {"id": 647183, "username": "mouseman", "url": "https://www.v2ex.com/u/mouseman", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_mini.png?m=1702046789", "avatar_normal": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_normal.png?m=1702046789", "avatar_large": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_large.png?m=1702046789", "avatar_xlarge": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_xlarge.png?m=1702046789", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_xxlarge.png?m=1702046789", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_xxxlarge.png?m=1702046789", "created": 1693903279, "last_modified": 1702046789, "pro": 0}, "last_reply_by": "xbhayi", "last_touched": 1788313170, "title": "买车需求。", "url": "https://www.v2ex.com/t/1238661", "created": 1788243335, "deleted": 0, "content": "目前存款大概 80 个左右，毕业 6 年了，最近在琢磨买车的事情，在看小米 su7 ，主要是到底买不买。 \r\n目前自己的情况：  \r\n工作通勤可以地铁直达，基本不需要开车，公司也在地铁站口。\r\n还没结婚。\r\n唯一考虑买车的点就是周末节假日出去玩儿，还有过年可能会回老家，重庆某远离主城的区县，所以在考虑电车。  \r\n但是想着买车肯定是全款买吧，然后每年又是几万的养车费，感觉好不容易快到 100w 的存款了，又没了，所以有点纠结。加上感觉我对车的需求又不大，可能只是一部分是面子原因吧，周边很多人都有车。", "content_rendered": "<p>目前存款大概 80 个左右，毕业 6 年了，最近在琢磨买车的事情，在看小米 su7 ，主要是到底买不买。\n目前自己的情况：<br/>\n工作通勤可以地铁直达，基本不需要开车，公司也在地铁站口。\n还没结婚。\n唯一考虑买车的点就是周末节假日出去玩儿，还有过年可能会回老家，重庆某远离主城的区县，所以在考虑电车。<br/>\n但是想着买车肯定是全款买吧，然后每年又是几万的养车费，感觉好不容易快到 100w 的存款了，又没了，所以有点纠结。加上感觉我对车的需求又不大，可能只是一部分是面子原因吧，周边很多人都有车。</p>\n", "last_modified": 1788257069, "replies": 108, "id": 1238661}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241232, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4511, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 520162, "username": "florentino", "url": "https://www.v2ex.com/u/florentino", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "键政家,愤青,恨国党,搞大新闻,大中华黄脖子", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9c43/a52b/520162_mini.png?m=1765959852", "avatar_normal": "https://cdn.v2ex.com/avatar/9c43/a52b/520162_normal.png?m=1765959852", "avatar_large": "https://cdn.v2ex.com/avatar/9c43/a52b/520162_large.png?m=1765959852", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9c43/a52b/520162_xlarge.png?m=1765959852", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9c43/a52b/520162_xxlarge.png?m=1765959852", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9c43/a52b/520162_xxxlarge.png?m=1765959852", "created": 1606196306, "last_modified": 1765959852, "pro": 0}, "last_reply_by": "cheng6563", "last_touched": 1788287052, "title": "为什么说罗永浩想要造一台老年人友好电视,注定不成功", "url": "https://www.v2ex.com/t/1238574", "created": 1788227782, "deleted": 0, "content": "据我了解这踏马就不是电视的事情, 现有的体系下, 电视想要播放电视台的频道, 只能走广电的通道, 而合法路子只有 广电机顶盒 或者 IPTV, 前者你控制不了机顶盒系统, 后者你需要给几家持照的广电系公司分钱,成本就高,并且每个省的 IPTV 认证都要走一遍合作流程, 你就干吧 一干一个不吱声", "content_rendered": "<p>据我了解这踏马就不是电视的事情, 现有的体系下, 电视想要播放电视台的频道, 只能走广电的通道, 而合法路子只有 广电机顶盒 或者 IPTV, 前者你控制不了机顶盒系统, 后者你需要给几家持照的广电系公司分钱,成本就高,并且每个省的 IPTV 认证都要走一遍合作流程, 你就干吧 一干一个不吱声</p>\n", "last_modified": 1788227782, "replies": 103, "id": 1238574}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241232, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4511, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 451556, "username": "zeni18", "url": "https://www.v2ex.com/u/zeni18", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/df2355bf085187dace1e85b10267f43a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/df2355bf085187dace1e85b10267f43a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/df2355bf085187dace1e85b10267f43a?s=73&d=retro", "created": 1573062391, "last_modified": 1769005412, "pro": 0}, "last_reply_by": "Anarchy", "last_touched": 1788313931, "title": "一直不理解 skills， 这不就是提示词吗？", "url": "https://www.v2ex.com/t/1238642", "created": 1788239336, "deleted": 0, "content": "我一直会看到 抖音上 介绍有了整个 skills 就能啥啥啥的， 但是在我看来 skills 就是按需加载提示词而已呀 。有说的这么玄乎吗？", "content_rendered": "<p>我一直会看到 抖音上 介绍有了整个 skills 就能啥啥啥的， 但是在我看来 skills 就是按需加载提示词而已呀 。有说的这么玄乎吗？</p>\n", "last_modified": 1788239336, "replies": 95, "id": 1238642}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_large.png?m=1643940920", "name": "ev", "avatar_normal": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_normal.png?m=1643940920", "title": "电动汽车", "url": "https://www.v2ex.com/go/ev", "topics": 472, "footer": "", "header": "", "title_alternative": "EV", "avatar_mini": "https:/