tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/18dd767a76b5edefbd40aabea6050153?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/18dd767a76b5edefbd40aabea6050153?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/18dd767a76b5edefbd40aabea6050153?s=73&d=retro", "created": 1585456957, "last_modified": 1787799257, "pro": 0}, "last_reply_by": "dreamkuo", "last_touched": 1788281737, "title": "10-15w 的电车推荐", "url": "https://www.v2ex.com/t/1238597", "created": 1788231234, "deleted": 0, "content": "# 在成都，最近想入手一款 10-15w 的电车，这样周末可以周边自驾\r\n## 有什么推荐的吗？现在看到的几款就是比亚迪海豹系列的，零跑 A10 这样的", "content_rendered": "<h1>在成都，最近想入手一款 10-15w 的电车，这样周末可以周边自驾</h1>\n<h2>有什么推荐的吗？现在看到的几款就是比亚迪海豹系列的，零跑 A10 这样的</h2>\n", "last_modified": 1788233378, "replies": 85, "id": 1238597}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/38af/8613/176_large.png?m=1644885960", "name": "car", "avatar_normal": "https://cdn.v2ex.com/navatar/38af/8613/176_normal.png?m=1644885960", "title": "汽车", "url": "https://www.v2ex.com/go/car", "topics": 3290, "footer": "", "header": "关于买车、开车及汽车文化的技术讨论", "title_alternative": "Car", "avatar_mini": "https://cdn.v2ex.com/navatar/38af/8613/176_mini.png?m=1644885960", "stars": 2293, "founder_id": 0, "aliases": [], "root": false, "id": 176, "parent_node_name": "life"}, "member": {"id": 647183, "username": "mouseman", "url": "https://www.v2ex.com/u/mouseman", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_mini.png?m=1702046789", "avatar_normal": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_normal.png?m=1702046789", "avatar_large": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_large.png?m=1702046789", "avatar_xlarge": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_xlarge.png?m=1702046789", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_xxlarge.png?m=1702046789", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/e4e8/2dbd/647183_xxxlarge.png?m=1702046789", "created": 1693903279, "last_modified": 1702046789, "pro": 0}, "last_reply_by": "xuanbg", "last_touched": 1788285059, "title": "买车需求。", "url": "https://www.v2ex.com/t/1238661", "created": 1788243335, "deleted": 0, "content": "目前存款大概 80 个左右，毕业 6 年了，最近在琢磨买车的事情，在看小米 su7 ，主要是到底买不买。 \r\n目前自己的情况：  \r\n工作通勤可以地铁直达，基本不需要开车，公司也在地铁站口。\r\n还没结婚。\r\n唯一考虑买车的点就是周末节假日出去玩儿，还有过年可能会回老家，重庆某远离主城的区县，所以在考虑电车。  \r\n但是想着买车肯定是全款买吧，然后每年又是几万的养车费，感觉好不容易快到 100w 的存款了，又没了，所以有点纠结。加上感觉我对车的需求又不大，可能只是一部分是面子原因吧，周边很多人都有车。", "content_rendered": "<p>目前存款大概 80 个左右，毕业 6 年了，最近在琢磨买车的事情，在看小米 su7 ，主要是到底买不买。\n目前自己的情况：<br/>\n工作通勤可以地铁直达，基本不需要开车，公司也在地铁站口。\n还没结婚。\n唯一考虑买车的点就是周末节假日出去玩儿，还有过年可能会回老家，重庆某远离主城的区县，所以在考虑电车。<br/>\n但是想着买车肯定是全款买吧，然后每年又是几万的养车费，感觉好不容易快到 100w 的存款了，又没了，所以有点纠结。加上感觉我对车的需求又不大，可能只是一部分是面子原因吧，周边很多人都有车。</p>\n", "last_modified": 1788257069, "replies": 84, "id": 1238661}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241233, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4511, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 451556, "username": "zeni18", "url": "https://www.v2ex.com/u/zeni18", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/df2355bf085187dace1e85b10267f43a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/df2355bf085187dace1e85b10267f43a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/df2355bf085187dace1e85b10267f43a?s=73&d=retro", "created": 1573062391, "last_modified": 1769005412, "pro": 0}, "last_reply_by": "binux", "last_touched": 1788281843, "title": "一直不理解 skills， 这不就是提示词吗？", "url": "https://www.v2ex.com/t/1238642", "created": 1788239336, "deleted": 0, "content": "我一直会看到 抖音上 介绍有了整个 skills 就能啥啥啥的， 但是在我看来 skills 就是按需加载提示词而已呀 。有说的这么玄乎吗？", "content_rendered": "<p>我一直会看到 抖音上 介绍有了整个 skills 就能啥啥啥的， 但是在我看来 skills 就是按需加载提示词而已呀 。有说的这么玄乎吗？</p>\n", "last_modified": 1788239336, "replies": 83, "id": 1238642}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fc22/1309/181_large.png?m=1608240651", "name": "travel", "avatar_normal": "https://cdn.v2ex.com/navatar/fc22/1309/181_normal.png?m=1608240651", "title": "旅行", "url": "https://www.v2ex.com/go/travel", "topics": 1694, "footer": "", "header": "你会把上大学的学费用来环游世界么？", "title_alternative": "Travel", "avatar_mini": "https://cdn.v2ex.com/navatar/fc22/1309/181_mini.png?m=1608240651", "stars": 1351, "founder_id": 0, "aliases": [], "root": false, "id": 181, "parent_node_name": "life"}, "member": {"id": 287238, "username": "FaustinaD", "url": "https://www.v2ex.com/u/FaustinaD", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9f13/d763/287238_mini.png?m=1775805794", "avatar_normal": "https://cdn.v2ex.com/avatar/9f13/d763/287238_normal.png?m=1775805794", "avatar_large": "https://cdn.v2ex.com/avatar/9f13/d763/287238_large.png?m=1775805794", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xlarge.png?m=1775805794", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xxlarge.png?m=1775805794", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9f13/d763/287238_xxxlarge.png?m=1775805794", "created": 1517081618, "last_modified": 1775805794, "pro": 0}, "last_reply_by": "aliensb", "last_touched": 1788270912, "title": "下周四到周日，三天去九寨沟+乐山，安排合理吗？", "url": "https://www.v2ex.com/t/1238599", "created": 1788231522, "deleted": 0, "content": "10 号（周四）晚上从成都出发前往九寨沟沟口附近的酒店\r\n大约晚上 11 点左右到达酒店\r\n11 号（周五）早上 6 点多起床赶第一波 7 点半开门进入景区\r\n周五和周六两天时间，九寨沟深度游玩\r\n周六下午四五点结束九寨游玩，从成都东中转，晚 11 点左右到达乐山\r\n\r\n周日早开始在乐山吃吃玩玩，可去乐山大佛也可不去\r\n下午四点多的高铁从乐山回成都天府机场\r\n17 点 50 抵达天府机场，19 点左右的航班回青岛\r\n\r\n有点特种兵但我精力体力都比较好\r\n准备了三合一冲锋衣+速干短袖+长袖防晒衣\r\n\r\n还有什么需要准备和特别注意的吗？", "content_rendered": "10 号（周四）晚上从成都出发前往九寨沟沟口附近的酒店<br />大约晚上 11 点左右到达酒店<br />11 号（周五）早上 6 点多起床赶第一波 7 点半开门进入景区<br />周五和周六两天时间，九寨沟深度游玩<br />周六下午四五点结束九寨游玩，从成都东中转，晚 11 点左右到达乐山<br /><br />周日早开始在乐山吃吃玩玩，可去乐山大佛也可不去<br />下午四点多的高铁从乐山回成都天府机场<br />17 点 50 抵达天府机场，19 点左右的航班回青岛<br /><br />有点特种兵但我精力体力都比较好<br />准备了三合一冲锋衣+速干短袖+长袖防晒衣<br /><br />还有什么需要准备和特别注意的吗？", "last_modified": 1788231537, "replies": 80, "id": 1238599}]