[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72894, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9764, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 515381, "username": "LimaEcho", "url": "https://www.v2ex.com/u/LimaEcho", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/8173e7357bc4513181253407527ca9b2?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/8173e7357bc4513181253407527ca9b2?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/8173e7357bc4513181253407527ca9b2?s=73&d=retro", "created": 1604108825, "last_modified": 1781750049, "pro": 0}, "last_reply_by": "kingfire", "last_touched": 1787463928, "title": "感觉 Vibe Coding 时代， Windows 系统要凉了", "url": "https://www.v2ex.com/t/1236462", "created": 1787405501, "deleted": 0, "content": "起因是感觉 Windows 系统太难受了。不管是什么模型，codex ，claude ，DeepSeek 都有反复死磕命令行，都不知道这几个月会浪费我多少 token ；\r\n\r\n1.各位是否有同感呢？\r\n\r\n2.有必要更换 Mac 吗，如果有，大家有什么推荐吗?\r\n但是这个时间点买电脑又贵，有没有便宜的推荐，这种不需要很多的性能吧，没用过 Mac 系统，请教各位大佬\r\n\r\n最近接了几个大项目，都赶在一起了，看他死磕，感觉难受", "content_rendered": "起因是感觉 Windows 系统太难受了。不管是什么模型，codex ，claude ，DeepSeek 都有反复死磕命令行，都不知道这几个月会浪费我多少 token ；<br /><br />1.各位是否有同感呢？<br /><br />2.有必要更换 Mac 吗，如果有，大家有什么推荐吗?<br />但是这个时间点买电脑又贵，有没有便宜的推荐，这种不需要很多的性能吧，没用过 Mac 系统，请教各位大佬<br /><br />最近接了几个大项目，都赶在一起了，看他死磕，感觉难受", "last_modified": 1787405820, "replies": 65, "id": 1236462}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 35878, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6162, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 281015, "username": "sherlockGou", "url": "https://www.v2ex.com/u/sherlockGou", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/84cb577a710edcc54c5a4ff440537c6f?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/84cb577a710edcc54c5a4ff440537c6f?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/84cb577a710edcc54c5a4ff440537c6f?s=73&d=retro", "created": 1515461450, "last_modified": 1776059786, "pro": 0}, "last_reply_by": "anheiyouxia", "last_touched": 1787429567, "title": "[Android 封闭测试] 找几位朋友帮忙体验《像素数织》，送完整内容兑换码", "url": "https://www.v2ex.com/t/1236410", "created": 1787387491, "deleted": 0, "content": "大家好，我开发的《像素数织》 Google Play 版本推进到封闭测试阶段了，想找几位平时喜欢益智游戏的朋友，帮我实际体验一下。\r\n\r\n《像素数织》是一款通过行列数字线索，还原像素图案的逻辑益智游戏。玩法比较简单：根据数字判断哪些格子应该填满，哪些格子应该留空，一步步推理，最后把隐藏的图案拼出来。\r\n\r\n它不太考验反应速度，主要是慢慢分析和排除。顺利解出一道比较大的题时，还是挺有成就感的。\r\n\r\n宣传截图如下：\r\n\r\n![]( https://i.imgur.com/ZLVsR7m.png) \r\n![]( https://i.imgur.com/Hin9Pui.png) \r\n![]( https://i.imgur.com/CHOQOJ5.png) \r\n![]( https://i.imgur.com/frDVchm.png) \r\n![]( https://i.imgur.com/CwwpUe7.png) \r\n\r\n参与方式：\r\n1. 需要有 Android 手机，并且可以正常使用 Google Play\r\n2. 留下邮箱我会邀请加入测试，并发放邀请码，数量有限(50 个)\r\n3. 实际体验几关，或者试试自由模式、创造模式\r\n4. 遇到 Bug 或有建议，可以在帖子里回复，也可以私信告诉我\r\n\r\n感谢大家，也欢迎喜欢 Nonogram 、数织、逻辑拼图类游戏的朋友来试试。\r\n\r\n很少在 V 站发帖，如果发布的节点有问题还请见谅并告知，我会移动到合适位置。\r\n\r\n谢谢大家～", "content_rendered": "<p>大家好，我开发的《像素数织》 Google Play 版本推进到封闭测试阶段了，想找几位平时喜欢益智游戏的朋友，帮我实际体验一下。</p>\n<p>《像素数织》是一款通过行列数字线索，还原像素图案的逻辑益智游戏。玩法比较简单：根据数字判断哪些格子应该填满，哪些格子应该留空，一步步推理，最后把隐藏的图案拼出来。</p>\n<p>它不太考验反应速度，主要是慢慢分析和排除。顺利解出一道比较大的题时，还是挺有成就感的。</p>\n<p>宣传截图如下：</p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/ZLVsR7m.png\"/>\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/Hin9Pui.png\"/>\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/CHOQOJ5.png\"/>\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/frDVchm.png\"/>\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/CwwpUe7.png\"/> </p>\n<p>参与方式：</p>\n<ol>\n<li>需要有 Android 手机，并且可以正常使用 Google Play</li>\n<li>留下邮箱我会邀请加入测试，并发放邀请码，数量有限(50 个)</li>\n<li>实际体验几关，或者试试自由模式、创造模式</li>\n<li>遇到 Bug 或有建议，可以在帖子里回复，也可以私信告诉我</li>\n</ol>\n<p>感谢大家，也欢迎喜欢 Nonogram 、数织、逻辑拼图类游戏的朋友来试试。</p>\n<p>很少在 V 站发帖，如果发布的节点有问题还请见谅并告知，我会移动到合适位置。</p>\n<p>谢谢大家～</p>\n", "last_modified": 1787387491, "replies": 38, "id": 1236410}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240974, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4509, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 198842, "username": "oldlamp", "url": "https://www.v2ex.com/u/oldlamp", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": ""