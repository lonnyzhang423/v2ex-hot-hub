com/navatar/fd2c/5e46/1135_normal.png?m=1751736785", "title": "OpenAI", "url": "https://www.v2ex.com/go/openai", "topics": 4555, "footer": "", "header": "关于 OpenAI 旗下产品 GPT，DALL·E，和 ChatGPT 的讨论。请不要在 V2EX 的回复中粘贴复制来自 AI 生成的文本。", "title_alternative": "OpenAI", "avatar_mini": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3304, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 132931, "username": "vzyw", "url": "https://www.v2ex.com/u/vzyw", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/a434a3b21fe7a3581b4c5f1f3102ae90?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/a434a3b21fe7a3581b4c5f1f3102ae90?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/a434a3b21fe7a3581b4c5f1f3102ae90?s=73&d=retro", "created": 1439539616, "last_modified": 1784888272, "pro": 0}, "last_reply_by": "liKeYunKeji", "last_touched": 1787487185, "title": "你们都是怎么给 chatgpt plus 充值的？", "url": "https://www.v2ex.com/t/1236551", "created": 1787464926, "deleted": 0, "content": "用了一个月官方 plus 后，再也不想用中转站了，又慢又不稳定。那么要自己充值，你们都用什么方案充呢？", "content_rendered": "<p>用了一个月官方 plus 后，再也不想用中转站了，又慢又不稳定。那么要自己充值，你们都用什么方案充呢？</p>\n", "last_modified": 1787465124, "replies": 22, "id": 1236551}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_large.png?m=1751736785", "name": "openai", "avatar_normal": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_normal.png?m=1751736785", "title": "OpenAI", "url": "https://www.v2ex.com/go/openai", "topics": 4555, "footer": "", "header": "关于 OpenAI 旗下产品 GPT，DALL·E，和 ChatGPT 的讨论。请不要在 V2EX 的回复中粘贴复制来自 AI 生成的文本。", "title_alternative": "OpenAI", "avatar_mini": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3304, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 56707, "username": "nanoxx", "url": "https://www.v2ex.com/u/nanoxx", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/ad8db7633e0e1c1c975545a18c95ec53?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/ad8db7633e0e1c1c975545a18c95ec53?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/ad8db7633e0e1c1c975545a18c95ec53?s=73&d=retro", "created": 1393233355, "last_modified": 1674095343, "pro": 0}, "last_reply_by": "kingfire", "last_touched": 1787486788, "title": "Codex 又要重置了", "url": "https://www.v2ex.com/t/1236559", "created": 1787466750, "deleted": 0, "content": "Tibo • @thsottiaux•19 分钟\n\nUpdate on rate limits in Codex.\n\nWe&#39;ve found (a) some inefficiencies when using images in long sessions with multiple compactions (b) high p95+ usage for Computer History (c) a feature that was meant to generate conversation titles that was draining a bit more usage than intended. And we have a tiger team combing through everything and shipping fixes tomorrow. We also found a novel approach to drive efficiency up significantly that is completely unrelated and we will be working on next week.\n\n__As part of some of the fixes tomorrow, we will also do a full reset of the usage for all paid subscriptions.__\n\nSee you then.", "content_rendered": "<p>Tibo • @<a href=\"/member/thsottiaux\">thsottiaux</a>•19 分钟</p>\n<p>Update on rate limits in Codex.</p>\n<p>We've found (a) some inefficiencies when using images in long sessions with multiple compactions (b) high p95+ usage for Computer History (c) a feature that was meant to generate conversation titles that was draining a bit more usage than intended. And we have a tiger team combing through everything and shipping fixes tomorrow. We also found a novel approach to drive efficiency up significantly that is completely unrelated and we will be working on next week.</p>\n<p><strong>As part of some of the fixes tomorrow, we will also do a full reset of the usage for all paid subscriptions.</strong></p>\n<p>See you then.</p>\n", "last_modified": 1787466750, "replies": 22, "id": 1236559}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72899, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9764, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 26655, "username": "287854442", "url": "https://www.v2ex.com/u/287854442", "website": "http://www.xueshi.me", "twitter": "XueshiQiao", "psn": "", "github": "XueshiQiao", "btc": "", "location": "北京", "tagline": "观云卷云舒，赏花开花落", "bio": "小红书号：4690373435 https://www.xiaohongshu.com/user/profile/65897ec300000000220147bf", "avatar_mini": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_mini.png?m=1785848289", "avatar_normal": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_normal.png?m=1785848289", "avatar_large": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_large.png?m=1785848289", "created": 1347442180, "last_modified": 1785848289, "pro": 0}, "last_reply_by": "hugowangnz", "last_touched": 1787487434, "title": "大家现在日常/办公中，语音输入占比大概有多少？", "url": "https://www.v2ex.com/t/1236583", "created": 1787476342, "deleted": 0, "content": "大概 7 个月前，我做了一个预言，说 1 年之后语音输入将会成为主流，现在半年都过去了，我说一下我现在情况\r\n\r\n不得不说，现在语音转文字准确率越来越高，所以现在在手机上几乎不怎么打字了（除非敲一些命令），各种聊天 发帖子 或者是 跟 agent 协同等，基本上都是靠语音转文字来输入了\r\n\r\n电脑上也是如此，基本上 80 ～ 90% 的场景吧，都是语音转文字来进行输入\r\n\r\n办公场景可能会稍低一些，有时候不方便说的还是靠打字，大部分情况下都还好。\r\n\r\n想看看大家的占比是怎么样的。", "content_rendered": "<p>大概 7 个月前，我做了一个预言，说 1 年之后语音输入将会成为主流，现在半年都过去了，我说一下我现在情况</p>\n<p>不得不说，现在语音转文字准确率越来越高，所以现在在手机上几乎不怎么打字了（除非敲一些命令），各种聊天 发帖子 或者是 跟 agent 协同等，基本上都是靠语音转文字来输入了</p>\n<p>电脑上也是如此，基本上 80 ～ 90% 的场景吧，都是语音转文字来进行输入</p>\n<p>办公场景可能会稍低一些，有时候不方便说的还是靠打字，大部分情况下都还好。</p>\n<p>想看看大家的占比是怎么样的。</p>\n", "last_modified": 1787476342, "replies": 21, "id": 1236583}]