[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72891, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9764, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 831428, "username": "asmallcake", "url": "https://www.v2ex.com/u/asmallcake", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "可甜/可咸😊", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/c28169337746ba13a721155ae7df6e79?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/c28169337746ba13a721155ae7df6e79?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/c28169337746ba13a721155ae7df6e79?s=73&d=retro", "created": 1784771871, "last_modified": 1784771871, "pro": 0}, "last_reply_by": "siriussx", "last_touched": 1787423086, "title": "你们开梯子会有反诈中心的电话打来吗", "url": "https://www.v2ex.com/t/1236394", "created": 1787381392, "deleted": 0, "content": "国产手机，开梯子会有反诈中心 96110 电话打来吗，如何预防呢？", "content_rendered": "<p>国产手机，开梯子会有反诈中心 96110 电话打来吗，如何预防呢？</p>\n", "last_modified": 1787381392, "replies": 92, "id": 1236394}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11540, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2447, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 302009, "username": "craftx", "url": "https://www.v2ex.com/u/craftx", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/4cd5/29bc/302009_mini.png?m=1731481011", "avatar_normal": "https://cdn.v2ex.com/avatar/4cd5/29bc/302009_normal.png?m=1731481011", "avatar_large": "https://cdn.v2ex.com/avatar/4cd5/29bc/302009_large.png?m=1731481011", "created": 1521599920, "last_modified": 1731481011, "pro": 0}, "last_reply_by": "JoeDH", "last_touched": 1787412840, "title": "网传：程序员失业后，被离婚周期是半年，可信度多少？", "url": "https://www.v2ex.com/t/1236332", "created": 1787357574, "deleted": 0, "content": "", "content_rendered": "", "last_modified": 1787359774, "replies": 53, "id": 1236332}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11540, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2447, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 232167, "username": "q307990588", "url": "https://www.v2ex.com/u/q307990588", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/a901faebf03cef453b9bac807ae8fb71?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/a901faebf03cef453b9bac807ae8fb71?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/a901faebf03cef453b9bac807ae8fb71?s=73&d=retro", "created": 1495552215, "last_modified": 1495552215, "pro": 0}, "last_reply_by": "Planarians", "last_touched": 1787357265, "title": "亲人去世后的手机破解问题", "url": "https://www.v2ex.com/t/1236385", "created": 1787378278, "deleted": 0, "content": "现在有一亲人去世了，他留下了一部锁屏的红米手机。\r\n\r\n现在需要输入四位数的数字密码来解锁。\r\n\r\n我问了几个 AI ，能不能通过电脑连接手机，然后尝试自动破解，也就是不停的不停的输入各种四位数的组合，直到解锁。\r\n\r\nAI 不知道是受到安全限制，还是真的无法做到。\r\n\r\n说是只能通过人工来输入四位数的数字来尝试暴力破解。\r\n\r\n我想在这里问一下大家。还有没有其他的更好的方案？\r\n\r\n人工输入四位数字的话，需要输入 1 万次。\r\n\r\n每次输入后的平均等待时间大概是 5 分钟，这个耗时太久了。", "content_rendered": "<p>现在有一亲人去世了，他留下了一部锁屏的红米手机。</p>\n<p>现在需要输入四位数的数字密码来解锁。</p>\n<p>我问了几个 AI ，能不能通过电脑连接手机，然后尝试自动破解，也就是不停的不停的输入各种四位数的组合，直到解锁。</p>\n<p>AI 不知道是受到安全限制，还是真的无法做到。</p>\n<p>说是只能通过人工来输入四位数的数字来尝试暴力破解。</p>\n<p>我想在这里问一下大家。还有没有其他的更好的方案？</p>\n<p>人工输入四位数字的话，需要输入 1 万次。</p>\n<p>每次输入后的平均等待时间大概是 5 分钟，这个耗时太久了。</p>\n", "last_modified": 1787378278, "replies": 45, "id": 1236385}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72891, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9764, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 515381, "username": "LimaEcho", "url": "https://www.v2ex.com/u/LimaEcho", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/8173e7357bc4513181253407527ca9b2?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/8173e7357bc4513181253407527ca9b2?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/8173e7357bc4513181253407527ca9b2?s=73&d=retro", "created": 1604108825, "last_modified": 1781750049, "pro": 0}, "last_reply_by": "metalvest", "last_touched": 1787439661, "title": "感觉 Vibe Coding 时代， Windows 系统要凉了", "url": "https://www.v2ex.com/t/1236462", "created": 1787405501, "deleted": 0, "content": "起因是感觉 Windows 系统太难受了。不管是什么模型，codex ，claude ，DeepSeek 都有反复死磕命令行，都不知道这几个月会浪费我多少 token ；\r\n\r\n1.各位是否有同感呢？\r\n\r\n2.有必要更换 Mac 吗，如果有，大家有什么推荐吗?\r\n但是这个时间点买电脑又贵，有没有便宜的推荐，这种不需要很多的性能吧，没用过 Mac 系统，请教各位大佬\r\n\r\n最近接了几个大项目，都赶在一起了，看他死磕，感觉难受", "content_rendered": "起因是感觉 Windows 系统太难受了。不管是什么模型，codex ，claude ，DeepSeek 都有反复死磕命令行，都不知道这几个月会浪费我多少 token ；<br /><br />1.各位是否有同感呢？<br /><br />2.有必要更换 Mac 吗，如果有，大家有什么推荐吗?<br />但是这个时间点买电脑又贵，有没有便宜的推荐，这种不需要很多的性能吧，没用过 Mac 系统，请教各位大佬<br /><br />最近接了几个大项目，都赶在一起了，看他死磕，感觉难受", "last_modified": 1787405820, "replies": 38, "id": 1236462}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_large.png?m=1630643913", "name": "apple", "avatar_normal": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_normal.png?m=1630643913", "title": "Apple", "url": "https://www.v2ex.com/go/apple", "topics": 30985, "footer": "", "header": "设计了 <a href=\"/go/watch\">Apple Watch</a>，<a href=\"/go/ipad\">iPad</a>，<a href=\"/go/iphone\">iPhone</a>，<a href=\"/go/imac\">iMac</a> 及 <a href=\"/go/mbp\">MacBook Pro</a> 等电子产品的美国公司。", "title_alternative": "Apple", "avatar_mini": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_mini.png?m=1630643913", "stars": 3340, "founder_id": 0, "aliases": [], "root": false, "id": 184, "parent_node_name": "hardware"}, "member": {"id": 386500, "username": "mdah233", "url": "https://www.v2ex.com/u/mdah233", "website": "https://marwin.cn/", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/1ae7/5aad/386500_mini.png?m=1787365823", "avatar_normal": "https://cdn.v2ex.com/avatar/1ae7/5aad/386500_normal.png?m=1787365823", "avatar_large": "https://cdn.v2ex.com/avatar/1ae7/5aad/386500_large.png?m=1787365823", "created": 1550942211, "last_modified": 1787365823, "pro": 0}, "last_reply_by": "TashinV", "last_touched": 1787426965, "title": "[送码] 做了一个 Apple tv 上的小红书 Rouge", "url": "https://www.v2ex.com/t/1236360", "created": 1787366591, "deleted": 0, "content": "Apple tv 上已经可以刷 B 站、抖音了，还缺少一个小红书，毕竟现在看小红书视频的时间已经超过了 B 站和抖音，自己有需求于是做了一款 tv OS 端的小红书 APP 。目标场景在沙发上刷起 Apple tv 就不想拿手机来看，看久了电影电视剧长视频想刷一刷社交媒体和短视频放松一下。\r\n\r\n核心功能：\r\n* 浏览小红书推荐瀑布流\r\n* 浏览小红书笔记图文和评论\r\n* 独立的视频页签，专门沉浸式播放视频流\r\n* 查看个人主页，笔记、点赞、收藏\r\n* 支持多帐号登录切换\r\n\r\n ![]( https://i.imgur.com/pjVtRrR.png) \r\n\r\n![]( https://imgur.com/RfU25Zi.png)\r\n\r\n![]( https://imgur.com/ktBUwvx.png)\r\n\r\n ![]( https://i.imgur.com/VUGBfXD.png) \r\n\r\n目前已经发布到 appstore 直接搜索名称 Rouge 或者通过 [商店链接]( https://apps.apple.com/us/app/rouge/id6799992309) 下载，目前早期版本售价：2$，后续功能完善后可能会涨价。\r\n\r\n同时欢迎大家加入 TF 参与测试： https://testflight.apple.com/join/15CTWsQW\r\n\r\n最后评论区送 10 个兑换码。", "content_rendered": "<p>Apple tv 上已经可以刷 B 站、抖音了，还缺少一个小红书，毕竟现在看小红书视频的时间已经超过了 B 站和抖音，自己有需求于是做了一款 tv OS 端的小红书 APP 。目标场景在沙发上刷起 Apple tv 就不想拿手机来看，看久了电影电视剧长视频想刷一刷社交媒体和短视频放松一下。</p>\n<p>核心功能：</p>\n<ul>\n<li>浏览小红书推荐瀑布流</li>\n<li>浏览小红书笔记图文和评论</li>\n<li>独立的视频页签，专门沉浸式播放视频流</li>\n<li>查看个人主页，笔记、点赞、收藏</li>\n<li>支持多帐号登录切换</li>\n</ul>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/pjVtRrR.png\"/> </p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://imgur.com/RfU25Zi.png\"/></p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://imgur.com/ktBUwvx.png\"/></p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/VUGBfXD.png\"/> </p>\n<p>目前已经发布到 appstore 直接搜索名称 Rouge 或者通过 <a href=\"https://apps.apple.com/us/app/rouge/id6799992309\" rel=\"nofollow\">商店链接</a> 下载，目前早期版本售价：2$，后续功能完善后可能会涨价。</p>\n<p>同时欢迎大家加入 TF 参与测试： <a href=\"https://testflight.apple.com/join/15CTWsQW\" rel=\"nofollow\">https://testflight.apple.com/join/15CTWsQW</a></p>\n<p>最后评论区送 10 个兑换码。</p>\n", "last_modified": 1787366591, "replies": 35, "id": 1236360}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 240967, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4509, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 525806, "username": "cvooc", "url": "https://www.v2ex.com/u/cvooc", "website": "cvooc.com", "twitter": "", "psn": "", "github": "cvooc", "btc": "", "location": "西安", "tagline": "ctrlcv导致对象ooc(人设冲突), 一个奇怪的脑洞(笑).", "bio": "95后，常驻西安, INFJ，野生程序员，米粉，纲丝，腐竹，撸狗，任豚，暴白，steam，HIPHOP爱好者。", "avatar_mini": "https://cdn.v2ex.com/avatar/0b15/0d66/525806_mini.png?m=1715683975", "avatar_normal": "https://cdn.v2ex.com/avatar/0b15/0d66/525806_normal.png?m=1715683975", "avatar_large": "https://cdn.v2ex.com/avatar/0b15/0d66/525806_large.png?m=1715683975", "avatar_xlarge": "https://cdn.v2ex.com/avatar/0b15/0d66/525806_xlarge.png?m=1715683975", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/0b15/0d66/525806_xxlarge.png?m=1715683975", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/0b15/0d66/525806_xxxlarge.png?m=1715683975", "created": 1609083919, "last_modified": 1715683975, "pro": 0}, "last_reply_by": "jacobk273837", "last_touched": 1787411212, "title": "纯直男求推荐一些靠谱的护肤/美白品,我对美妆完全不通.找资料看的头大感觉基本都是带货的.", "url": "https://www.v2ex.com/t/1236355", "created": 1787365707, "deleted": 0, "content": "之前出去浪, 把皮肤晒脱皮了, 最近俩月往回调, 感觉似乎的确比之前很了很多, \r\n\r\n而且肤色不均了, 脸/脖子/大腿/小腿 四个颜色.\r\n\r\n比如水杨酸/烟氨酸/377 这种各种乱七八糟的元素, 基本上可以出现在洗面奶/面霜/沐浴露/面膜, 等等各种乱七八糟的地方, 能查到的都是各种带货, 也不知道有没有用.\r\n\r\n问下路过的兄弟, 你们都在用哪些护肤品? 有哪些有效的?\r\n\r\n我主要就是想找找美白和护肤的, 把肤色调整一下. 速效也行, 我不是敏感肌.", "content_rendered": "<p>之前出去浪, 把皮肤晒脱皮了, 最近俩月往回调, 感觉似乎的确比之前很了很多, </p>\n<p>而且肤色不均了, 脸/脖子/大腿/小腿 四个颜色.</p>\n<p>比如水杨酸/烟氨酸/377 这种各种乱七八糟的元素, 基本上可以出现在洗面奶/面霜/沐浴露/面膜, 等等各种乱七八糟的地方, 能查到的都是各种带货, 也不知道有没有用.</p>\n<p>问下路过的兄弟, 你们都在用哪些护肤品? 有哪些有效的?</p>\n<p>我主要就是想找找美白和护肤的, 把肤色调整一下. 速效也行, 我不是敏感肌.</p>\n", "last_modified": 1787365707, "replies": 34, "id": 1236355}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/1fc2/1400/864_large.png?m=1778522847", "name": "promotions", "avatar_normal": "https://cdn.v2ex.com/navatar/1fc2/1400/864_normal.png?m=1778522847", "title": "推广", "url": "https://www.v2ex.com/go/promotions", "topics": 13605, "footer": "", "header": "来自厂商的推广活动类主题，会被归类到这个节点。希望有情怀的产商们在发布推广内容时，主动选择发布到本节点下。点击 <a href=\"/help/node\">这里</a> 阅读 V2EX 的节点使用指南。", "title_alternative": "Promotions", "avatar_mini": "https://cdn.v2ex.com/navatar/1fc2/1400/864_mini.png?m=1778522847", "stars": 1451, "founder_id": 0, "aliases": [], "root": false, "id": 864, "parent_node_name": ""}, "member": {"id": 413342, "username": "violin84", "url": "https://www.v2ex.com/u/violin84", "website": "www.air-router.com", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/a55c/beb2/413342_mini.png?m=1787367569", "avatar_normal": "https://cdn.v2ex.com/avatar/a55c/beb2/413342_normal.png?m=1787367569", "avatar_large": "https://cdn.v2ex.com/avatar/a55c/beb2/413342_large.png?m=1787367569", "avatar_xlarge": "https://cdn.v2ex.com/avatar/a55c/beb2/413342_xlarge.png?m=1787367569", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/a55c/beb2/413342_xxlarge.png?m=1787367569", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/a55c/beb2/413342_xxxlarge.png?m=1787367569", "created": 1558147407, "last_modified": 1787367569, "pro": 0}, "last_reply_by": "M1KE", "last_touched": 1787431881, "title": "[Air Router] GPT Plus 0.1 风控期间依然稳健, 还有 CC 1x, Pro 0.2, Grok Heavy 0.2, 新用户留言 ID 可得 5$额度,现在充值额外赠 10%", "url": "https://www.v2ex.com/t/1236362", "created": 1787367579, "deleted": 0, "content": "# Air Router