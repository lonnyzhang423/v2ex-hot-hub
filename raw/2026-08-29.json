[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24193, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3732, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 719709, "username": "Void000", "url": "https://www.v2ex.com/u/Void000", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/196ddfd2ae2fd3a8bf7cdc534ac6bbdb?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/196ddfd2ae2fd3a8bf7cdc534ac6bbdb?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/196ddfd2ae2fd3a8bf7cdc534ac6bbdb?s=73&d=retro", "created": 1731392735, "last_modified": 1787791914, "pro": 0}, "last_reply_by": "lipcao", "last_touched": 1787918121, "title": "V 站程序员平均职业寿命大概有多少年？", "url": "https://www.v2ex.com/t/1237773", "created": 1787880651, "deleted": 0, "content": "如题，想统计一下 V 友们干程序员干了多久了。我先说吧：\r\n\r\n34 岁，一线大头兵，工作 11 年", "content_rendered": "如题，想统计一下 V 友们干程序员干了多久了。我先说吧：<br /><br />34 岁，一线大头兵，工作 11 年", "last_modified": 1787880934, "replies": 127, "id": 1237773}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241155, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4511, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 678002, "username": "LoongCLL", "url": "https://www.v2ex.com/u/LoongCLL", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/4962707f575c858b80c81fb1754a6bd9?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/4962707f575c858b80c81fb1754a6bd9?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/4962707f575c858b80c81fb1754a6bd9?s=73&d=retro", "created": 1709108389, "last_modified": 1709108389, "pro": 0}, "last_reply_by": "ZHOUHAHA2", "last_touched": 1787930745, "title": "现在的人是不是越来越看不下去长文章了…", "url": "https://www.v2ex.com/t/1237829", "created": 1787888711, "deleted": 0, "content": "今天早上吃孙哥和景甜的瓜，顺手把孙哥那篇小作文发给几个朋友。\r\n\r\n结果我发现几个在政府单位、做程序员、做专利的朋友，基本都看完了然后聊里面的一些细节。\r\n\r\n但另外几个朋友的反应就非常统一：\r\n\r\n“太长了。”\r\n\r\n“懒得看。”\r\n\r\n“你直接跟我说重点。”\r\n\r\n我当时还有点懵。\r\n\r\n后来想想，好像真的跟平时的工作习惯有关系。\r\n\r\n需要天天读文档的人，对几千字的东西其实没什么感觉。\r\n\r\n但如果平时主要就是刷短视频、看短消息、刷图片，突然丢一篇几千字的文字过去，第一反应可能就是：\r\n\r\n“这谁看得完啊……”\r\n\r\n而且现在刷 B 站，经常能看到这种评论：\r\n\r\n“@AI 总结一下。”\r\n\r\n一个视频还没看几分钟，先让 AI 告诉自己这个视频讲了什么。\r\n\r\n所以突然有点怀疑：\r\n\r\n我们现在到底是阅读能力下降了，还是单纯越来越没有耐心读完一篇东西了？\r\n\r\n这两个其实差别挺大的。\r\n\r\n毕竟以前是没得选，只能自己看。\r\n\r\n现在是信息太多了，AI 、短视频、算法都在帮你筛选、总结、提炼。\r\n\r\n久而久之，会不会连“自己把一篇东西从头看到尾”都变成一种需要刻意训练的能力？\r\n\r\n不知道大家有没有这种感觉。\r\n\r\n尤其是你把一篇比较长的文章发给朋友的时候，他们第一反应是：\r\n\r\n“我先看看。”\r\n\r\n还是：\r\n\r\n“太长了，你给我总结一下？”", "content_rendered": "<p>今天早上吃孙哥和景甜的瓜，顺手把孙哥那篇小作文发给几个朋友。</p>\n<p>结果我发现几个在政府单位、做程序员、做专利的朋友，基本都看完了然后聊里面的一些细节。</p>\n<p>但另外几个朋友的反应就非常统一：</p>\n<p>“太长了。”</p>\n<p>“懒得看。”</p>\n<p>“你直接跟我说重点。”</p>\n<p>我当时还有点懵。</p>\n<p>后来想想，好像真的跟平时的工作习惯有关系。</p>\n<p>需要天天读文档的人，对几千字的东西其实没什么感觉。</p>\n<p>但如果平时主要就是刷短视频、看短消息、刷图片，突然丢一篇几千字的文字过去，第一反应可能就是：</p>\n<p>“这谁看得完啊……”</p>\n<p>而且现在刷 B 站，经常能看到这种评论：</p>\n<p>“@AI 总结一下。”</p>\n<p>一个视频还没看几分钟，先让 AI 告诉自己这个视频讲了什么。</p>\n<p>所以突然有点怀疑：</p>\n<p>我们现在到底是阅读能力下降了，还是单纯越来越没有耐心读完一篇东西了？</p>\n<p>这两个其实差别挺大的。</p>\n<p>毕竟以前是没得选，只能自己看。</p>\n<p>现在是信息太多了，AI 、短视频、算法都在帮你筛选、总结、提炼。</p>\n<p>久而久之，会不会连“自己把一篇东西从头看到尾”都变成一种需要刻意训练的能力？</p>\n<p>不知道大家有没有这种感觉。</p>\n<p>尤其是你把一篇比较长的文章发给朋友的时候，他们第一反应是：</p>\n<p>“我先看看。”</p>\n<p>还是：</p>\n<p>“太长了，你给我总结一下？”</p>\n", "last_modified": 1787888711, "replies": 83, "id": 1237829}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/3417/3cb3/30_large.png?m=1598508698", "name": "chengdu", "avatar_normal": "https://cdn.v2ex.com/navatar/3417/3cb3/30_normal.png?m=1598508698", "title": "成都", "url": "https://www.v2ex.com/go/chengdu", "topics": 1661, "footer": "", "header": "", "title_alternative": "Chengdu", "avatar_mini": "https://cdn.v2ex.com/navatar/3417/3cb3/30_mini.png?m=1598508698", "stars": 1214, "founder_id": 0, "aliases": [], "root": false, "id": 30, "parent_node_name": "cn"}, "member": {"id": 590928, "username": "lifavor", "url": "https://www.v2ex.com/u/lifavor", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/80ebf9725f71960f4d930d99eaa72989?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/80ebf9725f71960f4d930d99eaa72989?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/80ebf9725f71960f4d930d99eaa72989?s=73&d=retro", "created": 1660189829, "last_modified": 1781074837, "pro": 0}, "last_reply_by": "MindMindMax", "last_touched": 1787936249, "title": "兄弟们，燃气要来换物联网燃气表，有没有坑？", "url": "https://www.v2ex.com/t/1237798", "created": 1787885209, "deleted": 0, "content": "刚来了个短信：\r\n\r\n [合燃华润] 尊敬的高新区 xxxxxxxxxxxxx 用户：定于 8 月 29 日早 8 点至晚 7 点为您免费更换物联网膜式燃气表并进行安全检查，请家中留人配合。物联网膜式燃气表的优势有：\r\n1.漏气处置更快捷、更安全；\r\n2.供气更稳定、同时满足多设备用气；\r\n3.减少入户抄表对您生活的打扰；\r\n4.实时掌握用气数据，线上缴费更便捷。\r\n\r\n\r\n [相关的便捷性和土地财政熄火后的骚操作] \r\n为什么都 2026 年了，缴个燃气费还要人上门抄表  https://www.v2ex.com/t/1195636\r\n重庆、成都等地燃气费疯涨，​背后真相究竟是什么？ https://zhuanlan.zhihu.com/p/694042225", "content_rendered": "刚来了个短信：<br /><br /> [合燃华润] 尊敬的高新区 xxxxxxxxxxxxx 用户：定于 8 月 29 日早 8 点至晚 7 点为您免费更换物联网膜式燃气表并进行安全检查，请家中留人配合。物联网膜式燃气表的优势有：<br 