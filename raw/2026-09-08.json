[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/1fc2/1400/864_large.png?m=1778522847", "name": "promotions", "avatar_normal": "https://cdn.v2ex.com/navatar/1fc2/1400/864_normal.png?m=1778522847", "title": "推广", "url": "https://www.v2ex.com/go/promotions", "topics": 13951, "footer": "", "header": "来自厂商的推广活动类主题，会被归类到这个节点。希望有情怀的产商们在发布推广内容时，主动选择发布到本节点下。点击 <a href=\"/help/node\">这里</a> 阅读 V2EX 的节点使用指南。", "title_alternative": "Promotions", "avatar_mini": "https://cdn.v2ex.com/navatar/1fc2/1400/864_mini.png?m=1778522847", "stars": 1471, "founder_id": 0, "aliases": [], "root": false, "id": 864, "parent_node_name": ""}, "member": {"id": 655887, "username": "at5pm", "url": "https://www.v2ex.com/u/at5pm", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/cb66/704c/655887_mini.png?m=1788743771", "avatar_normal": "https://cdn.v2ex.com/avatar/cb66/704c/655887_normal.png?m=1788743771", "avatar_large": "https://cdn.v2ex.com/avatar/cb66/704c/655887_large.png?m=1788743771", "avatar_xlarge": "https://cdn.v2ex.com/avatar/cb66/704c/655887_xlarge.png?m=1788743771", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/cb66/704c/655887_xxlarge.png?m=1788743771", "created": 1698038488, "last_modified": 1788743771, "pro": 0}, "last_reply_by": "as9567585", "last_touched": 1788766166, "title": "[YAN+] 新站上线内测，注册用户每人送 10 刀（暂不支持充值，赠送额度用完可以找群主再要），支持 gpt-6-astra， GPT 最低 0.1×， DeepSeek V4 0.25×， GLM-5.3-Flash 0.25×", "url": "https://www.v2ex.com/t/1239922", "created": 1788745357, "deleted": 0, "content": "# 🎉 YanPlus 新站上线，邀请测试用户\r\n\r\n网站地址：[https://yan.plus/]( https://yan.plus/)\r\n\r\n> 注册邮箱目前仅支持 Gmail 、163 邮箱和 QQ 邮箱。\r\n\r\n1. 评论注册 ID ，每人赠送 **$5 额度**。\r\n\r\n2. 加入 Q 群并私聊管理员，再赠送 **$5 额度**。\r\n\r\n3. 网站目前暂不支持充值。如果赠送的 **$10 额度**用完了，可以私聊管理员会再送一些额度。\r\n\r\n4. 迫于 NewAPI 原生 UI 太丑了，直接鞭策 GPT 重新改了一版。\r\n\r\n5. 发现 Bug ，还会赠送额外额度。\r\n\r\n6. 暂时就这些。", "content_rendered": "<h1>🎉 YanPlus 新站上线，邀请测试用户</h1>\n<p>网站地址：<a href=\"https://yan.plus/\" rel=\"nofollow\">https://yan.plus/</a></p>\n<blockquote>\n<p>注册邮箱目前仅支持 Gmail 、163 邮箱和 QQ 邮箱。</p>\n</blockquote>\n<ol>\n<li>\n<p>评论注册 ID ，每人赠送 <strong>$5 额度</strong>。</p>\n</li>\n<li>\n<p>加入 Q 群并私聊管理员，再赠送 <strong>$5 额度</strong>。</p>\n</li>\n<li>\n<p>网站目前暂不支持充值。如果赠送的 <strong>$10 额度</strong>用完了，可以私聊管理员会再送一些额度。</p>\n</li>\n<li>\n<p>迫于 NewAPI 原生 UI 太丑了，直接鞭策 GPT 重新改了一版。</p>\n</li>\n<li>\n<p>发现 Bug ，还会赠送额外额度。</p>\n</li>\n<li>\n<p>暂时就这些。</p>\n</li>\n</ol>\n", "last_modified": 1788745357, "replies": 248, "id": 1239922}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11642, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2457, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 184621, "username": "studyingss", "url": "https://www.v2ex.com/u/studyingss", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/6ff6/40c3/184621_mini.png?m=1730920764", "avatar_normal": "https://cdn.v2ex.com/avatar/6ff6/40c3/184621_normal.png?m=1730920764", "avatar_large": "https://cdn.v2ex.com/avatar/6ff6/40c3/184621_large.png?m=1730920764", "avatar_xlarge": "https://cdn.v2ex.com/avatar/6ff6/40c3/184621_xlarge.png?m=1730920764", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/6ff6/40c3/184621_xxlarge.png?m=1730920764", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/6ff6/40c3/184621_xxxlarge.png?m=1730920764", "created": 1469856014, "last_modified": 1730920764, "pro": 0}, "last_reply_by": "fazero", "last_touched": 1788811064, "title": "我发现一句对人生帮助巨大的 prompt， GPT 给我的回答好到我打算拿来当座右铭", "url": "https://www.v2ex.com/t/1239906", "created": 1788743229, "deleted": 0, "content": "很短就一句话：\r\n\r\n**“基于我们所有的聊天内容，请告诉我一个你认为我非常有必要知道，但大概率还不知道的知识。”**\r\n\r\n本来只是随手一问，看到回答有种被瞬间戳中的感觉，它完全把我的性格缺点指了出来，\r\n\r\n这是我的答案，每个人的情况不一样，看别人的答案可能不觉得有什么，强烈建议自己试试。\r\n\r\nhttps://i.imgur.com/L8JIiND.png", "content_rendered": "<p>很短就一句话：</p>\n<p><strong>“基于我们所有的聊天内容，请告诉我一个你认为我非常有必要知道，但大概率还不知道的知识。”</strong></p>\n<p>本来只是随手一问，看到回答有种被瞬间戳中的感觉，它完全把我的性格缺点指了出来，</p>\n<p>这是我的答案，每个人的情况不一样，看别人的答案可能不觉得有什么，强烈建议自己试试。</p>\n<p><a href=\"https://i.imgur.com/L8JIiND.png\" rel=\"nofollow\">https://i.imgur.com/L8JIiND.png</a></p>\n", "last_modified": 1788743229, "replies": 163, "id": 1239906}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4f28/4803/1187_large.png?m=1773123999", "name": "codex", "avatar_normal": "https://cdn.v2ex.com/navatar/4f28/4803/1187_normal.png?m=1773123999", "title": "Codex", "url": "https://www.v2ex.com/go/codex", "topics": 431, "footer": "", "header": "Codex 是 OpenAI 开发的面向软件工程的人工智能系统，能够将自然语言指令转换为可执行代码，并协助完成多种编程任务。", "title_alternative": "Codex", "avatar_mini": "https://cdn.v2ex.com/navatar/4f28/4803/1187_mini.png?m=1773123999", "stars": 204, "founder_id": 559063, "aliases": [], "root": false, "id": 1187, "parent_node_name": null}, "member": {"id": 630450, "username": "snownemo", "url": "https://www.v2ex.com/u/snownemo", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/9569a2290b77bb5188f766e97022161a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9569a2290b77bb5188f766e97022161a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9569a2290b77bb5188f766e97022161a?s=73&d=retro", "created": 1684842323, "last_modified": 1750124021, "pro": 0}, "last_reply_by": "Dragonish3600", "last_touched": 1788800701, "title": "Codex 又有 1000 邀请额度了，有条件的留邮箱", "url": "https://www.v2ex.com/t/1239902", "created": 1788742345, "deleted": 0, "content": "https://i.imgur.com/gbdXUZE.png", "content_rendered": "<a target=\"_blank\" href=\"https://i.imgur.com/gbdXUZE.png\" rel=\"nofollow noopener\" target=\"_blank\"><img src=\"https://i.imgur.com/gbdXUZE.png\" class=\"embedded_image\" rel=\"noreferrer\"></a>", "last_modified": 1788742345, "replies": 156, "id": 1239902}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/38af/8613/176_large.png?m=1644885960", "name": "car", "avatar_normal": "https://cdn.v2ex.com/navatar/38af/8613/176_normal.png?m=1644885960", "title": "汽车", "url": "https://www.v2ex.com/go/car", "topics": 3296, "footer": "", "header": "关于买车、开车及汽车文化的技术讨论", "title_alternative": "Car", "avatar_mini": "https://cdn.v2ex.com/navatar/38af/8613/176_mini.png?m=1644885960", "stars": 2296, "founder_id": 0, "aliases": [], "root": false, "id": 176, "parent_node_name": "life"}, "member": {"id": 411532, "username": "clacf", "url": "https://www.v2ex.com/u/clacf", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/9a5af21f8dc33efc660faf5fb6b18aff?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9a5af21f8dc33efc660faf5fb6b18aff?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9a5af21f8dc33efc660faf5fb6b18aff?s=73&d=retro", "created": 1557638602, "last_modified": 1788244093, "pro": 0}, "last_reply_by": "iFrey", "last_touched": 1788795505, "title": "我姐姐想买个不超过 7w 的车，接娃上下学，另外跑跑顺风车，求推荐", "url": "https://www.v2ex.com/t/1239908", "created": 1788743821, "deleted": 0, "content": "懂车帝从高到底\r\n星愿 （销量高，电池好）\r\n零跑 A10\r\n名爵 MG4 （动力强，电池牌子不行）\r\n奇瑞 QQ3\r\n缤果 pro\r\n长安启源 Q05 (空间最大)\r\n\r\n看起来名爵 MG4 动力最强，这个车怎么样？\r\n另外星愿为什么销量如此高，断层第一，真的有两把刷子吗？\r\n零跑这个牌子这两天突然起来了，不知道为啥销量第二", "content_rendered": "懂车帝从高到底<br />星愿 （销量高，电池好）<br />零跑 A10<br />名爵 MG4 （动力强，电池牌子不行）<br />奇瑞 QQ3<br />缤果 pro<br />长安启源 Q05 (空间最大)<br /><br />看起来名爵 MG4 动力最强，这个车怎么样？<br />另外星愿为什么销量如此高，断层第一，真的有两把刷子吗？<br />零跑这个牌子这两天突然起来了，不知道为啥销量第二", "last_modified": 1788754858, "replies": 115, "id": 1239908}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/53fd/e96f/522_large.png?m=1747625689", "name": "bike", "avatar_normal": "https://cdn.v2ex.com/navatar/53fd/e96f/522_normal.png?m=1747625689", "title": "骑行", "url": "https://www.v2ex.com/go/bike", "topics": 246, "footer": "", "header": "", "title_alternative": "Bike", "avatar_mini": "https://cdn.v2ex.com/navatar/53fd/e96f/522_mini.png?m=1747625689", "stars": 364, "founder_id": 0, "aliases": [], "root": false, "id": 522, "parent_node_name": ""}, "member": {"id": 176010, "username": "tongyuelong", "url": "https://www.v2ex.com/u/tongyuelong", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/14e9/6802/176010_mini.png?m=1499605313", "avatar_normal": "https://cdn.v2ex.com/avatar/14e9/6802/176010_normal.png?m=1499605313", "avatar_large": "https://cdn.v2ex.com/avatar/14e9/6802/176010_large.png?m=1499605313", "created": 1465052347, "last_modified": 1499605313, "pro": 0}, "last_reply_by": "psyngw", "last_touched": 1788793358, "title": "主打锻炼，应该买公路车还是山地车", "url": "https://www.v2ex.com/t/1239929", "created": 1788745908, "deleted": 0, "content": "之前有一段时间去健身房，想减肥，一个月下来，不知道是自己的体重问题，还是方法不对，后面膝盖有点不舒服，就停下了。\r\n\r\n休息了一两个月，膝盖感觉没啥不舒服了。\r\n\r\n想换一个对膝盖没那么大伤害的，想买单车来骑骑。\r\n\r\n但新手入门，不知道该买公路车，还是山地车，预算，1500 左右吧。初步的了解这个价钱好像也没法买公路车，是这样不？\r\n\r\n平时也就是市内骑骑吧，应该不会去特别难受的路段的。\r\n\r\n新人入手，大家有没有什么建议，然后是什么买什么品牌什么型号", "content_rendered": "<p>之前有一段时间去健身房，想减肥，一个月下来，不知道是自己的体重问题，还是方法不对，后面膝盖有点不舒服，就停下了。</p>\n<p>休息了一两个月，膝盖感觉没啥不舒服了。</p>\n<p>想换一个对膝盖没那么大伤害的，想买单车来骑骑。</p>\n<p>但新手入门，不知道该买公路车，还是山地车，预算，1500 左右吧。初步的了解这个价钱好像也没法买公路车，是这样不？</p>\n<p>平时也就是市内骑骑吧，应该不会去特别难受的路段的。</p>\n<p>新人入手，大家有没有什么建议，然后是什么买什么品牌什么型号</p>\n", "last_modified": 1788755001, "replies": 101, "id": 1239929}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24272, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3738, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 319660, "username": "052678", "url": "https://www.v2ex.com/u/052678", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/3824/6f0d/319660_mini.png?m=1788311146", "avatar_normal": "https://cdn.v2ex.com/avatar/3824/6f0d/319660_normal.png?m=1788311146", "avatar_large": "https://cdn.v2ex.com/avatar/3824/6f0d/319660_large.png?m=1788311146", "avatar_xlarge": "https://cdn.v2ex.com/avatar/3824/6f0d/319660_xlarge.png?m=1788311146", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/3824/6f0d/319660_xxlarge.png?m=1788311146", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/3824/6f0d/319660_xxxlarge.png?m=1788311146", "created": 1527742385, "last_modified": 1788311146, "pro": 0}, "last_reply_by": "HappyAndSmile", "last_touched": 1788685728, "title": "前公司领导想让我回去工作，还有必要回去吗？", "url": "https://www.v2ex.com/t/1239907", "created": 1788743328, "deleted": 0, "content": "自从被裁后 GAP 了大半年，最近终于下定决心转行了。目前在朋友的编程教育机构分店做店长。这段业绩还挺好的，目前拿到手的分红，虽然和上班的时候差了一截，但是说实话，这段时间挺开心的，带老师（大部分是刚毕业没多久的应届毕业生）、带学生，筹备比赛，然后开学后又是一波冲业绩的机会。\r\n\r\n但是昨天我原公司的领导找到我，想让我回去，说和老板说了，老板同意我回去。回去的话，就按正常重新招聘的路子走，工资的话不变。\r\n\r\n其实我大概能猜到之所以想让我回去，主要是我之前负责的哪块业务弯弯绕绕太多了，不注意就非常容易出线上事故。一个是业务太复杂，新人了想要熟悉，没个一年半载基本不可能，一个是屎山代码太多了，我自己写都要非常小心。最主要是平时领导不怎么参与前线打仗的业务，平时就是汇报汇报、要结果、要数据。他自己就根本没法上前线。其他同事基本都是能躲就躲，就更别说接手我的那个烂摊子了。\r\n\r\n我现在的心态其实是不太想回去了，主要是感觉以前觉得离开了公司，很难生存下去了。但是现在我有了另外一份糊口的工作。现在觉得以前的公司也就那样，不咋地、", "content_rendered": "<p>自从被裁后 GAP 了大半年，最近终于下定决心转行了。目前在朋友的编程教育机构分店做店长。这段业绩还挺好的，目前拿到手的分红，虽然和上班的时候差了一截，但是说实话，这段时间挺开心的，带老师（大部分是刚毕业没多久的应届毕业生）、带学生，筹备比赛，然后开学后又是一波冲业绩的机会。</p>\n<p>但是昨天我原公司的领导找到我，想让我回去，说和老板说了，老板同意我回去。回去的话，就按正常重新招聘的路子走，工资的话不变。</p>\n<p>其实我大概能猜到之所以想让我回去，主要是我之前负责的哪块业务弯弯绕绕太多了，不注意就非常容易出线上事故。一个是业务太复杂，新人了想要熟悉，没个一年半载基本不可能，一个是屎山代码太多了，我自己写都要非常小心。最主要是平时领导不怎么参与前线打仗的业务，平时就是汇报汇报、要结果、要数据。他自己就根本没法上前线。其他同事基本都是能躲就躲，就更别说接手我的那个烂摊子了。</p>\n<p>我现在的心态其实是不太想回去了，主要是感觉以前觉得离开了公司，很难生存下去了。但是现在我有了另外一份糊口的工作。现在觉得以前的公司也就那样，不咋地、</p>\n", "last_modified": 1788743328, "replies": 88, "id": 1239907}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11642, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2457, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 688446, "username": "debezium", "url": "https://www.v2ex.com/u/debezium", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/9175cdd9d4f15c92e525196f18c8d525?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9175cdd9d4f15c92e525196f18c8d525?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9175cdd9d4f15c92e525196f18c8d525?s=73&d=retro", "created": 1714963620, "last_modified": 1714963620, "pro": 0}, "last_reply_by": "sunfly", "last_touched": 1788792586, "title": "这次轮到了我看上了个女同事，但不知该怎么推进认识", "url": "https://www.v2ex.com/t/1240058", "created": 1788763500, "deleted": 0, "content": "同一个公司的女同事，不在一层楼，注意了很久但一直不知道怎么推进认识\r\n\r\n上班等电梯和早饭午饭能偶遇\r\n\r\n外貌中上好看，按照某相亲博主的说法我打 6.x 分\r\n在公司里应该属于好看能让人留意到的女生\r\n表现为：跟身边同事提起她，同事有印象并且能很快反应过来是谁；以及某次食堂用餐，正巧女生坐斜对面，她走了以后她正对面的几个男同事在讨论她\r\n\r\n知道名字，相应的 im 有电话/微信，但直接打招呼或者加微信觉得太过于冒昧/唐突/吓人\r\n\r\n不知道是否单身，据我推断大概率单身，如果推断没错她大约分手了 1 年多，并且她的前任也是公司员工但离职一年多了\r\n\r\n知道她喜欢玩的游戏但是不知道游戏 id ，很烦\r\n\r\n知道她喜欢去游泳，我也会去游泳，但不知道她去的哪个游泳馆，也很烦\r\n\r\n偶遇的时候会借机看向她，有几次她有注意到我在看她。\r\n如果不是我自恋的话，有一次早饭我在看她，她突然看了我一下，然后发现我在看她眼神立马躲闪走了，但是在这以后再也没发现她看过我\r\n\r\n身边的同事没有直接跟她认识的，只能通过几层关系牵上线\r\n我 > 同事 > 同事业务上游 > 她\r\n\r\n我个人的性格属于 i 人，好听点慢热，不好听点闷骚，熟悉了以后 b 话还是蛮多的，就是不知道如何迈出第一步\r\n\r\n有劳各位 v 友出出主意", "content_rendered": "<p>同一个公司的女同事，不在一层楼，注意了很久但一直不知道怎么推进认识</p>\n<p>上班等电梯和早饭午饭能偶遇</p>\n<p>外貌中上好看，按照某相亲博主的说法我打 6.x 分\n在公司里应该属于好看能让人留意到的女生\n表现为：跟身边同事提起她，同事有印象并且能很快反应过来是谁；以及某次食堂用餐，正巧女生坐斜对面，她走了以后她正对面的几个男同事在讨论她</p>\n<p>知道名字，相应的 im 有电话/微信，但直接打招呼或者加微信觉得太过于冒昧/唐突/吓人</p>\n<p>不知道是否单身，据我推断大概率单身，如果推断没错她大约分手了 1 年多，并且她的前任也是公司员工但离职一年多了</p>\n<p>知道她喜欢玩的游戏但是不知道游戏 id ，很烦</p>\n<p>知道她喜欢去游泳，我也会去游泳，但不知道她去的哪个游泳馆，也很烦</p>\n<p>偶遇的时候会借机看向她，有几次她有注意到我在看她。\n如果不是我自恋的话，有一次早饭我在看她，她突然看了我一下，然后发现我在看她眼神立马躲闪走了，但是在这以后再也没发现她看过我</p>\n<p>身边的同事没有直接跟她认识的，只能通过几层关系牵上线\n我 &gt; 同事 &gt; 同事业务上游 &gt; 她</p>\n<p>我个人的性格属于 i 人，好听点慢热，不好听点闷骚，熟悉了以后 b 话还是蛮多的，就是不知道如何迈出第一步</p>\n<p>有劳各位 v 友出出主意</p>\n", "last_modified": 1788763927, "replies": 82, "id": 1240058}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 241406, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4512, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 608299, "username": "BakerStude", "url": "https://www.v2ex.com/u/BakerStude", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/4dc32ec84096a38c963a68499957aaea?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/4dc32ec84096a38c963a68499957aaea?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/4dc32ec84096a38c963a68499957aaea?s=73&d=retro", "created": 1672276159, "last_modified": 1755516258, "pro": 0}, "last_reply_by": "Iannis", "last_touched": 1788810242, "title": "鱼油有什么推荐的吗？", "url": "https://www.v2ex.com/t/1239914", "created": 1788744710, "deleted": 0, "content": "自己吃，有没有性价比高的推荐", "content_rendered": "自己吃，有没有性价比高的推荐", "last_modified": 1788744710, "replies": 72, "id": 1239914}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11642, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2457, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 530402, "username": "abcfreedom", "url": "https://www.v2ex.com/u/abcfreedom", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/79b0/45bd/530402_mini.png?m=1770286895", "avatar_normal": "https://cdn.v2ex.com/avatar/79b0/45bd/530402_normal.png?m=1770286895", "avatar_large": "https://cdn.v2ex.com/avatar/79b0/45bd/530402_large.png?m=1770286895", "avatar_xlarge": "https://cdn.v2ex.com/avatar/79b0/45bd/530402_xlarge.png?m=1770286895", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/79b0/45bd/530402_xxlarge.png?m=1770286895", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/79b0/45bd/530402_xxxlarge.png?m=1770286895", "created": 1611573803, "last_modified": 1770286895, "pro": 0}, "last_reply_by": "bombicq83996", "last_touched": 1787858316, "title": "上了十年班，亏了两百万", "url": "https://www.v2ex.com/t/1240041", "created": 1788759163, "deleted": 0, "content": "昨晚算账算到失眠，工作十年了，手上积蓄越来越少。\r\n\r\n买房卖房又买房，一波神操作亏了 170 。炒股基金炒币乱七八糟亏了快 30 。公司 RSU 死拿着，从高点跌没了 80%。反观身边一些同龄人，公司股价高的时候敢套现，房价跌了敢抄底，A 股美股玩的风生水起，职场还很顺利，升职升的也很快，而我还在那原地踏步。\r\n\r\n有没有高人能指点下，我这是缺了点啥，该学些啥。", "content_rendered": "<p>昨晚算账算到失眠，工作十年了，手上积蓄越来越少。</p>\n<p>买房卖房又买房，一波神操作亏了 170 。炒股基金炒币乱七八糟亏了快 30 。公司 RSU 死拿着，从高点跌没了 80%。反观身边一些同龄人，公司股价高的时候敢套现，房价跌了敢抄底，A 股美股玩的风生水起，职场还很顺利，升职升的也很快，而我还在那原地踏步。</p>\n<p>有没有高人能指点下，我这是缺了点啥，该学些啥。</p>\n", "last_modified": 1788759163, "replies": 64, "id": 1240041}]