[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/698d/51a1/111_large.png?m=1648291973", "name": "reading", "avatar_normal": "https://cdn.v2ex.com/navatar/698d/51a1/111_normal.png?m=1648291973", "title": "阅读", "url": "https://www.v2ex.com/go/reading", "topics": 835, "footer": "", "header": "少上网，多读书", "title_alternative": "Reading", "avatar_mini": "https://cdn.v2ex.com/navatar/698d/51a1/111_mini.png?m=1648291973", "stars": 1729, "founder_id": 0, "aliases": [], "root": false, "id": 111, "parent_node_name": "life"}, "member": {"id": 660015, "username": "hijacker155", "url": "https://www.v2ex.com/u/hijacker155", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/1bb5ed372c7316850ef00338b5b5dcfd?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/1bb5ed372c7316850ef00338b5b5dcfd?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/1bb5ed372c7316850ef00338b5b5dcfd?s=73&d=retro", "created": 1699052630, "last_modified": 1770341661, "pro": 0}, "last_reply_by": "970749518nkq", "last_touched": 1791031569, "title": "大佬们，如果让你们推荐一本此生必读的书，你们会推荐哪一本？", "url": "https://www.v2ex.com/t/1246209", "created": 1790990878, "deleted": 0, "content": "随便什么类型的书都可以，没有限制", "content_rendered": "<p>随便什么类型的书都可以，没有限制</p>\n", "last_modified": 1791000198, "replies": 62, "id": 1246209}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c9f0/f895/8_large.png?m=1630643991", "name": "iphone", "avatar_normal": "https://cdn.v2ex.com/navatar/c9f0/f895/8_normal.png?m=1630643991", "title": "iPhone", "url": "https://www.v2ex.com/go/iphone", "topics": 13160, "footer": "这里绝不讨论如何获得 iPhone 盗版软件、iTunes 黑卡之类。", "header": "Say hello to the future.", "title_alternative": "iPhone", "avatar_mini": "https://cdn.v2ex.com/navatar/c9f0/f895/8_mini.png?m=1630643991", "stars": 3635, "founder_id": 0, "aliases": [], "root": false, "id": 8, "parent_node_name": "apple"}, "member": {"id": 688419, "username": "microscopec", "url": "https://www.v2ex.com/u/microscopec", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/837c7adad2a92281f9a4b84e00b1dace?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/837c7adad2a92281f9a4b84e00b1dace?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/837c7adad2a92281f9a4b84e00b1dace?s=73&d=retro", "created": 1714961651, "last_modified": 1751267580, "pro": 0}, "last_reply_by": "DXpro", "last_touched": 1791031444, "title": "没明白为什么突然就应激了", "url": "https://www.v2ex.com/t/1246252", "created": 1791012828, "deleted": 0, "content": "起因是在群里转发了财联社官方账号发的《苹果确认：iPhone 18 Pro Max 有问题》，美国苹果基带出现问题可能需要返厂维修，然后开始有人质疑新闻准确性，后来我也发了 MacRumors 和美国 AT&T 运营商官方发的新闻\r\n\r\n整个过程中没有提到华为\r\n\r\n然后下面的人就开始应激了，什么被新闻洗脑了、叫醒人家 、花粉有福了、xx 东真坏、假新闻太多了、这么好的 x 你怎么不早点告诉我 等等..\r\n\r\n我也算是个苹果用户，mac 、iPhone ，刚刚上架了苹果 App ，然后我就突然不理解了，这个世界到底怎么了？\r\n\r\n互联网 20 年来戾气没这么严重过，大家都是相互讨论问题本身，哪怕就算有假新闻，大家都看个乐呵，手机品牌也只是个标志，不管你买的是诺基亚还是三星，都不会有人为了搞对立去攻击你\r\n\r\n科技发展越来越快，人的戾气日益严重，不知道到哪个时间节点就会爆炸了...\r\n\r\n![]( https://i.imgur.com/X8W5pAV.jpeg)", "content_rendered": "<p>起因是在群里转发了财联社官方账号发的《苹果确认：iPhone 18 Pro Max 有问题》，美国苹果基带出现问题可能需要返厂维修，然后开始有人质疑新闻准确性，后来我也发了 MacRumors 和美国 AT&amp;T 运营商官方发的新闻</p>\n<p>整个过程中没有提到华为</p>\n<p>然后下面的人就开始应激了，什么被新闻洗脑了、叫醒人家 、花粉有福了、xx 东真坏、假新闻太多了、这么好的 x 你怎么不早点告诉我 等等..</p>\n<p>我也算是个苹果用户，mac 、iPhone ，刚刚上架了苹果 App ，然后我就突然不理解了，这个世界到底怎么了？</p>\n<p>互联网 20 年来戾气没这么严重过，大家都是相互讨论问题本身，哪怕就算有假新闻，大家都看个乐呵，手机品牌也只是个标志，不管你买的是诺基亚还是三星，都不会有人为了搞对立去攻击你</p>\n<p>科技发展越来越快，人的戾气日益严重，不知道到哪个时间节点就会爆炸了...</p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.imgur.com/X8W5pAV.jpeg\"/></p>\n", "last_modified": 1791012828, "replies": 50, "id": 1246252}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 37255, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6213, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 492816, "username": "abersheeran", "url": "https://www.v2ex.com/u/abersheeran", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "我尊重明者与智者。", "bio": "我对谦和的人谦和，对理性的人理性，与狷狂的人一起狷狂，对自以为是的人会更加自以为是。", "avatar_mini": "https://cdn.v2ex.com/gravatar/2fa34ee02af742311f2cfdbd43ef917d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/2fa34ee02af742311f2cfdbd43ef917d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/2fa34ee02af742311f2cfdbd43ef917d?s=73&d=retro", "created": 1591093844, "last_modified": 1716946753, "pro": 0}, "last_reply_by": "V2Try", "last_touched": 1791030668, "title": "做了个网盘，同一份文件可以由一万个人分摊存储费", "url": "https://www.v2ex.com/t/1246174", "created": 1790948533, "deleted": 0, "content": "做了一个网盘 Vorax Cloud ，核心功能是：同一份文件被多人保存时，只存一份，存储费由大家平摊。\r\n\r\n存一批 1TB 的文件，原本每月存储费是 $15 ，如果有一万个人保存，每个人分摊到的这批文件的存储费就是 $0.0015/月。\r\n另外也支持 WebDAV ，以及绑定自己的域名公开访问文件。\r\n\r\nhttps://voraxcloud.com\r\n\r\n底层存储用的 S3 ，手上有一些想和朋友一起共享资源的文件可以体验一下。到 https://www.producthunt.com/products/vorax-cloud?launch=vorax-cloud 可以领免费三个月的 geek 会员。希望大家能免费体验一下", "content_rendered": "<p>做了一个网盘 Vorax Cloud ，核心功能是：同一份文件被多人保存时，只存一份，存储费由大家平摊。</p>\n<p>存一批 1TB 的文件，原本每月存储费是 $15 ，如果有一万个人保存，每个人分摊到的这批文件的存储费就是 $0.0015/月。\n另外也支持 WebDAV ，以及绑定自己的域名公开访问文件。</p>\n<p><a href=\"https://voraxcloud.com\" rel=\"nofollow\">https://voraxcloud.com</a></p>\n<p>底层存储用的 S3 ，手上有一些想和朋友一起共享资源的文件可以体验一下。到 <a href=\"https://www.producthunt.com/products/vorax-cloud?launch=vorax-cloud\" rel=\"nofollow\">https://www.producthunt.com/products/vorax-cloud?launch=vorax-cloud</a> 可以领免费三个月的 geek 会员。希望大家能免费体验一下</p>\n", "last_modified": 1790948533, "replies": 34, "id": 1246174}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_large.png?m=1751736785", "name": "openai", "avatar_normal": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_normal.png?m=1751736785", "title": "OpenAI", "url": "https://www.v2ex.com/go/openai", "topics": 4919, "footer": "", "header": "关于 OpenAI 旗下产品 GPT，DALL·E，和 ChatGPT 的讨论。请不要在 V2EX 的回复中粘贴复制来自 AI 生成的文本。", "title_alternative": "OpenAI", "avatar_mini": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3389, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 340827, "username": "miscnote", "url": "https://www.v2ex.com/u/miscnote", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/fa3a0431ee232cdeeccd0608eb5aed21?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/fa3a0431ee232cdeeccd0608eb5aed21?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/fa3a0431ee232cdeeccd0608eb5aed21?s=73&d=retro", "created": 1534149980, "last_modified": 1534149980, "pro": 0}, "last_reply_by": "ZettarYuFan", "last_touched": 1791022898, "title": "GPT 6.1 秀", "url": "https://www.v2ex.com/t/1246202", "created": 1790986646, "deleted": 0, "content": "如下这个商业展示网站，完全用 gpt 6.1 生成。\r\nhttps://dyntu.com/\r\n我感觉挺惊艳。不管是交互，还是内容，都超出我的意料。\r\n我输入的提示语很少，短短几句话。6.1 大概花了 10 分钟，生成这个网站。", "content_rendered": "<p>如下这个商业展示网站，完全用 gpt 6.1 生成。\n<a href=\"https://dyntu.com/\" rel=\"nofollow\">https://dyntu.com/</a>\n我感觉挺惊艳。不管是交互，还是内容，都超出我的意料。\n我输入的提示语很少，短短几句话。6.1 大概花了 10 分钟，生成这个网站。</p>\n", "last_modified": 1790986646, "replies": 28, "id": 1246202}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73688, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 337005, "username": "knowckx", "url": "https://www.v2ex.com/u/knowckx", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "并非所有流浪者都迷失了自我", "bio": "我的个人技术博客 https://blog.knowckx.de", "avatar_mini": "https://cdn.v2ex.com/avatar/7891/3b36/337005_mini.png?m=1754991763", "avatar_normal": "https://cdn.v2ex.com/avatar/7891/3b36/337005_normal.png?m=1754991763", "avatar_large": "https://cdn.v2ex.com/avatar/7891/3b36/337005_large.png?m=1754991763", "created": 1532868040, "last_modified": 1754991763, "pro": 0}, "last_reply_by": "huafang", "last_touched": 1791026858, "title": "这两年 AI 进步太快了 一年一个新模样", "url": "https://www.v2ex.com/t/1246207", "created": 1790989292, "deleted": 0, "content": "2024：网页代码补全/问答助手   \r\n2025：AI 能认真帮你写代码  \r\n2026：AI 可以独立负责一整块开发任务  \r\n\r\n\r\n按这速度，估计明年 AI 可以负责整个小型项目的自我迭代，维护，完全不需要人工参与，直接\"许愿式开发\"", "content_rendered": "<p>2024：网页代码补全/问答助手<br/>\n2025：AI 能认真帮你写代码<br/>\n2026：AI 可以独立负责一整块开发任务  </p>\n<p>按这速度，估计明年 AI 可以负责整个小型项目的自我迭代，维护，完全不需要人工参与，直接\"许愿式开发\"</p>\n", "last_modified": 1790989305, "replies": 24, "id": 1246207}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242022, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4526, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 315301, "username": "jimmycmh", "url": "https://www.v2ex.com/u/jimmycmh", "website": "TrueSOTA 官网：https://true-sota.com/?from=v2ex", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/4cae27dbac80a2a163550c4c545510cd?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/4cae27dbac80a2a163550c4c545510cd?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/4cae27dbac80a2a163550c4c545510cd?s=73&d=retro", "created": 1525853093, "last_modified": 1525853093, "pro": 0}, "last_reply_by": "MoeDisk", "last_touched": 1790978617, "title": "个人项目做到哪种程度你才愿意发出来给别人用呢？", "url": "https://www.v2ex.com/t/1246170", "created": 1790947621, "deleted": 0, "content": "假期想做点小东西，但是感觉个人项目最容易卡在再改一点就能发了这个程度。\r\n\r\n功能已经能用了但是又觉得界面不太行，界面改完了又发现还没写说明，整到最后越做越像正式产品，反而一直没机会知道有没有人需要。\r\n\r\n所以想问问做过个人项目的朋友，你第一次公开的时候东西是完成到什么程度？\r\n\r\n会先丢给几个朋友试试还是还是直接发，边被吐槽边改？", "content_rendered": "<p>假期想做点小东西，但是感觉个人项目最容易卡在再改一点就能发了这个程度。</p>\n<p>功能已经能用了但是又觉得界面不太行，界面改完了又发现还没写说明，整到最后越做越像正式产品，反而一直没机会知道有没有人需要。</p>\n<p>所以想问问做过个人项目的朋友，你第一次公开的时候东西是完成到什么程度？</p>\n<p>会先丢给几个朋友试试还是还是直接发，边被吐槽边改？</p>\n", "last_modified": 1790947621, "replies": 21, "id": 1246170}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/3cef/96dc/949_large.png?m=1730363795", "name": "nas", "avatar_normal": "https://cdn.v2ex.com/navatar/3cef/96dc/949_normal.png?m=1730363795", "title": "NAS", "url": "https://www.v2ex.com/go/nas", "topics": 3290, "footer": "", "header": "关于网络存储设备的讨论", "title_alternative": "NAS", "avatar_mini": "https://cdn.v2ex.com/navatar/3cef/96dc/949_mini.png?m=1730363795", "stars": 3098, "founder_id": 0, "aliases": [], "root": false, "id": 949, "parent_node_name": "hardware"}, "member": {"id": 80687, "username": "Autonomous", "url": "https://www.v2ex.com/u/Autonomous", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/a82a/a592/80687_mini.png?m=1790993090", "avatar_normal": "https://cdn.v2ex.com/avatar/a82a/a592/80687_normal.png?m=1790993090", "avatar_large": "https://cdn.v2ex.com/avatar/a82a/a592/80687_large.png?m=1790993090", "avatar_xlarge": "https://cdn.v2ex.com/avatar/a82a/a592/80687_xlarge.png?m=1790993090", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/a82a/a592/80687_xxlarge.png?m=1790993090", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/a82a/a592/80687_xxxlarge.png?m=1790993090", "created": 1415416491, "last_modified": 1790993090, "pro": 0}, "last_reply_by": "Admstor", "last_touched": 1791028831, "title": "16U 落地机架 U 位设备布局与理线顺序，求 V 友帮看是否有坑", "url": "https://www.v2ex.com/t/1246216", "created": 1790993489, "deleted": 0, "content": "准备在索菲亚定制无底柜里塞一个 16U 带轮开放机架，主要想请教一下设备 U 位的垂直堆叠顺序与理线/风道布局是否合理。\r\n\r\nhttps://imgur.com/3nX6JpK\r\n\r\n# 垂直布局\r\n\r\n1. U1-U2: 2U 顶部抽风扇面板（向上抽排热风）\r\n2. U3–U6: 4U 群晖 DS1821+（搁置在 1U 机架重型托盘上，实吃 4U 高度）\r\n3. U7: 1U 盲板\r\n4. U8: UniFi UCG-Fiber （装在 3D 打印的 1U 机架面板上）\r\n5. U9: 1U 理线毛刷面板\r\n6. U10: UniFi Aggregation 万兆交换机\r\n7. U11: UniFi PoE 交换机 \r\n8. U12: 24 孔模块配线架（ Patch Panel ）\r\n9. U13-U14: 2U 底部进风扇面板（吸取地面冷空气向上）\r\n10. U15: 8 路前置独立开关 PDU\r\n11. U16: 1U 理线毛刷面板\r\n12. 机架后方底盘：塔式 UPS （侧放）+ 运营商光猫\r\n\r\n感谢各位 V 友指点！", "content_rendered": "<p>准备在索菲亚定制无底柜里塞一个 16U 带轮开放机架，主要想请教一下设备 U 位的垂直堆叠顺序与理线/风道布局是否合理。</p>\n<p><a href=\"https://imgur.com/3nX6JpK\" rel=\"nofollow\">https://imgur.com/3nX6JpK</a></p>\n<h1>垂直布局</h1>\n<ol>\n<li>U1-U2: 2U 顶部抽风扇面板（向上抽排热风）</li>\n<li>U3–U6: 4U 群晖 DS1821+（搁置在 1U 机架重型托盘上，实吃 4U 高度）</li>\n<li>U7: 1U 盲板</li>\n<li>U8: UniFi UCG-Fiber （装在 3D 打印的 1U 机架面板上）</li>\n<li>U9: 1U 理线毛刷面板</li>\n<li>U10: UniFi Aggregation 万兆交换机</li>\n<li>U11: UniFi PoE 交换机 </li>\n<li>U12: 24 孔模块配线架（ Patch Panel ）</li>\n<li>U13-U14: 2U 底部进风扇面板（吸取地面冷空气向上）</li>\n<li>U15: 8 路前置独立开关 PDU</li>\n<li>U16: 1U 理线毛刷面板</li>\n<li>机架后方底盘：塔式 UPS （侧放）+ 运营商光猫</li>\n</ol>\n<p>感谢各位 V 友指点！</p>\n", "last_modified": 1790993669, "replies": 18, "id": 1246216}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fc49/0ca4/65_large.png?m=1524891806", "name": "google", "avatar_normal": "https://cdn.v2ex.com/navatar/fc49/0ca4/65_normal.png?m=1524891806", "title": "Google", "url": "https://www.v2ex.com/go/google", "topics": 3613, "footer": "", "header": "Google’s mission is to organize the world’s information and make it universally accessible and useful.", "title_alternative": "Google", "avatar_mini": "https://cdn.v2ex.com/navatar/fc49/0ca4/65_mini.png?m=1524891806", "stars": 3855, "founder_id": 0, "aliases": [], "root": false, "id": 65, "parent_node_name": "internet"}, "member": {"id": 663227, "username": "aitobox", "url": "https://www.v2ex.com/u/aitobox", "website": "https://github.com/aitobox/", "twitter": "AiTobox", "psn": "", "github": "aitobox", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/b4a1/9caf/663227_mini.png?m=1790132430", "avatar_normal": "https://cdn.v2ex.com/avatar/b4a1/9caf/663227_normal.png?m=1790132430", "avatar_large": "https://cdn.v2ex.com/avatar/b4a1/9caf/663227_large.png?m=1790132430", "avatar_xlarge": "https://cdn.v2ex.com/avatar/b4a1/9caf/663227_xlarge.png?m=1790132430", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/b4a1/9caf/663227_xxlarge.png?m=1790132430", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/b4a1/9caf/663227_xxxlarge.png?m=1790132430", "created": 1700293031, "last_modified": 1790132430, "pro": 0}, "last_reply_by": "Nitroethane", "last_touched": 1791025567, "title": "Antitravity 三方模型要变成 Opus 5.5 and sonnet 5.5 了", "url": "https://www.v2ex.com/t/1246247", "created": 1791011406, "deleted": 0, "content": "付费 pro 和 ultra 用户可以使用；已经收到通知了；不知道能有多少额度；\r\n\r\nPro 账号的含金量提升了；", "content_rendered": "<p>付费 pro 和 ultra 用户可以使用；已经收到通知了；不知道能有多少额度；</p>\n<p>Pro 账号的含金量提升了；</p>\n", "last_modified": 1791011406, "replies": 17, "id": 1246247}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.p