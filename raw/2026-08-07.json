navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2427, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 529496, "username": "Leox0607", "url": "https://www.v2ex.com/u/Leox0607", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/d16df549821a31b86c7ca8e30beae82d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/d16df549821a31b86c7ca8e30beae82d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/d16df549821a31b86c7ca8e30beae82d?s=73&d=retro", "created": 1611108372, "last_modified": 1758244830, "pro": 0}, "last_reply_by": "fengye0509", "last_touched": 1786017022, "title": "长期不需要与人沟通，大家是如何改善，导致一开口就声音很小，后续的沟通也让双方有种如芒刺背的感觉", "url": "https://www.v2ex.com/t/1232397", "created": 1785984265, "deleted": 0, "content": "如题\r\n感觉以前不是这样的，但是长期的上下班基本上没啥与人沟通的机会，导致现在说话一开口，都习惯跟蚊子声音一样，很影响整个人的气质气场，畏畏缩缩的", "content_rendered": "如题<br />感觉以前不是这样的，但是长期的上下班基本上没啥与人沟通的机会，导致现在说话一开口，都习惯跟蚊子声音一样，很影响整个人的气质气场，畏畏缩缩的", "last_modified": 1785994966, "replies": 42, "id": 1232397}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 72543, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9747, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 403000, "username": "luis1180", "url": "https://www.v2ex.com/u/luis1180", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/5ef7b69de341fc81bc010ea47b4c6938?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/5ef7b69de341fc81bc010ea47b4c6938?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/5ef7b69de341fc81bc010ea47b4c6938?s=73&d=retro", "created": 1555591117, "last_modified": 1785986796, "pro": 0}, "last_reply_by": "bbroot", "last_touched": 1786043107, "title": "vibe coding 时，怎么设计出自己满意的前端 UI？", "url": "https://www.v2ex.com/t/1232424", "created": 1785986857, "deleted": 0, "content": "我现在设计前端，都是找到自己喜欢的目标网站/app 参考设计，如果没有现成的网站或者 app 可以参考，就去小红书上看别人分享的设计图;然后让大模型参考着去实现，当然了大模型只能实现个大概，很多细节还是需要自己一点点去打磨（当然了还是 vibe coding 打磨）。\r\n    但是总有一些页面是自己从来没见过类似的设计，没有可参考的，这种直接 vide coding 出来的很可能不满意，可是我又无法明确告诉 AI 我想要怎样的效果，我只知道这个效果不满意，却说不出来我想要怎样的设计。\r\n    遇到这种问题怎么解决的？", "content_rendered": "我现在设计前端，都是找到自己喜欢的目标网站/app 参考设计，如果没有现成的网站或者 app 可以参考，就去小红书上看别人分享的设计图;然后让大模型参考着去实现，当然了大模型只能实现个大概，很多细节还是需要自己一点点去打磨（当然了还是 vibe coding 打磨）。<br />    但是总有一些页面是自己从来没见过类似的设计，没有可参考的，这种直接 vide coding 出来的很可能不满意，可是我又无法明确告诉 AI 我想要怎样的效果，我只知道这个效果不满意，却说不出来我想要怎样的设计。<br />    遇到这种问题怎么解决的？", "last_modified": 1785986857, "replies": 41, "id": 1232424}]